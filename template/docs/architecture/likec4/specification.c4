// Hand-owned LikeC4 vocabulary. Written once when the repository is
// generated; the sync script never touches this file.
//
// The element kinds below are the granularity of the derived model:
// the system, its architecture layers, and the Python modules
// (files and subpackages) directly inside each layer.
specification {
  element system {
    notation "System"
  }

  element layer {
    notation "Architecture layer"
    style {
      opacity 10%
    }
  }

  element module {
    notation "Python module"
    style {
      shape component
    }
  }

  // Applied by the sync script to the modules named in the import-linter
  // independence contract (inbound and outbound adapters).
  tag independent
}
