// Team-owned views. The sync script never touches this file.
//
// Narrate freely here: flow views, stakeholder views, zooms with notes.
// Reference elements from generated/model.c4 by their full names
// (for example {{ package }}.domain.value_objects). The quality gate
// validates every view against the generated model, so a renamed or
// deleted module forces the views to move in the same commit.
views {
  view context {
    title '{{ project_name }} — context'
    include {{ package }}
  }
}
