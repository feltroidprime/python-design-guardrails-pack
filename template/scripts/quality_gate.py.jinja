def run(check: Check, root: Path) -> int:
    print(f"\n=== {check.name} ===", flush=True)
    try:
        completed = subprocess.run(check.command, cwd=root, check=False)
    except FileNotFoundError:
        hint = check.missing_tool_hint or f"'{check.command[0]}' was not found on PATH."
        print(hint, file=sys.stderr)
        return 127
    return completed.returncode


def inspect_prek_hooks(root: Path) -> HookInspection:
    if not (root / "prek.toml").is_file():
        return HookInspection(
            configured=False,
            installed=True,
            detail="prek policy is not configured",
        )
    completed = subprocess.run(
        GIT_COMMON_DIR_COMMAND,
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        return HookInspection(
            configured=True,
            installed=False,
            detail="git common directory could not be resolved",
        )
    common_dir = Path(completed.stdout.strip())
    if not common_dir.is_absolute():
        common_dir = (root / common_dir).resolve()
    defects: list[str] = []
    for hook_type in REQUIRED_PREK_HOOKS:
        hook = common_dir / "hooks" / hook_type
        if not hook.is_file() or not os.access(hook, os.X_OK):
            defects.append(f"{hook_type} is missing or not executable")
            continue
        try:
            shim = hook.read_text(encoding="utf-8")
        except OSError:
            defects.append(f"{hook_type} cannot be read")
            continue
        if "# File generated by prek:" not in shim or f"--hook-type={hook_type}" not in shim:
            defects.append(f"{hook_type} is not a prek shim")
    if defects:
        return HookInspection(
            configured=True,
            installed=False,
            detail="; ".join(defects),
        )
    return HookInspection(
        configured=True,
        installed=True,
        detail="shared pre-commit and pre-push prek hooks are installed",
    )


def print_hook_repair_failure(
    detail: str,
    *,
    command_stdout: str = "",
    command_stderr: str = "",
) -> None:
    print(" ".join(HOOK_REPAIR_COMMAND), file=sys.stderr)
    print(f"Hook verification failed: {detail}", file=sys.stderr)
    if command_stdout:
        print(command_stdout.rstrip(), file=sys.stderr)
    if command_stderr:
        print(command_stderr.rstrip(), file=sys.stderr)


def ensure_prek_hooks(root: Path) -> int:
    inspection = inspect_prek_hooks(root)
    if not inspection.configured or inspection.installed:
        return 0
    try:
        completed = subprocess.run(
            HOOK_REPAIR_COMMAND,
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        print_hook_repair_failure("'uv' was not found on PATH")
        return 127
    if completed.returncode != 0:
        print_hook_repair_failure(
            inspection.detail,
            command_stdout=completed.stdout,
            command_stderr=completed.stderr,
        )
        return completed.returncode
    repaired = inspect_prek_hooks(root)
    if not repaired.installed:
        print_hook_repair_failure(repaired.detail)
        return 1
    return 0


def tracked_python_files(root: Path) -> tuple[Path, ...] | None:
    completed = subprocess.run(
        TRACKED_PYTHON_COMMAND,
        cwd=root,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        print(
            "git ls-files failed; tracked Python syntax cannot be verified.",
            file=sys.stderr,
        )
        return None
    return tuple(
        root / Path(os.fsdecode(raw_path)) for raw_path in completed.stdout.split(b"\0") if raw_path
    )


def check_tracked_python_syntax(root: Path) -> int:
    print("\n=== tracked Python syntax ===", flush=True)
    paths = tracked_python_files(root)
    if paths is None:
        return 1
    failed = False
    checked = 0
    for path in paths:
        if not path.is_file():
            continue
        checked += 1
        relative = path.relative_to(root)
        try:
            _ = compile(path.read_bytes(), str(relative), "exec", dont_inherit=True)
        except SyntaxError as error:
            line = error.lineno or 0
            column = error.offset or 0
            print(
                f"{relative}:{line}:{column}: SyntaxError: {error.msg}",
                file=sys.stderr,
            )
            failed = True
    if failed:
        return 1
    print(f"Tracked Python syntax passed ({checked} files).")
    return 0


def requested_checks(argv: list[str]) -> tuple[Check, ...] | None:
    if not argv:
        return checks()
    if argv == ["--fix"]:
        return (*repairs(), *checks())
    print("Usage: python scripts/quality_gate.py [--fix]", file=sys.stderr)
    return None


def main(argv: list[str]) -> int:
    root = repository_root()
    selected = requested_checks(argv)
    if selected is None:
        return 2
    hook_exit_code = ensure_prek_hooks(root)
    if hook_exit_code != 0:
        return hook_exit_code
    syntax_exit_code = check_tracked_python_syntax(root)
    if syntax_exit_code != 0:
        print(
            f"\nFAILED: tracked Python syntax (exit {syntax_exit_code})",
            file=sys.stderr,
        )
        return syntax_exit_code
    for check in selected:
        exit_code = run(check, root)
        if exit_code != 0:
            print(f"\nFAILED: {check.name} (exit {exit_code})", file=sys.stderr)
            return exit_code
    print("\nAll quality gates passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
