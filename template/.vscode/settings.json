{
  // Hide derived artifacts from the explorer; sources of truth stay visible.
  // Keep this list in sync with .gitignore: everything hidden here is
  // regenerable output, never hand-edited content.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.basedpyright": true,
    "**/.import_linter_cache": true,
    "**/.codebase-memory": true,
    "**/.venv": true,
    "**/.DS_Store": true,
    "**/*.egg-info": true,
    ".coverage": true,
    "coverage.xml": true,
    "htmlcov": true,
    "dist": true,
    "build": true,
    ".idea": true
  },
  // search.exclude inherits files.exclude; add search-only noise here.
  "search.exclude": {
    "uv.lock": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.basedpyright/**": true,
    "**/.import_linter_cache/**": true,
    "**/.codebase-memory/**": true,
    "**/.venv/**": true
  },
  // Point the language server at the project venv and use the basedpyright
  // installed there rather than the extension's bundled copy, so the editor's
  // diagnostics match `uv run basedpyright` exactly.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "basedpyright.importStrategy": "fromEnvironment"
}
