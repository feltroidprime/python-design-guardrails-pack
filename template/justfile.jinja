set shell := ["bash", "-euo", "pipefail", "-c"]

# Keep bytecode caches out of the source tree: every Python run through these
# recipes writes its __pycache__ mirror under .venv instead.
export PYTHONPYCACHEPREFIX := justfile_directory() / ".venv/pycache"

default:
    @just --list

bootstrap:
    uv sync --all-groups
{% if precommit %}    uv run pre-commit install --hook-type pre-commit --hook-type pre-push
{% endif %}
fix:
    uv run ruff check --fix .
    uv run ruff format .
    uv run python -m scripts.sync_architecture_diagrams --write

check:
    uv run python scripts/quality_gate.py

test:
    uv run pytest

arch:
    uv run python -m scripts.architecture_guard
    uv run python -m scripts.docs_guard
    uv run lint-imports
    uv run python -m scripts.sync_architecture_diagrams --check

# Browse live architecture diagrams (requires Bun; first run downloads the pinned LikeC4 CLI).
diagrams:
    #!/usr/bin/env bash
    set -euo pipefail
    version="$(uv run python -c "import tomllib, pathlib; print(tomllib.loads(pathlib.Path('pyproject.toml').read_text())['tool']['likec4']['version'])")"
    exec bunx "likec4@${version}" serve docs/architecture/likec4

update:
    uv lock --upgrade
{% if precommit %}    uv run pre-commit autoupdate
{% endif %}    uv run python scripts/quality_gate.py
