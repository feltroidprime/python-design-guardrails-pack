[build-system]
requires = ["uv_build==0.12.0"]
build-backend = "uv_build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "A Python 3.14 application with an executable architecture and quality contract."
readme = "README.md"
requires-python = ">=3.14,<3.15"
dependencies = ["icontract>=2.7.3"]

{% if not workspace_member %}# Dev tooling floats: floors are the last versions this repository's toolchain
# was validated against, and the first `uv sync` resolves the latest releases.
# Reproducibility comes from uv.lock (kept current by the uv-lock Git
# hook), not from exact pins here.
[dependency-groups]
dev = [
  "basedpyright>=1.39.9",
  "coverage[toml]>=7.15.0",
  "crosshair-tool>=0.0.109",
  "hypothesis>=6.161.5",
  "import-linter>=2.13",
  "prek>=0.4.9",
  "pytest>=9.1.1",
  "pytest-cov>=7.1.0",
  "pytest-socket>=0.8.0",
  "ruff>=0.15.21",
]

{% endif %}[tool.uv]
required-version = ">=0.12.0,<0.13"
{% if not workspace_member %}# z3-solver 5.0.0.0 (a crosshair-tool dependency) ships a macOS arm64 wheel whose
# internal WHEEL tag (macosx_13_3_arm64) disagrees with its filename tag, so uv
# reinstalls it on every sync and `uv sync --check` never converges, which keeps
# `just doctor` red. Drop this constraint once a later release is tagged correctly.
constraint-dependencies = ["z3-solver!=5.0.0.0"]
{% endif %}

{% if not workspace_member %}# Ruff is strict about defects and conservative about rewrites: it owns
# correctness, security, and modern syntax, BasedPyright owns type semantics,
# and the architecture guard owns structure. Rules that trade explicitness for
# brevity, and rules that duplicate the formatter or the type checker, are
# deliberately absent.
[tool.ruff]
# The Python version is derived from [project] requires-python.
line-length = 100
src = ["repoctl", "src", "tests", "verification", "scripts"]
force-exclude = true

[tool.ruff.lint]
select = [
  # Defects and suspicious constructs.
  "A",
  "ASYNC",
  "B",
  "BLE",
  "DTZ",
  "E4",
  "E7",
  "E9",
  "F",
  "G",
  "LOG",
  "PGH",
  "PIE",
  "PLC",
  "PLE",
  "PLW",
  "RUF",
  "S",
  "W605",

  # Readable, modern Python.
  "C4",
  "ERA",
  "FBT",
  "FLY",
  "I",
  "N",
  "PT",
  "PTH",
  "RSE",
  "T10",
  "T20",
  "TID",
  "UP",

  # Visible public return contracts. BasedPyright owns parameter types,
  # inferred value types, and `Any`; private helper return types stay optional
  # where inference is sufficient.
  "ANN201",
  "ANN204",
  "ANN205",
  "ANN206",

  # Complexity and unambiguous refactors.
  "C901",
  "PLR0206",
  "PLR1704",
  "PLR1716",
  "PLR1722",
  "PLR1733",
  "PLR1736",
  "PLR5501",

  # High-signal control-flow simplifications. Rules that force ternaries,
  # delete explanatory result variables, introduce helper functions, or
  # optimize for statement count are deliberately excluded.
  "RET502",
  "RET503",
  "RET505",
  "RET506",
  "RET507",
  "RET508",
  "SIM101",
  "SIM103",
  "SIM109",
  "SIM110",
  "SIM112",
  "SIM113",
  "SIM115",
  "SIM118",
  "SIM201",
  "SIM202",
  "SIM208",
  "SIM210",
  "SIM211",
  "SIM220",
  "SIM221",
  "SIM222",
  "SIM223",
  "SIM300",
  "TRY002",
  "TRY004",
  "TRY201",
  "TRY203",
  "TRY400",
  "TRY401",

  # Validate hand-written TYPE_CHECKING blocks without creating new ones.
  "TC004",
  "TC005",
  "TC010",
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = [
  "ANN201",
  "S101",
]
"verification/tests/**/*.py" = [
  "ANN201",
  "S101",
]
"verification/repoctl/**/*.py" = [
  "ANN201",
  "S101",
]
"scripts/**/*.py" = ["T201"]
"scripts/crosshair_gate.py" = ["S603"]
"scripts/doctor.py" = ["S603"]
"scripts/quality_gate.py" = ["S603"]

[tool.ruff.lint.flake8-type-checking]
# These decorators mark code whose annotations are read at run time:
# `inspect.signature` (Hypothesis, pluggy) and CrossHair's icontract analysis
# resolve them, so their imports must stay outside type-checking blocks.
runtime-evaluated-decorators = [
  "hypothesis.given",
  "icontract.ensure",
  "icontract.invariant",
  "icontract.require",
  "icontract.snapshot",
  "pytest.hookimpl",
]

[tool.ruff.lint.isort]
# "tests" is declared explicitly because namespace packages (no __init__.py)
# are not auto-detected as first-party.
known-first-party = ["{{ package }}", "repoctl", "scripts", "tests", "verification"]
combine-as-imports = true
force-sort-within-sections = true

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
line-ending = "lf"
docstring-code-format = true

[tool.basedpyright]
include = ["repoctl", "src", "tests", "verification", "scripts"]
pythonVersion = "3.14"

# `recommended` enables the full diagnostic surface while keeping the
# error/warning hierarchy readable in an editor. Warnings stay fatal in CI.
typeCheckingMode = "recommended"
failOnWarnings = true

# Ruff owns these fast, syntax-local diagnostics and their automatic fixes.
reportUnusedImport = "none"
reportInvalidStringEscapeSequence = "none"

# Contract-critical policies stay explicit for humans and coding agents. They
# remain warnings in editors and still fail the quality gate.
reportAny = "warning"
reportExplicitAny = "warning"
reportIgnoreCommentWithoutRule = "warning"
reportImplicitOverride = "warning"
reportImplicitStringConcatenation = "warning"
reportMatchNotExhaustive = "warning"
reportMissingParameterType = "warning"
reportMissingTypeArgument = "error"
reportPrivateUsage = "warning"
reportUnannotatedClassAttribute = "warning"
reportUnnecessaryTypeIgnoreComment = "warning"
reportUnusedParameter = "warning"

[tool.pytest.ini_options]
minversion = "9.1"
testpaths = ["tests", "verification/tests"]
# Test packages are namespace packages (PEP 420): no __init__.py under tests/
# (enforced by ARCH014). The repository root on sys.path plus namespace
# detection keeps `tests.*` imports (the contract kit) working without them.
consider_namespace_packages = true
pythonpath = ["."]
addopts = [
  "-ra",
  "--strict-config",
  "--strict-markers",
  "--disable-socket",
  "-m",
  "not session_e2e",
  "--cov={{ package }}",
  "--cov-branch",
  "--cov-report=term-missing:skip-covered",
  "--cov-fail-under=90",
]
markers = [
  "contract: shared behavioral contract for a port implementation",
  "integration: deterministic integration test across real local components",
  "proof: canonical executable evidence owned by the proof catalog tree",
  "proves(id): one broad Hypothesis proof for a stable property ID",
  "falsifies(id): one minimal canary demonstrating that a property is non-vacuous",
  "stateful: Hypothesis RuleBasedStateMachine proof of a protocol",
  "session_e2e: opt-in conversion of private Claude Code and Codex session logs",
]
xfail_strict = true

[tool.coverage.run]
branch = true
source = ["{{ package }}"]
relative_files = true

[tool.coverage.report]
fail_under = 90
show_missing = true
skip_covered = true
exclude_also = [
  "if TYPE_CHECKING:",
  "if __name__ == .__main__.:",
  "raise NotImplementedError",
]

{% endif %}[tool.importlinter]
root_package = "{{ package }}"
include_external_packages = false
exclude_type_checking_imports = true

[[tool.importlinter.contracts]]
id = "layers"
name = "Foundation and generated indexes remain independent"
type = "layers"
layers = [
  "{{ package }}._foundation",
  "{{ package }}._generated",
]
