minimum_pre_commit_version: "4.6.0"
default_install_hook_types: [pre-commit, pre-push]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-ast
      - id: check-added-large-files
        args: [--maxkb=1000]
      - id: check-case-conflict
      - id: check-json
      - id: check-merge-conflict
      - id: check-toml
      - id: check-yaml
      - id: debug-statements
      - id: end-of-file-fixer
      - id: mixed-line-ending
        args: [--fix=lf]
      - id: trailing-whitespace

  - repo: https://github.com/astral-sh/uv-pre-commit
    rev: 0.11.28
    hooks:
      - id: uv-lock

  - repo: local
    hooks:
      # Run ruff from the project venv (not a pinned ruff-pre-commit rev) so
      # the hook, the CLI, and the quality gate always share one ruff version:
      # whatever uv.lock resolved for the floating dev group.
      - id: ruff-check
        name: ruff check
        entry: uv run ruff check --fix --exit-non-zero-on-fix
        language: system
        types_or: [python, pyi]
      - id: ruff-format
        name: ruff format
        entry: uv run ruff format
        language: system
        types_or: [python, pyi]
      # `env PYTHONPYCACHEPREFIX=...` mirrors the justfile export: hooks run
      # outside just, and without it each commit would re-scatter __pycache__
      # directories through the source tree (hooks always run from repo root,
      # so the relative path resolves to the project venv).
      - id: architecture-guard
        name: architecture guard
        entry: env PYTHONPYCACHEPREFIX=.venv/pycache uv run python -m scripts.architecture_guard
        language: system
        pass_filenames: false
      - id: full-quality-gate
        name: full quality gate
        entry: env PYTHONPYCACHEPREFIX=.venv/pycache uv run python scripts/quality_gate.py
        language: system
        pass_filenames: false
        stages: [pre-push]
