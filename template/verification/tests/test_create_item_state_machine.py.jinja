"""Stateful proof of idempotent create semantics across arbitrary retry sequences."""

from dataclasses import dataclass
from datetime import UTC, datetime
from typing import TYPE_CHECKING

from hypothesis import strategies as st
from hypothesis.stateful import RuleBasedStateMachine, invariant, rule
import pytest

from {{ package }}.adapters.outbound.memory_repository import MemoryItemRepository
from {{ package }}.application.errors import IdempotencyConflictError
from {{ package }}.application.specifications import (
    CreateItemReplayObservation,
    create_item_replay_is_safe,
)
from {{ package }}.application.use_cases import CreateItem, CreateItemCommand
from {{ package }}.domain.value_objects import ItemId, ItemName
from verification.harness.assertions import assert_falsifies, assert_property
from verification.harness.stateful import run_state_machine_as_test

if TYPE_CHECKING:
    from {{ package }}.domain.events import DomainEvent

FIXED_TIME = datetime(2026, 1, 1, tzinfo=UTC)
VALID_KEY = st.text(
    alphabet=st.characters(whitelist_categories=("Ll", "Lu", "Nd")),
    min_size=1,
    max_size=8,
)
VALID_NAME = st.text(
    alphabet=st.characters(
        blacklist_characters="\r\n",
        blacklist_categories=("Cs", "Zl", "Zp"),
    ).filter(lambda character: bool(character.strip())),
    min_size=1,
    max_size=20,
)


@dataclass(frozen=True, slots=True, kw_only=True)
class KnownCreate:
    item_id: ItemId
    name: ItemName


@dataclass(frozen=True, slots=True, kw_only=True)
class CreateAttemptOutcome:
    raised_conflict: bool
    replayed: bool
    same_item: bool


class SequentialIds:
    def __init__(self) -> None:
        self._next: int = 0

    def __call__(self) -> ItemId:
        self._next += 1
        return ItemId(value=f"generated-{self._next}")


class RecordingPublisher:
    def __init__(self) -> None:
        self.events: list[DomainEvent] = []

    def publish(self, event: DomainEvent) -> None:
        self.events.append(event)


class CreateItemReplayMachine(RuleBasedStateMachine):
    def __init__(self) -> None:
        super().__init__()
        self._repository: MemoryItemRepository = MemoryItemRepository()
        self._publisher: RecordingPublisher = RecordingPublisher()
        self._known: dict[str, KnownCreate] = {}
        self._handler: CreateItem = CreateItem(
            repository=self._repository,
            id_factory=SequentialIds(),
            clock=lambda: FIXED_TIME,
            events=self._publisher,
        )

    @rule(key=VALID_KEY, raw_name=VALID_NAME)
    def submit(self, key: str, raw_name: str) -> None:
        requested_name = ItemName(value=raw_name)
        prior = self._known.get(key)
        effects_before = len(self._publisher.events)
        outcome = self._attempt(key, raw_name, prior)
        observation = CreateItemReplayObservation(
            prior_key_exists=prior is not None,
            same_request=prior is not None and prior.name == requested_name,
            raised_conflict=outcome.raised_conflict,
            replayed=outcome.replayed,
            same_item=outcome.same_item,
            effects_before=effects_before,
            effects_after=len(self._publisher.events),
        )
        assert_property(
            condition=create_item_replay_is_safe(observation),
            property_id="CREATE-ITEM-REPLAY-SAFE",
        )

    def _attempt(
        self,
        key: str,
        raw_name: str,
        prior: KnownCreate | None,
    ) -> CreateAttemptOutcome:
        try:
            result = self._handler(CreateItemCommand(name=raw_name, idempotency_key=key))
        except IdempotencyConflictError:
            return CreateAttemptOutcome(
                raised_conflict=True,
                replayed=False,
                same_item=False,
            )
        if prior is None:
            self._known[key] = KnownCreate(
                item_id=result.item.item_id,
                name=result.item.name,
            )
        return CreateAttemptOutcome(
            raised_conflict=False,
            replayed=result.replayed,
            same_item=prior is not None and result.item.item_id == prior.item_id,
        )

    @invariant()
    def one_event_exists_per_successfully_created_key(self) -> None:
        assert_property(
            condition=len(self._publisher.events) == len(self._known),
            property_id="CREATE-ITEM-REPLAY-SAFE",
        )


@pytest.mark.proof
@pytest.mark.stateful
@pytest.mark.proves("CREATE-ITEM-REPLAY-SAFE")
def test_arbitrary_create_retry_sequences_are_safe() -> None:
    run_state_machine_as_test(CreateItemReplayMachine)


@pytest.mark.proof
@pytest.mark.falsifies("CREATE-ITEM-REPLAY-SAFE")
def test_duplicate_event_on_identical_retry_is_a_real_counterexample() -> None:
    assert_falsifies(
        condition=create_item_replay_is_safe(
            CreateItemReplayObservation(
                prior_key_exists=True,
                same_request=True,
                raised_conflict=False,
                replayed=False,
                same_item=True,
                effects_before=1,
                effects_after=2,
            )
        ),
        property_id="CREATE-ITEM-REPLAY-SAFE",
    )
