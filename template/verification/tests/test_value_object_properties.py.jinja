"""Broad constructor properties for domain values."""

from hypothesis import given
import pytest

from {{ package }}.domain.errors import InvalidItemNameError
from {{ package }}.domain.specifications import (
    item_id_text_is_valid,
    item_name_input_is_valid,
    item_name_text_is_canonical,
)
from {{ package }}.domain.value_objects import ItemId, ItemName
from verification.harness.assertions import assert_falsifies, assert_property
from verification.harness.strategies import item_id_candidates, item_name_candidates


@pytest.mark.proof
@pytest.mark.proves("ITEM-ID-VALID")
@given(raw=item_id_candidates())
def test_item_id_acceptance_matches_the_specification(raw: str) -> None:
    expected_acceptance = item_id_text_is_valid(raw)
    try:
        item_id = ItemId(value=raw)
    except ValueError:
        accepted = False
        valid_state = False
    else:
        accepted = True
        valid_state = item_id_text_is_valid(item_id.value)
    assert_property(
        condition=accepted == expected_acceptance and (not accepted or valid_state),
        property_id="ITEM-ID-VALID",
    )


@pytest.mark.proof
@pytest.mark.falsifies("ITEM-ID-VALID")
def test_blank_identifier_is_a_real_counterexample() -> None:
    assert_falsifies(
        condition=item_id_text_is_valid(" "),
        property_id="ITEM-ID-VALID",
    )


@pytest.mark.proof
@pytest.mark.proves("ITEM-NAME-CANONICAL")
@given(raw=item_name_candidates())
def test_item_name_acceptance_and_normalization_match_the_specification(raw: str) -> None:
    expected_acceptance = item_name_input_is_valid(raw)
    try:
        item_name = ItemName(value=raw)
    except InvalidItemNameError:
        accepted = False
        canonical = False
    else:
        accepted = True
        canonical = item_name_text_is_canonical(item_name.value) and item_name.value == raw.strip()
    assert_property(
        condition=expected_acceptance == accepted and (not accepted or canonical),
        property_id="ITEM-NAME-CANONICAL",
    )


@pytest.mark.proof
@pytest.mark.falsifies("ITEM-NAME-CANONICAL")
def test_blank_name_input_is_a_real_acceptance_counterexample() -> None:
    assert_falsifies(
        condition=item_name_input_is_valid(" "),
        property_id="ITEM-NAME-CANONICAL",
    )


@pytest.mark.proof
@pytest.mark.falsifies("ITEM-NAME-CANONICAL")
def test_unstripped_name_is_a_real_canonicality_counterexample() -> None:
    assert_falsifies(
        condition=item_name_text_is_canonical(" Padded "),
        property_id="ITEM-NAME-CANONICAL",
    )
