"""Model and preservation properties for the pure domain core."""

from datetime import UTC, datetime

from hypothesis import given
import pytest

from {{ package }}.domain.decisions import create_item, item_created_event, rename_item
from {{ package }}.domain.entities import Item
from {{ package }}.domain.events import ItemCreatedEvent
from {{ package }}.domain.specifications import (
    created_event_matches_item,
    created_item_matches_inputs,
    renamed_item_preserves_identity,
)
from {{ package }}.domain.value_objects import ItemId, ItemName
from verification.harness.assertions import assert_falsifies, assert_property
from verification.harness.strategies import aware_datetimes, item_ids, item_names, items


@pytest.mark.proof
@pytest.mark.proves("CREATE-ITEM-PRESERVES-FACTS")
@given(item_id=item_ids(), name=item_names())
def test_create_item_matches_its_reference_relation(item_id: ItemId, name: ItemName) -> None:
    result = create_item(item_id=item_id, name=name)
    assert_property(
        condition=created_item_matches_inputs(
            item_id.value,
            name.value,
            result.item_id.value,
            result.name.value,
        ),
        property_id="CREATE-ITEM-PRESERVES-FACTS",
    )


@pytest.mark.proof
@pytest.mark.falsifies("CREATE-ITEM-PRESERVES-FACTS")
def test_substituted_identifier_is_a_real_create_counterexample() -> None:
    assert_falsifies(
        condition=created_item_matches_inputs("expected", "Name", "wrong", "Name"),
        property_id="CREATE-ITEM-PRESERVES-FACTS",
    )


@pytest.mark.proof
@pytest.mark.proves("RENAME-ITEM-PRESERVES-IDENTITY")
@given(item=items(), new_name=item_names())
def test_rename_matches_its_identity_preservation_relation(
    item: Item,
    new_name: ItemName,
) -> None:
    source_snapshot = Item(item_id=item.item_id, name=item.name)
    result = rename_item(item, new_name)
    relation_holds = renamed_item_preserves_identity(
        item.item_id.value,
        item.name.value,
        new_name.value,
        result.item_id.value,
        result.name.value,
    )
    assert_property(
        condition=relation_holds and item == source_snapshot and result is not item,
        property_id="RENAME-ITEM-PRESERVES-IDENTITY",
    )


@pytest.mark.proof
@pytest.mark.falsifies("RENAME-ITEM-PRESERVES-IDENTITY")
def test_identity_change_is_a_real_rename_counterexample() -> None:
    assert_falsifies(
        condition=renamed_item_preserves_identity(
            "source",
            "Before",
            "After",
            "changed",
            "After",
        ),
        property_id="RENAME-ITEM-PRESERVES-IDENTITY",
    )


@pytest.mark.proof
@pytest.mark.proves("ITEM-CREATED-EVENT-MIRRORS-ITEM")
@given(item=items(), occurred_at=aware_datetimes())
def test_created_event_matches_its_reference_relation(
    item: Item,
    occurred_at: datetime,
) -> None:
    event = item_created_event(item=item, occurred_at=occurred_at)
    assert_property(
        condition=created_event_matches_item(
            item.item_id.value,
            item.name.value,
            occurred_at,
            event.item_id.value,
            event.name.value,
            event.occurred_at,
        ),
        property_id="ITEM-CREATED-EVENT-MIRRORS-ITEM",
    )


@pytest.mark.proof
@pytest.mark.falsifies("ITEM-CREATED-EVENT-MIRRORS-ITEM")
def test_wrong_event_identity_is_a_real_event_counterexample() -> None:
    occurred_at = datetime(2026, 1, 1, tzinfo=UTC)
    wrong = ItemCreatedEvent(
        item_id=ItemId(value="wrong"),
        name=ItemName(value="Name"),
        occurred_at=occurred_at,
    )
    assert_falsifies(
        condition=created_event_matches_item(
            "expected",
            "Name",
            occurred_at,
            wrong.item_id.value,
            wrong.name.value,
            wrong.occurred_at,
        ),
        property_id="ITEM-CREATED-EVENT-MIRRORS-ITEM",
    )
