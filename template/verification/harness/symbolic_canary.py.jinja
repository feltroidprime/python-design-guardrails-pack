def _canary_denies_its_own_output(
    item: Item,
    new_name: ItemName,
    occurred_at: datetime,
    result: tuple[str, str, datetime, str],
) -> bool:
    """Deliberately false: it denies exactly what the canary body always returns."""
    return result != (
        item.item_id.value,
        new_name.value,
        occurred_at,
        "repository_generation",
    )


def _repoctl_canary_name() -> str:
    declaration = CapabilityDeclaration(
        name="repository_generation",
        python_module="repoctl.modules.repository_generation",
        status="active",
        proof_catalog="proof/repoctl/repository-generation.toml",
        inbound=("cli",),
        outbound=(),
        api="repoctl.modules.repository_generation.api",
        factory="",
        cli_catalog="",
    )
    return compile_indexes((declaration,)).active[0].name


@icontract.ensure(
    _canary_denies_its_own_output,
    description="SYMBOLIC-CANARY: CrossHair must refute this deliberately false postcondition",
)
def refutable_echo(
    item: Item,
    new_name: ItemName,
    occurred_at: datetime,
) -> tuple[str, str, datetime, str]:
    """Echo the explicit inputs whose preservation the false postcondition denies."""
    return (item.item_id.value, new_name.value, occurred_at, _repoctl_canary_name())
