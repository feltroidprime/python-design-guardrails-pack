name: quality

on:
  pull_request:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
        with:
          version: "0.11.28"
          python-version: "3.14"
          enable-cache: true
{% if likec4 %}      - uses: oven-sh/setup-bun@v2
{% endif %}      - run: uv sync --locked --all-groups
      - run: uv run python scripts/quality_gate.py
