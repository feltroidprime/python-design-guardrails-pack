"""Detached-process evidence for the read-only repository control commands."""

from hashlib import sha256
import json
import os
from pathlib import Path
import subprocess
import sys
from typing import cast

import pytest

from {{ package }}.adapters.inbound.cli_contract import (
    CommandKind,
    CommandSpec,
    MutationPolicy,
    QueryPolicy,
)

# isort: split
from repoctl.modules.repository_generation.api import (
    COMMAND_CATALOG,
    ControlCommandName,
)

_IGNORED_RUNTIME_DIRECTORIES = frozenset(
    {".git", ".pytest_cache", ".ruff_cache", ".venv", "__pycache__"}
)


def _run_repoctl(args: tuple[str, ...], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    project_root = Path(__file__).resolve().parents[3]
    environment = os.environ.copy()
    previous_pythonpath = environment.get("PYTHONPATH", "")
    environment["PYTHONPATH"] = os.pathsep.join(
        part for part in (str(project_root), previous_pythonpath) if part
    )
    return subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0002
        [sys.executable, "-m", "repoctl", *args],
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        env=environment,
        text=True,
        timeout=10,
        check=False,
    )


def _document(raw: str) -> dict[str, object]:
    value = cast("object", json.loads(raw))
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def _mapping(value: object) -> dict[str, object]:
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def _object_list(value: object) -> list[dict[str, object]]:
    assert isinstance(value, list)
    return [_mapping(item) for item in cast("list[object]", value)]


def _full_state_digest(root: Path) -> str:
    digest = sha256()
    for path in sorted(candidate for candidate in root.rglob("*") if candidate.is_file()):
        relative = path.relative_to(root)
        if any(part in _IGNORED_RUNTIME_DIRECTORIES for part in relative.parts):
            continue
        _ = digest.update(relative.as_posix().encode("utf-8"))
        _ = digest.update(b"\0")
        _ = digest.update(path.read_bytes())
        _ = digest.update(b"\0")
    return f"sha256:{digest.hexdigest()}"


def _write_declaration(root: Path, *, name: str, status: str) -> None:
    declaration = root / ".repo" / "capabilities" / f"{name}.toml"
    declaration.parent.mkdir(parents=True, exist_ok=True)
    _ = declaration.write_text(
        f'''schema_version = 1
name = "{name}"
python_module = "{{ package }}.modules.{name}"
status = "{status}"
proof_catalog = "proof/modules/{name}.toml"

[boundaries]
inbound = []
outbound = []

[activation]
api = "{{ package }}.modules.{name}.api"
factory = ""
cli_catalog = ""
''',
        encoding="utf-8",
    )


@pytest.mark.integration
def test_empty_queries_use_versioned_json_without_changing_repository_state(tmp_path: Path) -> None:
    before = _full_state_digest(tmp_path)

    capabilities = _run_repoctl(("capabilities",), cwd=tmp_path)
    status = _run_repoctl(("status",), cwd=tmp_path)

    after = _full_state_digest(tmp_path)
    assert capabilities.returncode == 0, capabilities.stderr
    assert status.returncode == 0, status.stderr
    capability_data = _mapping(_document(capabilities.stdout)["data"])
    status_data = _mapping(_document(status.stdout)["data"])

    assert capabilities.stderr == ""
    assert _document(capabilities.stdout)["schema_version"] == "1.0"
    assert capability_data["capabilities"] == []
    assert status.stderr == ""
    assert _mapping(status_data["repository"])["schema_version"] == 1
    assert status_data["capability_counts"] == {"draft": 0, "active": 0, "retired": 0}
    assert after == before


@pytest.mark.integration
def test_capabilities_are_bounded_and_invalid_limits_are_structured(tmp_path: Path) -> None:
    _write_declaration(tmp_path, name="alpha", status="draft")
    _write_declaration(tmp_path, name="beta", status="active")

    bounded = _run_repoctl(("capabilities", "--limit", "1"), cwd=tmp_path)
    invalid = _run_repoctl(("capabilities", "--limit", "0"), cwd=tmp_path)

    assert bounded.returncode == 0, bounded.stderr
    assert invalid.returncode == 2, invalid.stderr
    assert invalid.stdout == ""
    bounded_document = _document(bounded.stdout)
    bounded_data = _mapping(bounded_document["data"])
    metadata = _mapping(bounded_document["metadata"])
    error = _mapping(_document(invalid.stderr)["error"])

    assert len(_object_list(bounded_data["capabilities"])) == 1
    assert metadata["truncated"] is True
    assert isinstance(metadata["continuation"], str)
    assert metadata["continuation"]
    assert error["code"] == "invalid_syntax"


@pytest.mark.integration
def test_control_catalog_uses_the_product_command_protocol_types() -> None:
    assert {spec.name.value for spec in COMMAND_CATALOG} == {
        ControlCommandName.CAPABILITIES.value,
        ControlCommandName.STATUS.value,
        ControlCommandName.CAPABILITY_PLAN.value,
        ControlCommandName.CAPABILITY_APPLY.value,
    }
    assert all(type(spec) is CommandSpec for spec in COMMAND_CATALOG)
    assert all(
        isinstance(spec.policy, QueryPolicy)
        for spec in COMMAND_CATALOG
        if spec.kind == CommandKind.QUERY
    )
    assert all(
        isinstance(spec.policy, MutationPolicy)
        for spec in COMMAND_CATALOG
        if spec.kind == CommandKind.MUTATION
    )
