"""Detached-process evidence for repository-control capability mutations."""

from hashlib import sha256
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tomllib
from typing import cast

import pytest

_IGNORED_RUNTIME_DIRECTORIES = frozenset(
    {".git", ".pytest_cache", ".ruff_cache", ".venv", "__pycache__"}
)


def _environment(project_root: Path) -> dict[str, str]:
    environment = os.environ.copy()
    previous_pythonpath = environment.get("PYTHONPATH", "")
    environment["PYTHONPATH"] = os.pathsep.join(
        part for part in (str(project_root), previous_pythonpath) if part
    )
    return environment


def _run_repoctl(args: tuple[str, ...], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    project_root = Path(__file__).resolve().parents[3]
    return subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0002
        [sys.executable, "-m", "repoctl", *args],
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        env=_environment(project_root),
        text=True,
        timeout=10,
        check=False,
    )


def _document(raw: str) -> dict[str, object]:
    value = cast("object", json.loads(raw))
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def _mapping(value: object) -> dict[str, object]:
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def _full_state_digest(root: Path, *, excluding: Path | None = None) -> str:
    digest = sha256()
    excluded = excluding.resolve() if excluding is not None else None
    for path in sorted(candidate for candidate in root.rglob("*") if candidate.is_file()):
        relative = path.relative_to(root)
        if any(part in _IGNORED_RUNTIME_DIRECTORIES for part in relative.parts):
            continue
        if excluded is not None and path.resolve() == excluded:
            continue
        _ = digest.update(relative.as_posix().encode("utf-8"))
        _ = digest.update(b"\0")
        _ = digest.update(path.read_bytes())
        _ = digest.update(b"\0")
    return f"sha256:{digest.hexdigest()}"


def _plan_alpha(tmp_path: Path) -> tuple[Path, subprocess.CompletedProcess[str]]:
    output = tmp_path / ".repo" / "plans" / "alpha.json"
    result = _run_repoctl(
        (
            "capability",
            "plan",
            "alpha",
            "--inbound",
            "python",
            "--output",
            output.relative_to(tmp_path).as_posix(),
        ),
        cwd=tmp_path,
    )
    return output, result


@pytest.mark.integration
def test_capability_plan_is_inspectable_without_changing_repository_state(tmp_path: Path) -> None:
    output = tmp_path / ".repo" / "plans" / "alpha.json"
    before = _full_state_digest(tmp_path, excluding=output)

    planned_output, result = _plan_alpha(tmp_path)

    after = _full_state_digest(tmp_path, excluding=output)
    assert result.returncode == 0, result.stderr
    assert result.stderr == ""
    assert planned_output == output
    assert output.is_file()
    document = _document(result.stdout)
    plan_document = _mapping(_mapping(document["data"])["plan"])
    assert document["schema_version"] == "1.0"
    assert document["command"] == "capability plan"
    assert plan_document["intent"] == {
        "schema_version": 1,
        "name": "alpha",
        "inbound": ["python"],
        "outbound": [],
    }
    assert json.loads(output.read_text(encoding="utf-8")) == plan_document
    assert after == before


@pytest.mark.integration
def test_capability_apply_creates_one_valid_draft_capsule_and_replays_stably(
    tmp_path: Path,
) -> None:
    output, planned = _plan_alpha(tmp_path)
    assert planned.returncode == 0, planned.stderr

    plan_argument = output.relative_to(tmp_path).as_posix()
    first = _run_repoctl(("capability", "apply", plan_argument), cwd=tmp_path)
    after_first = _full_state_digest(tmp_path)
    second = _run_repoctl(("capability", "apply", plan_argument), cwd=tmp_path)
    after_second = _full_state_digest(tmp_path)

    assert first.returncode == 0, first.stderr
    assert second.returncode == 0, second.stderr
    first_data = _mapping(_document(first.stdout)["data"])
    second_data = _mapping(_document(second.stdout)["data"])
    assert first_data["status"] == "applied"
    assert second_data["status"] == "already_applied"
    assert after_second == after_first

    declaration = tmp_path / ".repo" / "capabilities" / "alpha.toml"
    assert tomllib.loads(declaration.read_text(encoding="utf-8"))["status"] == "draft"

    project_root = Path(__file__).resolve().parents[3]
    _ = shutil.copyfile(project_root / "architecture.toml", tmp_path / "architecture.toml")
    capsule = tmp_path / "src" / "{{ package }}" / "modules" / "alpha"
    validator = subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0002
        [
            sys.executable,
            "-m",
            "scripts.capability_validator",
            "--repository-root",
            str(tmp_path),
            "--root",
            str(capsule),
        ],
        cwd=tmp_path,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        env=_environment(project_root),
        text=True,
        timeout=10,
        check=False,
    )
    assert validator.returncode == 0, validator.stderr

    capsule_text = "\n".join(
        path.read_text(encoding="utf-8") for path in sorted(capsule.rglob("*.py"))
    )
    assert "NotImplementedError" not in capsule_text
    assert re.search(r"class\s+\w*(?:Entity|Item|Order|Record|Task)\b", capsule_text) is None
    assert "assert True" not in capsule_text
