"""Independent behavior cases for every public command outcome."""

from dataclasses import dataclass
from typing import Literal


@dataclass(frozen=True, slots=True, kw_only=True)
class OutcomeContractCase:
    command: Literal["add", "capabilities", "list"]
    code: str
    args: tuple[str, ...]
    pre_args: tuple[tuple[str, ...], ...]
    exit_code: Literal[2, 3, 4, 70]
    retryable: bool
    detail_keys: tuple[str, ...]
    process_condition: Literal["ordinary", "broken_stdout", "incompatible_store"] = "ordinary"

    def __post_init__(self) -> None:
        if not self.code or not self.args or self.args[0] != self.command:
            raise ValueError("Outcome cases require one command-owned invocation.")
        if self.retryable != (self.exit_code == 4):
            raise ValueError("Only temporary outcome cases are retryable.")
        if len(self.detail_keys) != len(set(self.detail_keys)):
            raise ValueError("Outcome detail keys must be unique.")


