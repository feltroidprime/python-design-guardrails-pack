"""Reusable behavioral contract for ItemRepository implementations.

Certify every repository adapter by subclassing this contract in a
``Test*`` class that provides a ``repository`` fixture returning a fresh
implementation (pytest resolves it per test). All implementations are then
held to the same observable behavior.
"""

from concurrent.futures import ThreadPoolExecutor
from threading import Barrier, Lock
from time import sleep
from typing import TYPE_CHECKING

import pytest

from {{ package }}.application.errors import IdempotencyConflictError, RepositoryError
from {{ package }}.application.idempotency import IdempotencyKey, RequestFingerprint
from {{ package }}.application.query_models import AfterItem, FirstPage, ItemField
from {{ package }}.domain.entities import Item
from {{ package }}.domain.value_objects import ItemId, ItemName

if TYPE_CHECKING:
    from {{ package }}.application.idempotency import IdempotentCreateResult
    from {{ package }}.application.ports import ItemRepository


class ItemRepositoryContract:
    """Behavior every ItemRepository implementation must exhibit."""

    @pytest.mark.contract
    def test_round_trip_preserves_the_aggregate(self, repository: ItemRepository) -> None:
        item = Item(item_id=ItemId(value="contract-1"), name=ItemName(value="Contract"))

        repository.save(item)

        assert repository.get(item.item_id) == item

    @pytest.mark.contract
    def test_get_returns_none_for_unknown_id(self, repository: ItemRepository) -> None:
        assert repository.get(ItemId(value="missing")) is None

    @pytest.mark.contract
    def test_save_replaces_prior_state_for_same_id(self, repository: ItemRepository) -> None:
        item_id = ItemId(value="contract-2")
        repository.save(Item(item_id=item_id, name=ItemName(value="Before")))

        repository.save(Item(item_id=item_id, name=ItemName(value="After")))

        stored = repository.get(item_id)
        assert stored is not None
        assert stored.name == ItemName(value="After")

    @pytest.mark.contract
    def test_list_page_is_bounded_ordered_and_continuable(self, repository: ItemRepository) -> None:
        repository.save(Item(item_id=ItemId(value="contract-3"), name=ItemName(value="First")))
        repository.save(Item(item_id=ItemId(value="contract-4"), name=ItemName(value="Second")))

        first = repository.list_page(start=FirstPage(), limit=1)
        second = repository.list_page(start=AfterItem(item_id=first[-1].item_id), limit=1)

        assert [item.item_id.value for item in first] == ["contract-3"]
        assert [item.item_id.value for item in second] == ["contract-4"]

    @pytest.mark.contract
    def test_list_page_filters_before_limit_and_projects_selected_fields(
        self, repository: ItemRepository
    ) -> None:
        rows = (
            ("contract-1", "Noise"),
            ("contract-2", "Match one"),
            ("contract-3", "Noise"),
            ("contract-4", "Match two"),
        )
        for item_id, name in rows:
            repository.save(Item(item_id=ItemId(value=item_id), name=ItemName(value=name)))

        selected = repository.list_page(
            start=FirstPage(),
            limit=2,
            name_contains="Match",
            fields=(ItemField.NAME,),
        )

        assert [[value.field for value in item.values] for item in selected] == [
            [ItemField.NAME],
            [ItemField.NAME],
        ]
        assert [[value.value for value in item.values] for item in selected] == [
            ["Match one"],
            ["Match two"],
        ]

    @pytest.mark.contract
    def test_same_idempotency_key_and_request_replays_one_item(
        self, repository: ItemRepository
    ) -> None:
        calls = 0

        def create() -> Item:
            nonlocal calls
            calls += 1
            return Item(item_id=ItemId(value=f"idempotent-{calls}"), name=ItemName(value="Stable"))

        key = IdempotencyKey(value="stable-key")
        fingerprint = RequestFingerprint(value="stable-fingerprint")
        first = repository.create_once(key=key, fingerprint=fingerprint, create=create)
        second = repository.create_once(key=key, fingerprint=fingerprint, create=create)

        assert first.replayed is False
        assert second.replayed is True
        assert second.item == first.item
        assert calls == 1

    @pytest.mark.contract
    def test_mismatched_idempotency_request_conflicts_without_a_second_effect(
        self, repository: ItemRepository
    ) -> None:
        key = IdempotencyKey(value="conflict-key")
        original = Item(item_id=ItemId(value="conflict-1"), name=ItemName(value="Original"))
        _ = repository.create_once(
            key=key,
            fingerprint=RequestFingerprint(value="original"),
            create=lambda: original,
        )

        with pytest.raises(IdempotencyConflictError):
            _ = repository.create_once(
                key=key,
                fingerprint=RequestFingerprint(value="different"),
                create=lambda: Item(
                    item_id=ItemId(value="conflict-2"), name=ItemName(value="Different")
                ),
            )

        assert repository.get(original.item_id) == original
        assert repository.get(ItemId(value="conflict-2")) is None

    @pytest.mark.contract
    def test_idempotency_reservation_rolls_back_when_creation_fails(
        self, repository: ItemRepository
    ) -> None:
        key = IdempotencyKey(value="rollback-key")
        fingerprint = RequestFingerprint(value="rollback")

        def fail() -> Item:
            raise RepositoryError("Injected create dependency failure.")

        with pytest.raises(RepositoryError, match="Injected"):
            _ = repository.create_once(key=key, fingerprint=fingerprint, create=fail)

        expected = Item(item_id=ItemId(value="rollback-1"), name=ItemName(value="Recovered"))
        recovered = repository.create_once(
            key=key, fingerprint=fingerprint, create=lambda: expected
        )

        assert recovered.replayed is False
        assert recovered.item == expected

    @pytest.mark.contract
    def test_concurrent_same_request_retries_create_exactly_once(
        self, concurrent_repositories: tuple[ItemRepository, ItemRepository]
    ) -> None:
        start = Barrier(2)
        calls_lock = Lock()
        calls = 0
        key = IdempotencyKey(value="concurrent-key")
        fingerprint = RequestFingerprint(value="concurrent-fingerprint")

        def invoke(repository: ItemRepository) -> IdempotentCreateResult:
            def create() -> Item:
                nonlocal calls
                with calls_lock:
                    calls += 1
                    call = calls
                sleep(0.05)
                return Item(
                    item_id=ItemId(value=f"concurrent-{call}"),
                    name=ItemName(value="Concurrent"),
                )

            _ = start.wait(timeout=2)
            return repository.create_once(key=key, fingerprint=fingerprint, create=create)

        with ThreadPoolExecutor(max_workers=2) as executor:
            results = tuple(executor.map(invoke, concurrent_repositories))

        assert calls == 1
        assert {result.replayed for result in results} == {False, True}
        assert results[0].item == results[1].item
