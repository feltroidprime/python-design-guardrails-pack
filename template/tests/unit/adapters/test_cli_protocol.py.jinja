@pytest.mark.parametrize(("kind", "policy", "policy_key"), POLICY_CASES)
def test_every_closed_policy_has_a_public_capability_shape(
    kind: CommandKind, policy: CommandPolicy, policy_key: str
) -> None:
    arguments: tuple[ArgumentSpec, ...] = (OutputOption(), DEBUG_OPTION)
    if isinstance(policy, QueryPolicy):
        arguments = (
            PageLimitOption(flag="--limit", destination="limit", help="positive page size"),
            *arguments,
        )
    machine_mode = OutputMode.JSON_LINES if kind == CommandKind.STREAMING else OutputMode.JSON
    spec = CommandSpec(
        name=CommandName.ADD,
        kind=kind,
        purpose="Synthetic contract case.",
        automation_example="python -m example add value",
        output_modes=(machine_mode, OutputMode.HUMAN),
        default_output_mode=machine_mode,
        policy=policy,
        input_policy=ARGUMENT_INPUT,
        safety=NonDestructiveSafety(),
        outcomes=(),
        arguments=arguments,
    )

    document = capability_document(spec)

    assert document["kind"] == kind.value
    assert document["output_modes"] == [machine_mode.value, "human"]
    assert document["default_output_mode"] == machine_mode.value
    assert policy_key in document
