def test_outcome_and_failure_shapes_reject_unsafe_metadata() -> None:
    with pytest.raises(ValueError, match="guidance"):
        _ = OutcomeSpec(
            code=OutcomeCode.INVALID_ITEM_NAME,
            exit_code=ExitCode.PERMANENT_REJECTION,
            retryable=False,
            details=(),
            hint="",
        )
    with pytest.raises(ValueError, match="unique safe detail"):
        _ = OutcomeSpec(
            code=OutcomeCode.INVALID_ITEM_NAME,
            exit_code=ExitCode.PERMANENT_REJECTION,
            retryable=False,
            details=(ComputedDetail(key="field"), ComputedDetail(key="field")),
            hint="Correct the request.",
        )
    with pytest.raises(ValueError, match="Only temporary"):
        _ = OutcomeSpec(
            code=OutcomeCode.DEPENDENCY_UNAVAILABLE,
            exit_code=ExitCode.PERMANENT_REJECTION,
            retryable=True,
            details=(),
            hint="Retry.",
        )
    with pytest.raises(ValueError, match="not allowlisted"):
        _ = FailureBody(
            outcome=COMMAND_CATALOG[0].outcomes[0],
            message="Rejected.",
            details=(ComputedFailureDetail(key="secret", value="must-not-appear"),),
        )

    invalid_item = COMMAND_CATALOG[0].outcomes[0]
    with pytest.raises(TypeError, match="exact provenance"):
        _ = FailureBody(
            outcome=invalid_item,
            message="Rejected.",
            details=(
                ArgumentFailureDetail(
                    key="rejected_value",
                    argument_source="idempotency_key",
                    value="must-not-appear",
                ),
            ),
        )


def test_command_schema_rejects_details_sourced_from_sensitive_arguments() -> None:
    add = COMMAND_CATALOG[0]
    sensitive = next(
        argument
        for argument in add.arguments
        if isinstance(argument, TextOption) and argument.sensitive
    )
    leaking = OutcomeSpec(
        code=OutcomeCode.INVALID_IDEMPOTENCY_KEY,
        exit_code=ExitCode.PERMANENT_REJECTION,
        retryable=False,
        details=(ArgumentDetail(key="rejected_value", argument_source=sensitive.destination),),
        hint="Do not leak the value.",
    )

    with pytest.raises(ValueError, match="sensitive argument"):
        _ = replace(add, outcomes=(leaking,))


def test_continuations_are_opaque_and_bound_to_selection() -> None:
    selection: dict[str, object] = {"filter": "Match", "fields": ["name"]}
    token = encode_continuation("item-1", selection=selection)

    assert decode_continuation(token, selection=selection) == "item-1"
    with pytest.raises(InvalidContinuationError, match="malformed"):
        _ = decode_continuation("not-a-token", selection=selection)
    non_document = base64.urlsafe_b64encode(b"[]").decode()
    with pytest.raises(InvalidContinuationError, match="malformed"):
        _ = decode_continuation(non_document, selection=selection)
    missing_position = base64.urlsafe_b64encode(b'{"selection":{}}').decode()
    with pytest.raises(InvalidContinuationError, match="stable position"):
        _ = decode_continuation(missing_position, selection={})
    with pytest.raises(InvalidContinuationError, match="another query"):
        _ = decode_continuation(token, selection={"filter": "Different"})


def test_destructive_capability_shape_requires_cataloged_controls() -> None:
    add = COMMAND_CATALOG[0]
    safety = DestructiveSafety(
        preview_control="--dry-run",
        confirmation_control="--confirm",
        plan_fields=("effects",),
    )
    controls = (
        FlagOption(flag="--dry-run", destination="dry_run", help="preview"),
        FlagOption(flag="--confirm", destination="confirm", help="confirm"),
    )

    destructive = replace(add, safety=safety, arguments=(*add.arguments, *controls))
    document = capability_document(destructive)

    assert document["safety"] == {
        "kind": "destructive",
        "preview_control": "--dry-run",
        "confirmation_control": "--confirm",
        "plan_fields": ["effects"],
    }


