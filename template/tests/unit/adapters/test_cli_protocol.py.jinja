def test_schema_and_exit_classes_remain_the_adr_0003_contract() -> None:
    assert SCHEMA_VERSION == "1.0"
    assert PROTOCOL_DECISION == "ADR-0003"
    assert PROTOCOL_DECISIONS == ("ADR-0003", "ADR-0005")
    assert {member.name: member.value for member in ExitCode} == {
        "SUCCESS": 0,
        "SYNTAX": 2,
        "PERMANENT_REJECTION": 3,
        "TEMPORARY_UNAVAILABLE": 4,
        "UNEXPECTED_FAILURE": 70,
    }


def test_adr_0003_pins_existing_command_identities_kinds_and_required_policies() -> None:
    documents = {spec.name.value: capability_document(spec) for spec in COMMAND_CATALOG}

    assert documents["add"]["kind"] == "mutation"
    assert documents["add"]["mutation"] == {
        "retry": "conditional",
        "retry_control": "--idempotency-key",
        "unsafe_without_control": True,
    }
    assert documents["capabilities"]["kind"] == "query"
    assert documents["capabilities"]["bounds"] == {
        "default_limit": 2,
        "maximum_limit": 100,
        "stable_order": "command name",
        "continuation": True,
    }
    assert documents["list"]["kind"] == "query"
    assert documents["list"]["bounds"] == {
        "default_limit": 2,
        "maximum_limit": 200,
        "stable_order": "item identifier",
        "continuation": True,
    }


@pytest.mark.parametrize(
    ("default_limit", "maximum_limit"),
    [(0, 1), (2, 1)],
)
def test_query_policy_rejects_non_positive_or_inverted_bounds(
    default_limit: int, maximum_limit: int
) -> None:
    with pytest.raises(ValueError, match="positive and ordered"):
        _ = QueryPolicy(
            default_limit=default_limit,
            maximum_limit=maximum_limit,
            stable_order="identifier",
            continuation=True,
        )


def test_closed_policies_reject_incomplete_automation_controls() -> None:
    with pytest.raises(ValueError, match="stable ordering"):
        _ = QueryPolicy(default_limit=1, maximum_limit=1, stable_order="", continuation=True)
    with pytest.raises(ValueError, match="filters"):
        _ = QueryPolicy(
            default_limit=1,
            maximum_limit=1,
            stable_order="id",
            continuation=True,
            filters=("name",),
        )
    with pytest.raises(ValueError, match="Selectable"):
        _ = QueryPolicy(
            default_limit=1,
            maximum_limit=1,
            stable_order="id",
            continuation=True,
            selectable_fields=("",),
        )
    with pytest.raises(ValueError, match="Quiet"):
        _ = QueryPolicy(
            default_limit=1,
            maximum_limit=1,
            stable_order="id",
            continuation=True,
            quiet=True,
        )
    with pytest.raises(ValueError, match="Conditional"):
        _ = MutationPolicy(retry=RetryPolicy.CONDITIONAL)
    with pytest.raises(ValueError, match="Only conditional"):
        _ = MutationPolicy(retry=RetryPolicy.UNSAFE, unsafe_without_control=True)
    with pytest.raises(ValueError, match="Streams require"):
        _ = StreamingPolicy(filters=(), termination_controls=())
    with pytest.raises(ValueError, match="Stream controls"):
        _ = StreamingPolicy(filters=("kind",), termination_controls=("--limit",))
    with pytest.raises(ValueError, match="Interactive"):
        _ = InteractivePolicy(automation_inputs=())
    with pytest.raises(ValueError, match="Bulk"):
        _ = BulkPolicy(required_scope=(), destination_required=True)


def test_command_spec_rejects_protocol_shape_drift() -> None:
    add = COMMAND_CATALOG[0]
    with pytest.raises(ValueError, match="invoke its command name"):
        _ = replace(add, automation_example="python -m example list")
    with pytest.raises(ValueError, match="Output modes must be unique"):
        _ = replace(add, output_modes=(OutputMode.JSON, OutputMode.JSON, OutputMode.HUMAN))
    with pytest.raises(ValueError, match="machine-default"):
        _ = replace(add, default_output_mode=OutputMode.HUMAN)
    with pytest.raises(ValueError, match="exactly one output"):
        _ = replace(
            add,
            arguments=tuple(
                argument for argument in add.arguments if not isinstance(argument, OutputOption)
            ),
        )
    with pytest.raises(ValueError, match="outcomes must be unique"):
        _ = replace(add, outcomes=(add.outcomes[0], add.outcomes[0]))
    with pytest.raises(ValueError, match="kind and policy"):
        _ = replace(add, kind=CommandKind.QUERY)
    with pytest.raises(ValueError, match="single-line"):
        _ = replace(add, purpose="Two\nlines")


