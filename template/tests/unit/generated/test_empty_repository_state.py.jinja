from hashlib import sha256
import json
from pathlib import Path
import re
import runpy
import tomllib
from typing import cast

from scripts.ownership import classify_path
from scripts.ownership_policy import load_ownership_policy

GENERATED_BANNER = "Generated from repository declarations. DO NOT EDIT."
SOURCE_DIGEST = re.compile(r'source[-_]state[-_]sha256["]?\s*:\s*["]?([0-9a-f]{64})')
PYTHON_INDEXES = (
    (Path("src/{{ package }}/_generated/active_capabilities.py"), "ACTIVE_CAPABILITIES"),
    (Path("src/{{ package }}/_generated/composition.py"), "COMPOSITION"),
    (Path("src/{{ package }}/_generated/cli_catalog.py"), "CLI_CATALOGS"),
)
PROOF_INDEX = Path("proof/_generated/index.json")


def repository_root() -> Path:
    return Path(__file__).resolve().parents[3]


def source_state_digest(root: Path, source_glob: str) -> str:
    digest = sha256()
    for source in sorted(root.glob(source_glob)):
        digest.update(source.relative_to(root).as_posix().encode())
        digest.update(b"\0")
        digest.update(source.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def declared_source_glob(declaration: dict[str, object]) -> str:
    derived = declaration.get("derived")
    assert isinstance(derived, dict)
    source_glob = cast("dict[str, object]", derived).get("source_glob")
    assert isinstance(source_glob, str)
    return source_glob


def capability_declarations(
    root: Path,
    source_glob: str,
) -> tuple[dict[str, object], ...]:
    return tuple(
        cast(
            "dict[str, object]",
            tomllib.loads(source.read_text(encoding="utf-8")),
        )
        for source in sorted(root.glob(source_glob))
    )


def table(document: dict[str, object], name: str) -> dict[str, object]:
    value = document.get(name)
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def active_declarations(
    declarations: tuple[dict[str, object], ...],
) -> tuple[dict[str, object], ...]:
    return tuple(
        sorted(
            (declaration for declaration in declarations if declaration.get("status") == "active"),
            key=lambda declaration: cast("str", declaration["name"]),
        )
    )


def recorded_digest(path: Path) -> str:
    head = "\n".join(path.read_text(encoding="utf-8").splitlines()[:4])
    assert GENERATED_BANNER in head
    match = SOURCE_DIGEST.search(head)
    assert match is not None
    return match.group(1)


def test_repository_state_is_versioned_classified_and_honestly_derived() -> None:
    root = repository_root()
    declaration_path = root / ".repo/repository.toml"
    declaration = cast(
        "dict[str, object]",
        tomllib.loads(declaration_path.read_text(encoding="utf-8")),
    )
    policy = load_ownership_policy(root)

    assert declaration["schema_version"] == 1
    assert str(classify_path(Path(".repo/repository.toml"), policy)) == "DECLARATION"

    source_glob = declared_source_glob(declaration)
    expected_digest = source_state_digest(root, source_glob)
    active = active_declarations(capability_declarations(root, source_glob))
    derived_paths = (*(path for path, _export in PYTHON_INDEXES), PROOF_INDEX)
    assert {recorded_digest(root / path) for path in derived_paths} == {expected_digest}
    assert all(str(classify_path(path, policy)) == "DERIVED" for path in derived_paths)

    namespaces = {
        export: cast("dict[str, object]", runpy.run_path(str(root / path)))[export]
        for path, export in PYTHON_INDEXES
    }
    assert namespaces["ACTIVE_CAPABILITIES"] == tuple(
        declaration["python_module"] for declaration in active
    )
    assert len(cast("tuple[object, ...]", namespaces["COMPOSITION"])) == sum(
        bool(table(declaration, "activation").get("factory")) for declaration in active
    )
    assert len(cast("tuple[object, ...]", namespaces["CLI_CATALOGS"])) == sum(
        bool(table(declaration, "activation").get("cli_catalog")) for declaration in active
    )

    proof_index = cast(
        "dict[str, object]",
        json.loads((root / PROOF_INDEX).read_text(encoding="utf-8")),
    )
    assert proof_index["catalogs"] == [
        {
            "path": declaration["proof_catalog"],
            "ownership_zone": str(
                classify_path(Path(cast("str", declaration["proof_catalog"])), policy)
            ).lower(),
        }
        for declaration in active
    ]
