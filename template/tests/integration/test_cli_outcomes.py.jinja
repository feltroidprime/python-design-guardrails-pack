"""Exact command-outcome declarations and their independent behavior cases."""

from contextlib import closing
import json
import os
import sqlite3
import subprocess
import sys
from typing import TYPE_CHECKING, cast

import pytest

from {{ package }}.adapters.inbound.cli_catalog import COMMAND_CATALOG
from {{ package }}.adapters.inbound.cli_outcomes import SHARED_OUTCOMES
from tests.contract.cli_outcome_cases import OUTCOME_CONTRACT_CASES, OutcomeContractCase

if TYPE_CHECKING:
    from pathlib import Path


def run_process(args: tuple[str, ...], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0003
        [sys.executable, "-m", "{{ package }}", *args],
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )


def run_process_with_broken_stdout(
    args: tuple[str, ...], *, cwd: Path
) -> subprocess.CompletedProcess[str]:
    read_fd, write_fd = os.pipe()
    os.close(read_fd)
    try:
        completed = subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0005
            [sys.executable, "-m", "{{ package }}", *args],
            cwd=cwd,
            env={**os.environ, "PYTHONUNBUFFERED": "1"},
            stdin=subprocess.DEVNULL,
            stdout=write_fd,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
            check=False,
        )
    finally:
        os.close(write_fd)
    return subprocess.CompletedProcess(
        args=[sys.executable, "-m", "{{ package }}", *args],
        returncode=completed.returncode,
        stdout="",
        stderr=completed.stderr,
    )


def create_incompatible_store(cwd: Path) -> None:
    with closing(sqlite3.connect(cwd / "items.db")) as connection, connection:
        _ = connection.execute("CREATE TABLE items (incompatible TEXT)")
        _ = connection.execute("CREATE TABLE item_idempotency (incompatible TEXT)")


def mapping(value: object) -> dict[str, object]:
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def document(raw: str) -> dict[str, object]:
    return mapping(cast("object", json.loads(raw)))


def execute_case(case: OutcomeContractCase, *, cwd: Path) -> subprocess.CompletedProcess[str]:
    for args in case.pre_args:
        assert run_process(args, cwd=cwd).returncode == 0
    if case.process_condition == "incompatible_store":
        create_incompatible_store(cwd)
    if case.process_condition == "broken_stdout":
        return run_process_with_broken_stdout(case.args, cwd=cwd)
    return run_process(case.args, cwd=cwd)


def outcome_id(case: OutcomeContractCase) -> str:
    return f"{case.command}-{case.code}"


@pytest.mark.integration
def test_catalog_and_outcome_cases_are_exactly_complete() -> None:
    declared = {
        (spec.name.value, outcome.code.value)
        for spec in COMMAND_CATALOG
        for outcome in (*SHARED_OUTCOMES, *spec.outcomes)
    }
    cases = {(case.command, case.code) for case in OUTCOME_CONTRACT_CASES}

    assert len(cases) == len(OUTCOME_CONTRACT_CASES)
    assert declared == cases


@pytest.mark.integration
@pytest.mark.parametrize("case", OUTCOME_CONTRACT_CASES, ids=outcome_id)
def test_every_declared_command_outcome_matches_its_independent_case(
    case: OutcomeContractCase, tmp_path: Path
) -> None:
    completed = execute_case(case, cwd=tmp_path)
    error = mapping(document(completed.stderr)["error"])
    details = mapping(error["details"])

    assert completed.returncode == case.exit_code
    assert completed.stdout == ""
    assert error["code"] == case.code
    assert error["retryable"] is case.retryable
    assert set(details) == set(case.detail_keys)
    assert isinstance(error["hint"], str)
    assert error["hint"]
    assert "\x1b" not in completed.stderr
    assert "Traceback" not in completed.stderr
