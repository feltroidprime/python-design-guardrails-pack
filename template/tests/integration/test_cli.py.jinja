@pytest.mark.integration
def test_dependency_failure_has_a_temporary_exit_classification() -> None:
    connection = sqlite3.connect(":memory:")
    application = build_application(SqliteItemRepository(connection))
    connection.close()

    exit_code, out, err = run_cli(application, ["add", "Unavailable"])
    error = error_document(err)

    assert exit_code == 4
    assert out == ""
    assert error["code"] == "dependency_unavailable"
    assert error["retryable"] is True

    human_exit, _, human_error = run_cli(application, ["add", "Unavailable", "--format", "human"])
    assert human_exit == 4
    assert human_error.startswith("error:")


