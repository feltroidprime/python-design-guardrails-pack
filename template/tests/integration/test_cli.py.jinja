@pytest.mark.integration
def test_unexpected_failures_are_hidden_unless_debug_is_explicit(tmp_path: Path) -> None:
    connection = sqlite3.connect(tmp_path / "items.db")
    _ = connection.execute("CREATE TABLE items (item_id TEXT PRIMARY KEY, name TEXT NOT NULL)")
    _ = connection.execute("INSERT INTO items (item_id, name) VALUES ('', 'broken')")
    connection.commit()
    connection.close()

    hidden = run_process(["list"], cwd=tmp_path)
    error = error_document(hidden.stderr)

    assert hidden.returncode == 70
    assert hidden.stdout == ""
    assert error["code"] == "unexpected_failure"
    assert error["retryable"] is False
    assert "--debug" in cast("str", error["hint"])
    assert "Traceback" not in hidden.stderr

    debug = run_process(["list", "--debug"], cwd=tmp_path)
    assert debug.returncode == 70
    assert "Traceback" in debug.stderr


@pytest.mark.integration
def test_unexpected_translation_and_debug_also_use_the_in_process_seam() -> None:
    connection = sqlite3.connect(":memory:")
    repository = SqliteItemRepository(connection)
    _ = connection.execute("INSERT INTO items (item_id, name) VALUES ('', 'broken')")
    application = build_application(repository)

    exit_code, out, err = run_cli(application, ["list"])
    assert exit_code == 70
    assert out == ""
    assert error_document(err)["code"] == "unexpected_failure"

    debug_exit, debug_out, debug_error = run_cli(application, ["list", "--debug"])
    assert debug_exit == 70
    assert debug_out == ""
    assert "ValueError: Item identifier must not be blank." in debug_error
    connection.close()
