@pytest.mark.integration
def test_detailed_query_and_human_modes_use_the_in_process_seam() -> None:
    application = memory_application()
    for name in ("One", "Two", "Three"):
        assert run_cli(application, ["add", name])[0] == 0

    exit_code, out, err = run_cli(application, ["list"])
    first = document(out)
    first_metadata = mapping(first["metadata"])
    continuation = first_metadata["continuation"]
    assert isinstance(continuation, str)

    assert exit_code == 0
    assert err == ""
    assert first_metadata["truncated"] is True
    assert run_cli(application, ["list", "--continuation", continuation])[0] == 0

    list_human = run_cli(application, ["list", "--format", "human"])
    capabilities = run_cli(application, ["capabilities"])
    capabilities_human = run_cli(
        application, ["capabilities", "--format", "human", "--limit", "100"]
    )
    add_human = run_cli(application, ["add", "Human", "--format", "human"])

    assert list_human[0] == 0
    assert list_human[1].count("\n") == 2
    assert capabilities[0] == 0
    assert '"command":"capabilities"' in capabilities[1]
    assert capabilities_human[0] == 0
    assert "capabilities" in capabilities_human[1]
    assert add_human[0] == 0
    assert add_human[1].startswith("created ")


