@pytest.mark.integration
def test_conditional_idempotency_failures_use_the_in_process_translation_seam() -> None:
    application = memory_application()
    assert run_cli(application, ["add", "Original", "--idempotency-key", "shared"])[0] == 0

    conflict = run_cli(application, ["add", "Different", "--idempotency-key", "shared"])
    invalid_key = run_cli(application, ["add", "Valid", "--idempotency-key", "   "])

    assert conflict[0] == 3
    assert error_document(conflict[2])["code"] == "idempotency_conflict"
    assert invalid_key[0] == 3
    assert error_document(invalid_key[2])["code"] == "invalid_idempotency_key"


@pytest.mark.integration
def test_query_composition_and_continuation_errors_use_the_in_process_seam() -> None:
    application = memory_application()
    assert run_cli(application, ["add", "Selected"])[0] == 0

    listed = run_cli(application, ["list", "--field", "name", "--quiet"])
    capabilities = run_cli(
        application, ["capabilities", "--field", "name", "--quiet", "--limit", "100"]
    )
    invalid_list = run_cli(application, ["list", "--continuation", "not-a-token"])
    invalid_capabilities = run_cli(application, ["capabilities", "--continuation", "not-a-token"])

    assert listed[:2] == (0, "Selected\n")
    assert capabilities[0] == 0
    assert capabilities[1] == "add\ncapabilities\nlist\n"
    assert error_document(invalid_list[2])["code"] == "invalid_continuation"
    assert error_document(invalid_capabilities[2])["code"] == "invalid_continuation"


