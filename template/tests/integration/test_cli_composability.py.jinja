"""Independent process cases for field selection and format compatibility."""

from contextlib import closing
import json
import sqlite3
import subprocess
import sys
from typing import TYPE_CHECKING, cast

import pytest

if TYPE_CHECKING:
    from pathlib import Path

INVALID_QUERY_ARGS = (
    ("list", "--field", "name", "--quiet", "--format", "json"),
    ("list", "--quiet"),
    ("list", "--field", "nmae"),
    ("capabilities", "--field", "name", "--quiet", "--format", "json"),
    ("capabilities", "--quiet"),
    ("capabilities", "--field", "nmae"),
)


def run_process(args: tuple[str, ...], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0005
        [sys.executable, "-m", "{{ package }}", *args],
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )


def mapping(value: object) -> dict[str, object]:
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def document(raw: str) -> dict[str, object]:
    return mapping(cast("object", json.loads(raw)))


@pytest.mark.integration
@pytest.mark.parametrize("field", ["id", "name"])
def test_list_projects_each_declared_field(field: str, tmp_path: Path) -> None:
    assert run_process(("add", "Projected item"), cwd=tmp_path).returncode == 0

    completed = run_process(("list", "--field", field), cwd=tmp_path)
    items = mapping(document(completed.stdout)["data"])["items"]

    assert completed.returncode == 0
    assert completed.stderr == ""
    assert isinstance(items, list)
    assert [set(mapping(item)) for item in cast("list[object]", items)] == [{field}]


@pytest.mark.integration
@pytest.mark.parametrize("field", ["name", "kind", "purpose"])
def test_capabilities_projects_each_declared_field(field: str, tmp_path: Path) -> None:
    completed = run_process(("capabilities", "--limit", "100", "--field", field), cwd=tmp_path)
    commands = mapping(document(completed.stdout)["data"])["commands"]

    assert completed.returncode == 0
    assert completed.stderr == ""
    assert isinstance(commands, list)
    assert [set(mapping(item)) for item in cast("list[object]", commands)] == [
        {field},
        {field},
        {field},
    ]


@pytest.mark.integration
@pytest.mark.parametrize("args", INVALID_QUERY_ARGS)
def test_invalid_query_format_or_field_combinations_fail_as_syntax(
    args: tuple[str, ...], tmp_path: Path
) -> None:
    with closing(sqlite3.connect(tmp_path / "items.db")) as connection, connection:
        _ = connection.execute("CREATE TABLE items (malformed TEXT)")

    completed = run_process(args, cwd=tmp_path)
    error = mapping(document(completed.stderr)["error"])

    assert completed.returncode == 2
    assert completed.stdout == ""
    assert error["code"] == "invalid_syntax"
    assert "--help" in cast("str", error["hint"])


@pytest.mark.integration
def test_quiet_selectable_values_cannot_break_physical_line_framing(tmp_path: Path) -> None:
    rejected = run_process(("add", "two\nlines"), cwd=tmp_path)
    listed = run_process(("list", "--field", "name", "--quiet"), cwd=tmp_path)

    assert rejected.returncode == 3
    assert rejected.stdout == ""
    assert mapping(document(rejected.stderr)["error"])["code"] == "invalid_item_name"
    assert listed.returncode == 0
    assert listed.stdout == ""
    assert listed.stderr == ""
