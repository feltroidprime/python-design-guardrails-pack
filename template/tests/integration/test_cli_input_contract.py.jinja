"""Independent help and stdin behavior for argument-primary commands."""

import os
import subprocess
import sys
from typing import TYPE_CHECKING

import pytest

from tests.contract.cli_contract_cases import CLI_CONTRACT_CASES, CliContractCase

if TYPE_CHECKING:
    from pathlib import Path


HELP_EXPECTATIONS = (
    (
        "add",
        (
            ("name", ("type: text", "required")),
            ("--idempotency-key", ("type: text", "default: empty")),
            ("--format", ("type: choice", "default: json", "choices: json, human")),
            ("--debug", ("type: boolean", "default: false")),
        ),
    ),
    (
        "capabilities",
        (
            ("--limit", ("maximum: 100", "type: integer", "default: 2")),
            ("--continuation", ("type: text", "default: empty")),
            ("--name-contains", ("type: text", "default: empty")),
            (
                "--kind",
                (
                    "type: choice",
                    "default: empty",
                    "choices: query, mutation, streaming, interactive/bootstrap, bulk/export",
                ),
            ),
            (
                "--field",
                ("type: choice", "default: empty", "choices: name, kind, purpose", "repeatable"),
            ),
            ("-q, --quiet", ("type: boolean", "default: false")),
            ("--format", ("type: choice", "default: json", "choices: json, human")),
            ("--debug", ("type: boolean", "default: false")),
        ),
    ),
    (
        "list",
        (
            ("--limit", ("maximum: 200", "type: integer", "default: 2")),
            ("--continuation", ("type: text", "default: empty")),
            ("--name-contains", ("type: text", "default: empty")),
            (
                "--field",
                ("type: choice", "default: empty", "choices: id, name", "repeatable"),
            ),
            ("-q, --quiet", ("type: boolean", "default: false")),
            ("--format", ("type: choice", "default: json", "choices: json, human")),
            ("--debug", ("type: boolean", "default: false")),
        ),
    ),
)


def argument_help_entries(
    raw_help: str, expectations: tuple[tuple[str, tuple[str, ...]], ...]
) -> dict[str, str]:
    controls = tuple(control for control, _facts in expectations)
    entries: dict[str, str] = {}
    current = ""
    for line in raw_help.splitlines():
        stripped = line.strip()
        control = next(
            (
                candidate
                for candidate in controls
                if stripped == candidate or stripped.startswith(f"{candidate} ")
            ),
            "",
        )
        if line.startswith("  ") and control:
            current = control
            entries[current] = stripped
        elif current and line.startswith("  ") and stripped:
            entries[current] = f"{entries[current]} {stripped}"
        elif not line.startswith("  "):
            current = ""
    return entries


def run_with_open_stdin(
    args: tuple[str, ...], *, cwd: Path, payload: bytes = b"stdin-must-remain-unread\n"
) -> tuple[subprocess.CompletedProcess[str], bytes]:
    read_fd, write_fd = os.pipe()
    observer_fd = os.dup(read_fd)
    _ = os.write(write_fd, payload)
    process = subprocess.Popen(  # noqa: S603  # ARCH-EXCEPTION: ADR-0004
        [sys.executable, "-m", "{{ package }}", *args],
        cwd=cwd,
        stdin=read_fd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    os.close(read_fd)
    try:
        stdout, stderr = process.communicate(timeout=10)
    finally:
        os.close(write_fd)
    remaining = os.read(observer_fd, len(payload))
    os.close(observer_fd)
    return subprocess.CompletedProcess(args, process.returncode, stdout, stderr), remaining


def case_id(case: CliContractCase) -> str:
    return case.name


@pytest.mark.integration
@pytest.mark.parametrize("case", CLI_CONTRACT_CASES, ids=case_id)
def test_every_command_has_an_ordinary_argument_success_at_the_process_seam(
    case: CliContractCase, tmp_path: Path
) -> None:
    command = [sys.executable, "-m", "{{ package }}", *case.input.ordinary_args]
    if case.input.stdin == "required":
        completed = subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0004
            command,
            cwd=tmp_path,
            input=case.input.payload.decode(),
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    else:
        completed = subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0004
            command,
            cwd=tmp_path,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )

    assert completed.returncode == 0
    assert completed.stderr == ""
    assert completed.stdout
    if case.input.stdin == "required" and not case.input.stdin_readback_args:
        assert case.input.stdin_expected_value in completed.stdout


@pytest.mark.integration
@pytest.mark.parametrize("case", CLI_CONTRACT_CASES, ids=case_id)
def test_stdin_forbidden_commands_do_not_consume_an_open_sentinel(
    case: CliContractCase, tmp_path: Path
) -> None:
    if case.input.stdin != "forbidden":
        pytest.skip("Covered by the accepted-stdin process obligation.")
    completed, remaining = run_with_open_stdin(
        case.input.stdin_args, cwd=tmp_path, payload=case.input.payload
    )

    assert completed.returncode == 0, case.name
    assert completed.stderr == ""
    assert remaining == case.input.payload


@pytest.mark.integration
@pytest.mark.parametrize("case", CLI_CONTRACT_CASES, ids=case_id)
def test_stdin_accepting_commands_use_the_declared_marker_at_the_process_seam(
    case: CliContractCase, tmp_path: Path
) -> None:
    if case.input.stdin == "forbidden":
        pytest.skip("Dormant until a command explicitly accepts stdin.")
    completed = subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0004
        [sys.executable, "-m", "{{ package }}", *case.input.stdin_args],
        cwd=tmp_path,
        input=case.input.payload.decode(),
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )

    assert case.input.stdin_marker in case.input.stdin_args
    assert completed.returncode == 0
    assert completed.stderr == ""
    observed = completed.stdout
    if case.input.stdin_readback_args:
        readback = subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0004
            [sys.executable, "-m", "{{ package }}", *case.input.stdin_readback_args],
            cwd=tmp_path,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        assert readback.returncode == 0
        assert readback.stderr == ""
        observed += readback.stdout
    assert case.input.stdin_expected_value in observed


@pytest.mark.integration
@pytest.mark.parametrize("command", ["add", "capabilities", "list"])
def test_command_help_exposes_independent_argument_and_input_expectations(
    command: str, tmp_path: Path
) -> None:
    completed, _ = run_with_open_stdin((command, "--help"), cwd=tmp_path)
    help_text = " ".join(completed.stdout.split())
    expectations = dict(HELP_EXPECTATIONS)[command]
    entries = argument_help_entries(completed.stdout, expectations)

    assert completed.returncode == 0
    assert completed.stderr == ""
    assert "Primary input: arguments" in help_text
    assert "stdin: forbidden" in help_text
    assert set(entries) == {control for control, _facts in expectations}
    for control, facts in expectations:
        for fact in facts:
            assert fact in entries[control]
