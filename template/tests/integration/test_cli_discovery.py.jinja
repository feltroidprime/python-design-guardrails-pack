@pytest.mark.integration
def test_capabilities_publish_input_argument_and_query_contracts(tmp_path: Path) -> None:
    argument_specs = expected_arguments()
    query_specs = expected_query_controls()
    outcome_specs = expected_outcomes()
    completed = run_process(("capabilities", "--limit", "100"), cwd=tmp_path)
    data = mapping(document(completed.stdout)["data"])
    commands = object_list(data["commands"])

    assert completed.returncode == 0
    assert completed.stderr == ""
    assert data["protocol"] == {
        "schema_version": "1.0",
        "decisions": ["ADR-0002", "ADR-0004"],
    }
    assert {cast("str", command["name"]) for command in commands} == set(argument_specs)
    for command in commands:
        name = cast("str", command["name"])
        assert command["input"] == {
            "primary": "arguments",
            "stdin": "forbidden",
            "stdin_marker": "",
        }
        assert command["safety"] == {"kind": "non-destructive"}
        arguments = {
            cast("str", argument["name"]): argument
            for argument in object_list(command["arguments"])
        }
        assert set(arguments) == set(argument_specs[name])
        for argument_name, expected in argument_specs[name].items():
            value_type, required, default, choices, repeatable = expected
            assert arguments[argument_name] == {
                "name": argument_name,
                "value_type": value_type,
                "required": required,
                "default": default,
                "choices": list(choices),
                "repeatable": repeatable,
                "sensitive": argument_name == "--idempotency-key",
            }
        if name in query_specs:
            assert command["query"] == query_specs[name]
        outcomes = {
            cast("str", outcome["code"]): outcome for outcome in object_list(command["outcomes"])
        }
        assert set(outcomes) == set(outcome_specs[name])
        for code, (exit_status, retryable, detail_keys) in outcome_specs[name].items():
            outcome = outcomes[code]
            assert outcome["exit_status"] == exit_status
            assert outcome["retryable"] is retryable
            assert outcome["detail_keys"] == list(detail_keys)
            assert isinstance(outcome["hint"], str)
            assert outcome["hint"]


@pytest.mark.integration
def test_capability_filters_precede_bounds_and_quiet_projects_one_field(tmp_path: Path) -> None:
    first = run_process(
        ("capabilities", "--kind", "query", "--limit", "1", "--field", "name", "-q"),
        cwd=tmp_path,
    )
    page = document(
        run_process(
            ("capabilities", "--kind", "query", "--limit", "1", "--field", "name"),
            cwd=tmp_path,
        ).stdout
    )
    metadata = mapping(page["metadata"])
    continuation = metadata["continuation"]
    assert isinstance(continuation, str)
    second = run_process(
        (
            "capabilities",
            "--kind",
            "query",
            "--limit",
            "1",
            "--field",
            "name",
            "--continuation",
            continuation,
            "--quiet",
        ),
        cwd=tmp_path,
    )

    assert first.returncode == 0
    assert first.stdout == "capabilities\n"
    assert first.stderr == ""
    assert metadata["truncated"] is True
    assert second.returncode == 0
    assert second.stdout == "list\n"
    assert second.stderr == ""


@pytest.mark.integration
def test_capability_continuation_rejects_changed_filter_or_selection(tmp_path: Path) -> None:
    first = document(
        run_process(
            (
                "capabilities",
                "--name-contains",
                "i",
                "--limit",
                "1",
                "--field",
                "name",
            ),
            cwd=tmp_path,
        ).stdout
    )
    continuation = mapping(first["metadata"])["continuation"]
    assert isinstance(continuation, str)

    incompatible = run_process(
        (
            "capabilities",
            "--name-contains",
            "add",
            "--limit",
            "1",
            "--field",
            "kind",
            "--continuation",
            continuation,
        ),
        cwd=tmp_path,
    )
    error = mapping(document(incompatible.stderr)["error"])

    assert incompatible.returncode == 3
    assert incompatible.stdout == ""
    assert error["code"] == "invalid_continuation"


@pytest.mark.integration
def test_active_capability_catalog_overlays_a_legacy_command_after_regeneration(
    tmp_path: Path,
) -> None:
    source_root = generated_catalog_repository(tmp_path)

    completed = run_process(
        ("capabilities", "--limit", "100"),
        cwd=tmp_path,
        source_root=source_root,
    )

    assert completed.returncode == 0, completed.stderr
    assert completed.stderr == ""
    commands = object_list(mapping(document(completed.stdout)["data"])["commands"])
    assert [command["name"] for command in commands] == ["add", "capabilities", "list"]
    commands_by_name = {command["name"]: command for command in commands}
    assert commands_by_name["add"]["purpose"] == "Generated alpha add command."

    added = run_process(
        ("add", "Alpha item"),
        cwd=tmp_path,
        source_root=source_root,
    )
    assert added.returncode == 0, added.stderr
    assert added.stderr == ""


@pytest.mark.integration
def test_product_catalog_consumes_the_derived_index_without_runtime_discovery() -> None:
    source = (
        project_root() / "src" / "{{ package }}" / "adapters" / "inbound" / "cli_catalog.py"
    ).read_text(encoding="utf-8")

    assert "from {{ package }}._generated.cli_catalog import CLI_CATALOGS" in source
    assert "importlib" not in source
    assert "pkgutil" not in source
