"""Process-level discovery contract independent of the command catalog."""

import json
import os
from pathlib import Path
from shutil import copytree
import subprocess
import sys
from typing import cast

import pytest

from repoctl.modules.repository_generation.api import (
    LocalRepository,
    RepositoryPathCandidate,
    generate,
)


def run_process(
    args: tuple[str, ...],
    *,
    cwd: Path,
    source_root: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    environment = (
        {**os.environ, "PYTHONPATH": str(source_root)} if source_root is not None else None
    )
    return subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0002
        [sys.executable, "-m", "{{ package }}", *args],
        cwd=cwd,
        env=environment,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )


def mapping(value: object) -> dict[str, object]:
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def document(raw: str) -> dict[str, object]:
    return mapping(cast("object", json.loads(raw)))


def object_list(value: object) -> list[dict[str, object]]:
    assert isinstance(value, list)
    return [mapping(item) for item in cast("list[object]", value)]


def project_root() -> Path:
    return Path(__file__).resolve().parents[2]


def active_catalog_source() -> str:
    return """from {{ package }}.adapters.inbound.cli_contract import (
    CommandKind,
    CommandName,
    CommandSpec,
    FlagOption,
    InputMode,
    InputPolicy,
    MutationPolicy,
    NonDestructiveSafety,
    OutputMode,
    OutputOption,
    PositionalText,
    RetryPolicy,
    StdinMode,
    TextOption,
)
from {{ package }}.adapters.inbound.cli_outcomes import ADD_OUTCOMES


COMMANDS = (
    CommandSpec(
        name=CommandName.ADD,
        kind=CommandKind.MUTATION,
        purpose="Generated alpha add command.",
        automation_example='python -m {{ package }} add "Alpha item"',
        output_modes=(OutputMode.JSON, OutputMode.HUMAN),
        default_output_mode=OutputMode.JSON,
        policy=MutationPolicy(
            retry=RetryPolicy.CONDITIONAL,
            retry_control="--idempotency-key",
            unsafe_without_control=True,
        ),
        input_policy=InputPolicy(primary=InputMode.ARGUMENTS, stdin=StdinMode.FORBIDDEN),
        safety=NonDestructiveSafety(),
        outcomes=ADD_OUTCOMES,
        arguments=(
            PositionalText(name="name", help="item name"),
            TextOption(
                flag="--idempotency-key",
                destination="idempotency_key",
                help="make retries safe for the same normalized request",
                default="",
                sensitive=True,
            ),
            OutputOption(),
            FlagOption(
                flag="--debug",
                destination="debug",
                help="show a traceback for unexpected failures",
            ),
        ),
    ),
)
"""


def active_declaration() -> str:
    return """schema_version = 1
name = "alpha"
python_module = "{{ package }}.modules.alpha"
status = "active"
proof_catalog = "proof/modules/alpha.toml"

[boundaries]
inbound = ["cli"]
outbound = []

[activation]
api = "{{ package }}.modules.alpha.api"
factory = ""
cli_catalog = "{{ package }}.modules.alpha.adapters.inbound.cli_catalog:COMMANDS"
"""


def generated_catalog_repository(tmp_path: Path) -> Path:
    root = project_root()
    source_root = tmp_path / "src"
    package_root = source_root / "{{ package }}"
    _ = copytree(root / "src" / "{{ package }}", package_root)
    _ = copytree(root / ".repo", tmp_path / ".repo")
    catalog_path = package_root / "modules" / "alpha" / "adapters" / "inbound" / "cli_catalog.py"
    catalog_path.parent.mkdir(parents=True)
    _ = catalog_path.write_text(active_catalog_source(), encoding="utf-8")

    repository = LocalRepository(root=tmp_path, package="{{ package }}")
    repository.write_if_matches(
        RepositoryPathCandidate(value=".repo/capabilities/alpha.toml"),
        active_declaration().encode("utf-8"),
        expected_digest="absent",
    )
    _ = generate(repository.snapshot(), repository)
    return source_root


