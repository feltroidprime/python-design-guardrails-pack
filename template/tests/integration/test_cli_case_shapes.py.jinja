"""Construction checks for independent command behavior cases."""

from dataclasses import replace

import pytest

from tests.contract.cli_contract_cases import (
    CLI_CONTRACT_CASES,
    QueryContractCase,
    StreamingContractCase,
)

QUERY_CASE = next(case for case in CLI_CONTRACT_CASES if isinstance(case, QueryContractCase))


@pytest.mark.integration
def test_query_case_shape_requires_a_real_over_default_page() -> None:
    with pytest.raises(ValueError, match="more than the default page"):
        _ = replace(QUERY_CASE, expected_count=QUERY_CASE.default_limit)


@pytest.mark.integration
def test_invalid_case_shape_requires_an_independent_readback() -> None:
    with pytest.raises(ValueError, match="observable CLI readback"):
        _ = replace(QUERY_CASE, invalid_readback_args=())


@pytest.mark.integration
def test_input_case_rejects_inline_json_as_the_only_success_fixture() -> None:
    with pytest.raises(ValueError, match="ordinary-argument success"):
        _ = replace(
            CLI_CONTRACT_CASES[0].input,
            ordinary_args=(),
            structured_args=(("add", "--input-json", '{"name":"hidden"}'),),
        )


@pytest.mark.integration
def test_accepted_stdin_case_requires_payload_derived_semantics() -> None:
    with pytest.raises(ValueError, match="payload-derived expected value"):
        _ = replace(
            CLI_CONTRACT_CASES[0].input,
            stdin="optional",
            stdin_marker="-",
            stdin_args=("add", "-"),
        )


def streaming_case() -> StreamingContractCase:
    return StreamingContractCase(
        name="tail",
        purpose="Stream records.",
        success_args=("tail",),
        invalid_args=("tail", "--unknown"),
        invalid_readback_args=("capabilities",),
        invalid_exit_code=2,
        invalid_error_code="invalid_syntax",
        human_args=("tail", "--format", "human"),
        help_tokens=("--status", "--limit"),
        machine_format="jsonl",
        baseline_args=("tail",),
        filter_args=("tail", "--status", "error"),
        filter_key="status",
        filter_value="error",
        termination_args=("tail", "--limit", "1"),
        termination_maximum=1,
        declared_filters=("--status",),
        termination_controls=("--limit",),
        input=CLI_CONTRACT_CASES[0].input,
    )


@pytest.mark.integration
def test_streaming_case_shape_isolates_filter_and_termination_controls() -> None:
    with pytest.raises(ValueError, match="must not mix"):
        _ = replace(
            streaming_case(),
            filter_args=("tail", "--status", "error", "--limit", "1"),
        )


@pytest.mark.integration
def test_streaming_case_shape_requires_json_lines() -> None:
    with pytest.raises(ValueError, match="JSON Lines"):
        _ = replace(streaming_case(), machine_format="json")
