@pytest.mark.integration
def test_capabilities_match_the_public_schema_and_independent_cases(tmp_path: Path) -> None:
    completed = run_process(("capabilities", "--limit", "100"), cwd=tmp_path)
    commands = object_list(mapping(document(completed.stdout)["data"])["commands"])
    cases_by_name = {case.name: case for case in CLI_CONTRACT_CASES}

    assert {command["name"] for command in commands} == set(cases_by_name)
    for command in commands:
        case = cases_by_name[cast("str", command["name"])]
        assert command["kind"] == case.kind
        assert command["purpose"] == case.purpose
        assert isinstance(command["automation_example"], str)
        modes = command["output_modes"]
        assert isinstance(modes, list)
        expected_modes = {case.machine_format, "human"}
        if isinstance(case, QueryContractCase) and case.quiet:
            expected_modes.add("quiet")
        assert set(cast("list[str]", modes)) == expected_modes
        assert command["default_output_mode"] == case.machine_format
        _assert_capability_policy(command, case)


def _assert_capability_policy(command: dict[str, object], case: CliContractCase) -> None:
    if isinstance(case, QueryContractCase):
        bounds = mapping(command["bounds"])
        assert bounds == {
            "default_limit": case.default_limit,
            "maximum_limit": case.maximum_limit,
            "stable_order": case.stable_order,
            "continuation": True,
        }
        query = mapping(command["query"])
        assert query["quiet"] is case.quiet
    elif isinstance(case, MutationContractCase):
        mutation = mapping(command["mutation"])
        assert mutation == {
            "retry": case.retry_policy,
            "retry_control": case.retry_control,
            "unsafe_without_control": case.unsafe_without_control,
        }
    elif isinstance(case, StreamingContractCase):
        streaming = mapping(command["streaming"])
        assert streaming["filters"] == list(case.declared_filters)
        assert streaming["termination_controls"] == list(case.termination_controls)
    elif isinstance(case, InteractiveContractCase):
        automation = mapping(command["automation"])
        assert automation["required_inputs"] == list(case.automation_inputs)
    else:
        bulk = mapping(command["bulk"])
        assert bulk["required_scope"] == list(case.required_scope)
        assert bulk["destination_required"] is case.destination_required


@pytest.mark.integration
def test_help_discovers_every_independent_case(tmp_path: Path) -> None:
    root = run_process(("--help",), cwd=tmp_path)
    assert root.returncode == 0
    assert root.stderr == ""
    for case in CLI_CONTRACT_CASES:
        assert case.name in root.stdout
        assert case.purpose in root.stdout
        command = run_process((case.name, "--help"), cwd=tmp_path)
        assert command.returncode == 0
        assert command.stderr == ""
        assert case.purpose in command.stdout
        assert "Automation example:" in command.stdout
        for token in case.help_tokens:
            assert token in command.stdout


@pytest.mark.integration
@pytest.mark.parametrize("case", STREAMING_CASES, ids=case_id)
def test_streaming_cases_prove_filtering_and_termination(
    case: StreamingContractCase, tmp_path: Path
) -> None:
    baseline = run_process(case.baseline_args, cwd=tmp_path)
    baseline_data = [mapping(item["data"]) for item in machine_documents(baseline.stdout, case)]
    filtered = run_process(case.filter_args, cwd=tmp_path)
    filtered_data = [mapping(item["data"]) for item in machine_documents(filtered.stdout, case)]
    terminated = run_process(case.termination_args, cwd=tmp_path)
    terminated_data = machine_documents(terminated.stdout, case)

    assert baseline.returncode == 0
    assert len(baseline_data) > case.termination_maximum
    assert any(item[case.filter_key] != case.filter_value for item in baseline_data)
    assert filtered.returncode == 0
    assert filtered_data
    assert all(item[case.filter_key] == case.filter_value for item in filtered_data)
    assert len(filtered_data) < len(baseline_data)
    assert terminated.returncode == 0
    assert len(terminated_data) <= case.termination_maximum
    assert len(terminated_data) < len(baseline_data)


