"""Exhaustive agent-native CLI contract at the real process seam."""

from contextlib import closing
import json
import sqlite3
import subprocess
import sys
from typing import TYPE_CHECKING, cast

import pytest

from {{ package }}.adapters.inbound.cli_catalog import COMMAND_CATALOG
from {{ package }}.adapters.inbound.cli_contract import QueryPolicy
from tests.contract.cli_contract_cases import (
    CLI_CONTRACT_CASES,
    BulkContractCase,
    CliContractCase,
    InteractiveContractCase,
    MutationContractCase,
    QueryContractCase,
    StreamingContractCase,
)

if TYPE_CHECKING:
    from pathlib import Path

ANSI_ESCAPE = "\x1b["
QUERY_CASES = tuple(case for case in CLI_CONTRACT_CASES if isinstance(case, QueryContractCase))
MUTATION_CASES = tuple(
    case for case in CLI_CONTRACT_CASES if isinstance(case, MutationContractCase)
)
STREAMING_CASES = tuple(
    case for case in CLI_CONTRACT_CASES if isinstance(case, StreamingContractCase)
)
INTERACTIVE_CASES = tuple(
    case for case in CLI_CONTRACT_CASES if isinstance(case, InteractiveContractCase)
)
BULK_CASES = tuple(case for case in CLI_CONTRACT_CASES if isinstance(case, BulkContractCase))
SUPPORTED_CASE_TYPES = (
    QueryContractCase,
    MutationContractCase,
    StreamingContractCase,
    InteractiveContractCase,
    BulkContractCase,
)


def run_process(args: tuple[str, ...], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    """Invoke the installed module without a terminal or readable stdin."""
    return subprocess.run(  # noqa: S603  # ARCH-EXCEPTION: ADR-0003
        [sys.executable, "-m", "{{ package }}", *args],
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )


def mapping(value: object) -> dict[str, object]:
    assert isinstance(value, dict)
    return cast("dict[str, object]", value)


def object_list(value: object) -> list[dict[str, object]]:
    assert isinstance(value, list)
    items = cast("list[object]", value)
    return [mapping(item) for item in items]


def document(raw: str) -> dict[str, object]:
    return mapping(cast("object", json.loads(raw)))


def machine_documents(raw: str, case: CliContractCase) -> list[dict[str, object]]:
    if case.machine_format == "jsonl":
        return [document(line) for line in raw.splitlines()]
    return [document(raw)]


def seed(case: QueryContractCase, *, cwd: Path) -> None:
    for args in case.seed_args:
        completed = run_process(args, cwd=cwd)
        assert completed.returncode == 0


def seed_item_rows(rows: tuple[tuple[str, str], ...], *, cwd: Path) -> None:
    assert run_process(("list",), cwd=cwd).returncode == 0
    with closing(sqlite3.connect(cwd / "items.db")) as connection, connection:
        _ = connection.executemany(
            "INSERT INTO items (item_id, name) VALUES (?, ?)",
            rows,
        )


def collection(result: dict[str, object], case: QueryContractCase) -> list[dict[str, object]]:
    return object_list(mapping(result["data"])[case.collection_key])


def metadata(result: dict[str, object]) -> dict[str, object]:
    return mapping(result["metadata"])


def case_id(case: CliContractCase) -> str:
    return case.name


@pytest.mark.integration
def test_catalog_and_contract_cases_are_exactly_complete() -> None:
    catalog_names = [spec.name.value for spec in COMMAND_CATALOG]
    case_names = [case.name for case in CLI_CONTRACT_CASES]

    assert len(catalog_names) == len(set(catalog_names))
    assert len(case_names) == len(set(case_names))
    assert set(catalog_names) == set(case_names)
    cases = {case.name: case for case in CLI_CONTRACT_CASES}
    for spec in COMMAND_CATALOG:
        case = cases[spec.name.value]
        assert spec.input_policy.primary.value == case.input.primary
        assert spec.input_policy.stdin.value == case.input.stdin
        assert spec.input_policy.stdin_marker == case.input.stdin_marker
        if isinstance(case, QueryContractCase):
            assert isinstance(spec.policy, QueryPolicy)
            assert spec.policy.filters == case.declared_filters
            assert spec.policy.selectable_fields == case.selectable_fields
            assert spec.policy.quiet is case.quiet


@pytest.mark.integration
@pytest.mark.parametrize("case", CLI_CONTRACT_CASES, ids=case_id)
def test_every_command_succeeds_as_machine_json_with_detached_stdin(
    case: CliContractCase, tmp_path: Path
) -> None:
    assert isinstance(case, SUPPORTED_CASE_TYPES)
    if isinstance(case, QueryContractCase):
        seed(case, cwd=tmp_path)

    completed = run_process(case.success_args, cwd=tmp_path)
    results = machine_documents(completed.stdout, case)

    assert completed.returncode == 0
    assert completed.stderr == ""
    assert results
    for result in results:
        assert result["schema_version"] == "1.0"
        assert result["command"] == case.name
        assert isinstance(result["data"], dict)
        assert isinstance(result["metadata"], dict)
    assert ANSI_ESCAPE not in completed.stdout


@pytest.mark.integration
@pytest.mark.parametrize("case", CLI_CONTRACT_CASES, ids=case_id)
def test_every_command_has_actionable_machine_failure(
    case: CliContractCase, tmp_path: Path
) -> None:
    assert isinstance(case, SUPPORTED_CASE_TYPES)
    before = mapping(document(run_process(case.invalid_readback_args, cwd=tmp_path).stdout)["data"])
    destination = (
        tmp_path / case.invalid_destination_path if isinstance(case, BulkContractCase) else None
    )
    if destination is not None:
        assert not destination.exists()
    completed = run_process(case.invalid_args, cwd=tmp_path)
    result = document(completed.stderr)
    error = mapping(result["error"])
    after = mapping(document(run_process(case.invalid_readback_args, cwd=tmp_path).stdout)["data"])

    assert completed.returncode == case.invalid_exit_code
    assert completed.stdout == ""
    assert result["schema_version"] == "1.0"
    assert result["command"] == case.name
    assert isinstance(error["code"], str)
    assert error["code"] == case.invalid_error_code
    assert isinstance(error["message"], str)
    assert isinstance(error["retryable"], bool)
    assert isinstance(error["hint"], str)
    assert error["hint"]
    assert "Traceback" not in completed.stderr
    assert ANSI_ESCAPE not in completed.stderr
    assert after == before
    if destination is not None:
        assert not destination.exists()


@pytest.mark.integration
@pytest.mark.parametrize("case", QUERY_CASES, ids=case_id)
def test_query_cases_prove_default_bounds_and_continuation(
    case: QueryContractCase, tmp_path: Path
) -> None:
    seed(case, cwd=tmp_path)
    too_large = run_process(
        (*case.success_args, "--limit", str(case.maximum_limit + 1)), cwd=tmp_path
    )
    first = document(run_process(case.success_args, cwd=tmp_path).stdout)
    first_values = collection(first, case)
    first_metadata = metadata(first)

    assert too_large.returncode == 2
    assert too_large.stdout == ""
    assert len(first_values) == case.default_limit
    assert first_metadata["truncated"] is True
    assert isinstance(first_metadata["continuation"], str)

    continuation = first_metadata["continuation"]
    assert isinstance(continuation, str)
    second_args = (*case.success_args, "--continuation", continuation)
    second = document(run_process(second_args, cwd=tmp_path).stdout)
    combined = [*first_values, *collection(second, case)]
    identities = [cast("str", value[case.identity_key]) for value in combined]

    assert len(combined) == case.expected_count
    assert len(identities) == len(set(identities))
    assert identities == sorted(identities)
    assert metadata(second) == {"truncated": False, "continuation": ""}


@pytest.mark.integration
@pytest.mark.parametrize("case", QUERY_CASES, ids=case_id)
def test_every_declared_query_filter_and_field_has_its_exact_behavior_case(
    case: QueryContractCase, tmp_path: Path
) -> None:
    seed(case, cwd=tmp_path)
    for filter_case in case.filter_cases:
        completed = run_process(filter_case.args, cwd=tmp_path)
        assert completed.returncode == 0
        assert completed.stderr == ""
        assert set(completed.stdout.splitlines()) == set(filter_case.expected_values)
    for field_case in case.field_cases:
        completed = run_process(field_case.args, cwd=tmp_path)
        rows = collection(document(completed.stdout), case)
        assert completed.returncode == 0
        assert completed.stderr == ""
        assert rows
        assert all(set(row) == {field_case.field} for row in rows)

    quiet = run_process(case.quiet_args, cwd=tmp_path)
    physical_lines = quiet.stdout.splitlines(keepends=True)
    assert quiet.returncode == 0
    assert quiet.stderr == ""
    assert all(line.endswith("\n") and "\r" not in line for line in physical_lines)
    assert set(quiet.stdout.splitlines()) == set(case.quiet_expected_values)


@pytest.mark.integration
def test_list_filters_before_pagination_and_quietly_projects_one_field(tmp_path: Path) -> None:
    seed_item_rows(
        (
            ("item-1", "Match one"),
            ("item-2", "Noise one"),
            ("item-3", "Match two"),
            ("item-4", "Noise two"),
            ("item-5", "Match three"),
        ),
        cwd=tmp_path,
    )

    first = run_process(
        (
            "list",
            "--name-contains",
            "Match",
            "--limit",
            "2",
            "--field",
            "name",
            "--quiet",
        ),
        cwd=tmp_path,
    )

    assert first.returncode == 0
    assert first.stdout == "Match one\nMatch two\n"
    assert first.stderr == ""
    assert ANSI_ESCAPE not in first.stdout

    page = document(
        run_process(
            ("list", "--name-contains", "Match", "--limit", "2", "--field", "name"),
            cwd=tmp_path,
        ).stdout
    )
    continuation = metadata(page)["continuation"]
    assert isinstance(continuation, str)

    second = run_process(
        (
            "list",
            "--name-contains",
            "Match",
            "--limit",
            "2",
            "--field",
            "name",
            "--continuation",
            continuation,
            "-q",
        ),
        cwd=tmp_path,
    )

    assert second.returncode == 0
    assert second.stdout == "Match three\n"
    assert second.stderr == ""


@pytest.mark.integration
def test_list_rejects_a_continuation_from_different_selection_state(tmp_path: Path) -> None:
    seed_item_rows((("item-1", "Match one"), ("item-2", "Match two")), cwd=tmp_path)

    first = document(
        run_process(
            ("list", "--name-contains", "Match", "--limit", "1", "--field", "name"),
            cwd=tmp_path,
        ).stdout
    )
    continuation = metadata(first)["continuation"]
    assert isinstance(continuation, str)

    incompatible = run_process(
        (
            "list",
            "--name-contains",
            "Different",
            "--limit",
            "1",
            "--field",
            "name",
            "--continuation",
            continuation,
        ),
        cwd=tmp_path,
    )
    error = mapping(document(incompatible.stderr)["error"])

    assert incompatible.returncode == 3
    assert incompatible.stdout == ""
    assert error["code"] == "invalid_continuation"
    assert error["retryable"] is False
    assert "--continuation" in cast("str", error["hint"])


@pytest.mark.integration
@pytest.mark.parametrize("case", MUTATION_CASES, ids=case_id)
def test_mutation_cases_prove_declared_replay_behavior(
    case: MutationContractCase, tmp_path: Path
) -> None:
    first = document(run_process(case.success_args, cwd=tmp_path).stdout)
    second = document(run_process(case.success_args, cwd=tmp_path).stdout)
    first_metadata = metadata(first)
    second_metadata = metadata(second)

    retry_safe = case.retry_policy != "unsafe"
    assert first_metadata["retry_safe"] is retry_safe
    assert second_metadata["retry_safe"] is retry_safe
    if not retry_safe:
        assert first_metadata["operation_id"] != second_metadata["operation_id"]
    else:
        assert first_metadata["operation_id"] == second_metadata["operation_id"]

    readback = document(run_process(case.readback_args, cwd=tmp_path).stdout)
    values = object_list(mapping(readback["data"])[case.readback_collection_key])
    assert len(values) == case.expected_after_replay


