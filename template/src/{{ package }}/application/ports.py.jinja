"""Capabilities required by application use cases.

Two port shapes, chosen by surface area: a single-operation capability is a
callable ``type`` alias; a multi-operation boundary is a ``Protocol``.
"""

from collections.abc import Callable
from typing import TYPE_CHECKING, Protocol

from {{ package }}.application.query_models import DEFAULT_ITEM_FIELDS

if TYPE_CHECKING:
    from datetime import datetime

    from {{ package }}.application.idempotency import (
        IdempotencyKey,
        IdempotentCreateResult,
        ItemFactory,
        RequestFingerprint,
    )
    from {{ package }}.application.query_models import ItemField, ItemProjection, PageStart
    from {{ package }}.domain.entities import Item
    from {{ package }}.domain.events import DomainEvent
    from {{ package }}.domain.value_objects import ItemId


class ItemRepository(Protocol):
    """Persistence boundary for the Item aggregate."""

    def get(self, item_id: ItemId) -> Item | None:
        """Return an item when it exists."""
        ...

    def save(self, item: Item) -> None:
        """Persist the current aggregate state."""
        ...

    def create_once(
        self,
        *,
        key: IdempotencyKey,
        fingerprint: RequestFingerprint,
        create: ItemFactory,
    ) -> IdempotentCreateResult:
        """Atomically commit one item and its conditional-replay record."""
        ...

    def list_page(
        self,
        *,
        start: PageStart,
        limit: int,
        name_contains: str = "",
        fields: tuple[ItemField, ...] = DEFAULT_ITEM_FIELDS,
    ) -> tuple[ItemProjection, ...]:
        """Return at most ``limit`` items in stable identifier order."""
        ...


class EventPublisher(Protocol):
    """Delivery boundary for already-happened domain facts."""

    def publish(self, event: DomainEvent) -> None:
        """Hand one event to every independent consumer."""
        ...


type Clock = Callable[[], datetime]
type ItemIdFactory = Callable[[], ItemId]
