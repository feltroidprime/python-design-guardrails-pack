"""Pure reference predicates for application-level protocols."""

from dataclasses import dataclass


@dataclass(frozen=True, slots=True, kw_only=True)
class CreateItemReplayObservation:
    """Primitive facts observed around one conditional create attempt."""

    prior_key_exists: bool
    same_request: bool
    raised_conflict: bool
    replayed: bool
    same_item: bool
    effects_before: int
    effects_after: int


def _new_create_is_safe(observation: CreateItemReplayObservation) -> bool:
    return (
        not observation.raised_conflict
        and not observation.replayed
        and observation.effects_after == observation.effects_before + 1
    )


def _identical_replay_is_safe(observation: CreateItemReplayObservation) -> bool:
    return (
        not observation.raised_conflict
        and observation.replayed
        and observation.same_item
        and observation.effects_after == observation.effects_before
    )


def _conflicting_replay_is_safe(observation: CreateItemReplayObservation) -> bool:
    return (
        observation.raised_conflict
        and not observation.replayed
        and not observation.same_item
        and observation.effects_after == observation.effects_before
    )


def create_item_replay_is_safe(observation: CreateItemReplayObservation) -> bool:
    """Reference model for one observation of conditional create replay."""
    if not observation.prior_key_exists:
        return _new_create_is_safe(observation)
    if observation.same_request:
        return _identical_replay_is_safe(observation)
    return _conflicting_replay_is_safe(observation)
