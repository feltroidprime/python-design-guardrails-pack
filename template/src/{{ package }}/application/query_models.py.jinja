"""Typed bounded-query requests and results shared across application ports."""

from dataclasses import dataclass
from enum import StrEnum
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from {{ package }}.domain.value_objects import ItemId


@dataclass(frozen=True, slots=True, kw_only=True)
class FirstPage:
    """Start a bounded query at the first item."""


@dataclass(frozen=True, slots=True, kw_only=True)
class AfterItem:
    """Continue a bounded query after a stable item identifier."""

    item_id: ItemId


@dataclass(frozen=True, slots=True, kw_only=True)
class NoMoreItems:
    """Mark a complete page sequence without a wire-format sentinel."""


type PageStart = FirstPage | AfterItem
type PageContinuation = AfterItem | NoMoreItems


class ItemField(StrEnum):
    """Closed public fields selectable from the item query."""

    ID = "id"
    NAME = "name"


DEFAULT_ITEM_FIELDS = (ItemField.ID, ItemField.NAME)


@dataclass(frozen=True, slots=True, kw_only=True)
class ItemFieldValue:
    """One selected item value with its public wire name."""

    field: ItemField
    value: str


@dataclass(frozen=True, slots=True, kw_only=True)
class ItemProjection:
    """Selected values plus the stable position needed for continuation."""

    position: ItemId
    values: tuple[ItemFieldValue, ...]

    @property
    def item_id(self) -> ItemId:
        """Expose the stable query position without requiring it in selected output."""
        return self.position

    def __post_init__(self) -> None:
        fields = tuple(value.field for value in self.values)
        if not fields or len(fields) != len(set(fields)):
            raise ValueError("Item projections require unique selected fields.")


@dataclass(frozen=True, slots=True, kw_only=True)
class ListItemsQuery:
    """Bounded item-list request received from an inbound adapter."""

    limit: int
    start: PageStart
    name_contains: str = ""
    fields: tuple[ItemField, ...] = DEFAULT_ITEM_FIELDS

    def __post_init__(self) -> None:
        if self.limit < 1:
            raise ValueError("List limit must be positive.")
        if not self.fields or len(self.fields) != len(set(self.fields)):
            raise ValueError("List fields must be a non-empty unique selection.")


@dataclass(frozen=True, slots=True, kw_only=True)
class ItemPage:
    """One bounded, stable page returned to an inbound adapter."""

    items: tuple[ItemProjection, ...]
    truncated: bool
    continuation: PageContinuation
