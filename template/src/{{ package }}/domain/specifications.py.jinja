"""Pure predicates: the executable, implementation-independent domain specification."""

from datetime import datetime

MAX_ITEM_NAME_LENGTH = 80


def item_id_text_is_valid(value: str) -> bool:
    """Whether text can represent an ItemId without hidden line structure."""
    return bool(value.strip()) and not any(character in value for character in "\r\n")


def item_name_input_is_valid(raw: str) -> bool:
    """Whether raw text can be normalized into a valid ItemName."""
    normalized = raw.strip()
    return (
        bool(normalized)
        and len(normalized) <= MAX_ITEM_NAME_LENGTH
        and not any(character in normalized for character in "\r\n")
    )


def item_name_text_is_canonical(value: str) -> bool:
    """Whether stored item-name text is both valid and already normalized."""
    return value == value.strip() and item_name_input_is_valid(value)


def item_state_is_valid(item_id_value: str, name_value: str) -> bool:
    """Whether primitive fields form a valid Item state."""
    return item_id_text_is_valid(item_id_value) and item_name_text_is_canonical(name_value)


def item_created_event_state_is_valid(
    item_id_value: str,
    name_value: str,
    occurred_at: object,
) -> bool:
    """Whether primitive fields form a valid created-item fact."""
    return item_state_is_valid(item_id_value, name_value) and isinstance(occurred_at, datetime)


def created_item_matches_inputs(
    item_id_value: str,
    name_value: str,
    result_item_id_value: str,
    result_name_value: str,
) -> bool:
    """Reference relation for the pure create-item decision."""
    return (
        item_state_is_valid(result_item_id_value, result_name_value)
        and result_item_id_value == item_id_value
        and result_name_value == name_value
    )


def renamed_item_preserves_identity(
    source_item_id_value: str,
    source_name_value: str,
    requested_name_value: str,
    result_item_id_value: str,
    result_name_value: str,
) -> bool:
    """Reference relation for an immutable rename transition."""
    return (
        item_state_is_valid(source_item_id_value, source_name_value)
        and item_state_is_valid(result_item_id_value, result_name_value)
        and result_item_id_value == source_item_id_value
        and result_name_value == requested_name_value
    )


def created_event_matches_item(
    item_id_value: str,
    name_value: str,
    occurred_at: datetime,
    event_item_id_value: str,
    event_name_value: str,
    event_occurred_at: datetime,
) -> bool:
    """Reference relation for creating an event from an Item and explicit time."""
    return (
        item_created_event_state_is_valid(
            event_item_id_value,
            event_name_value,
            event_occurred_at,
        )
        and event_item_id_value == item_id_value
        and event_name_value == name_value
        and event_occurred_at == occurred_at
    )
