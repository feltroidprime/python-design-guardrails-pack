"""Immutable domain entities; state changes are explicit pure transitions."""

from dataclasses import dataclass, fields
from typing import cast, override

import icontract

from {{ package }}.domain.specifications import item_state_is_valid
from {{ package }}.domain.value_objects import ItemId, ItemName


def _item_state_holds(self: object) -> bool:
    """Class invariant condition; `icontract` supplies the decorated instance."""
    item = cast("Item", self)
    return item_state_is_valid(item.item_id.value, item.name.value)


@icontract.invariant(
    _item_state_holds,
    description="PROPERTY[ITEM-STATE-VALID]: every Item contains validated values",
)
@dataclass(frozen=True, slots=True, kw_only=True)
class Item:
    """Example aggregate state."""

    item_id: ItemId
    name: ItemName

    @override
    def __getstate__(self) -> list[object]:
        """Stay copyable while a field is still unset, which symbolic execution requires."""
        return [getattr(self, field.name, None) for field in fields(self)]

    def __setstate__(self, state: list[object]) -> None:
        """Rebuild a pickled instance so invariant decoration keeps a named hook."""
        for field, value in zip(fields(self), state, strict=True):
            object.__setattr__(self, field.name, value)
