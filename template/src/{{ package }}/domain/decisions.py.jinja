"""Pure domain decisions: explicit validated inputs in, immutable facts out."""

from datetime import datetime

import icontract

from {{ package }}.domain.entities import Item
from {{ package }}.domain.events import ItemCreatedEvent
from {{ package }}.domain.specifications import (
    created_event_matches_item,
    created_item_matches_inputs,
    renamed_item_preserves_identity,
)
from {{ package }}.domain.value_objects import ItemId, ItemName


@icontract.ensure(
    lambda item_id, name, result: created_item_matches_inputs(
        item_id.value,
        name.value,
        result.item_id.value,
        result.name.value,
    ),
    description=(
        "PROPERTY[CREATE-ITEM-PRESERVES-FACTS]: result exactly preserves explicit inputs"
    ),
)
def create_item(*, item_id: ItemId, name: ItemName) -> Item:
    """Construct an Item from explicit validated facts."""
    return Item(item_id=item_id, name=name)


@icontract.ensure(
    lambda item, new_name, result: renamed_item_preserves_identity(
        item.item_id.value,
        item.name.value,
        new_name.value,
        result.item_id.value,
        result.name.value,
    ),
    description=(
        "PROPERTY[RENAME-ITEM-PRESERVES-IDENTITY]: rename is immutable and keeps identity"
    ),
)
def rename_item(item: Item, new_name: ItemName) -> Item:
    """Return renamed aggregate state without mutating the source."""
    return Item(item_id=item.item_id, name=new_name)


@icontract.ensure(
    lambda item, occurred_at, result: created_event_matches_item(
        item.item_id.value,
        item.name.value,
        occurred_at,
        result.item_id.value,
        result.name.value,
        result.occurred_at,
    ),
    description=(
        "PROPERTY[ITEM-CREATED-EVENT-MIRRORS-ITEM]: event mirrors item and supplied time"
    ),
)
def item_created_event(*, item: Item, occurred_at: datetime) -> ItemCreatedEvent:
    """Create one immutable fact from an Item and an explicit clock value."""
    return ItemCreatedEvent(
        item_id=item.item_id,
        name=item.name,
        occurred_at=occurred_at,
    )
