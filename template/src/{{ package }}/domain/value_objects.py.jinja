"""Immutable domain values guarded by executable invariants."""

from dataclasses import dataclass

import icontract

from {{ package }}.domain.errors import InvalidItemNameError
from {{ package }}.domain.specifications import (
    MAX_ITEM_NAME_LENGTH,
    item_id_text_is_valid,
    item_name_input_is_valid,
    item_name_text_is_canonical,
)


@icontract.invariant(
    lambda self: item_id_text_is_valid(self.value),
    description="PROPERTY[ITEM-ID-VALID]: every constructed identifier is valid",
)
@dataclass(frozen=True, slots=True, kw_only=True)
class ItemId:
    """Stable item identifier."""

    value: str

    def __post_init__(self) -> None:
        if not self.value.strip():
            raise ValueError("Item identifier must not be blank.")
        if any(character in self.value for character in "\r\n"):
            raise ValueError("Item identifier must be a single line.")


@icontract.invariant(
    lambda self: item_name_text_is_canonical(self.value),
    description="PROPERTY[ITEM-NAME-CANONICAL]: every stored name is canonical",
)
@dataclass(frozen=True, slots=True, kw_only=True)
class ItemName:
    """Validated and canonical item name."""

    value: str

    def __post_init__(self) -> None:
        normalized = self.value.strip()
        if not item_name_input_is_valid(self.value):
            if not normalized:
                raise InvalidItemNameError("Item name must not be blank.")
            if len(normalized) > MAX_ITEM_NAME_LENGTH:
                raise InvalidItemNameError(
                    f"Item name must contain at most {MAX_ITEM_NAME_LENGTH} characters."
                )
            raise InvalidItemNameError("Item name must be a single line.")
        object.__setattr__(self, "value", normalized)
