"""In-memory repository for tests and local use."""

from threading import RLock
from typing import TYPE_CHECKING

from {{ package }}.application.errors import IdempotencyConflictError
from {{ package }}.application.idempotency import IdempotentCreateResult
from {{ package }}.application.query_models import (
    DEFAULT_ITEM_FIELDS,
    AfterItem,
    FirstPage,
    ItemField,
    ItemFieldValue,
    ItemProjection,
)

if TYPE_CHECKING:
    from {{ package }}.application.idempotency import (
        IdempotencyKey,
        ItemFactory,
        RequestFingerprint,
    )
    from {{ package }}.application.query_models import PageStart
    from {{ package }}.domain.entities import Item
    from {{ package }}.domain.value_objects import ItemId


class MemoryItemRepository:
    """Store aggregate references in process memory."""

    def __init__(self) -> None:
        self._items: dict[ItemId, Item] = {}
        self._idempotency: dict[str, tuple[str, ItemId]] = {}
        self._lock: RLock = RLock()

    def get(self, item_id: ItemId) -> Item | None:
        with self._lock:
            return self._items.get(item_id)

    def save(self, item: Item) -> None:
        with self._lock:
            self._items[item.item_id] = item

    def create_once(
        self,
        *,
        key: IdempotencyKey,
        fingerprint: RequestFingerprint,
        create: ItemFactory,
    ) -> IdempotentCreateResult:
        with self._lock:
            stored = self._idempotency.get(key.storage_value)
            if stored is not None:
                stored_fingerprint, item_id = stored
                if stored_fingerprint != fingerprint.value:
                    raise IdempotencyConflictError(
                        "The idempotency key was already used for a different request."
                    )
                item = self._items[item_id]
                return IdempotentCreateResult(item=item, replayed=True)
            staged_items = dict(self._items)
            staged_idempotency = dict(self._idempotency)
            item = create()
            staged_items[item.item_id] = item
            staged_idempotency[key.storage_value] = (fingerprint.value, item.item_id)
            self._items = staged_items
            self._idempotency = staged_idempotency
            return IdempotentCreateResult(item=item, replayed=False)

    def list_page(
        self,
        *,
        start: PageStart,
        limit: int,
        name_contains: str = "",
        fields: tuple[ItemField, ...] = DEFAULT_ITEM_FIELDS,
    ) -> tuple[ItemProjection, ...]:
        with self._lock:
            ordered = sorted(self._items.values(), key=lambda item: item.item_id.value)
            match start:
                case FirstPage():
                    eligible = ordered
                case AfterItem(item_id=item_id):
                    eligible = [item for item in ordered if item.item_id.value > item_id.value]
            filtered = [item for item in eligible if name_contains in item.name.value]
            return tuple(_project(item, fields) for item in filtered[:limit])


def _project(item: Item, fields: tuple[ItemField, ...]) -> ItemProjection:
    values = tuple(
        ItemFieldValue(
            field=field,
            value=item.item_id.value if field == ItemField.ID else item.name.value,
        )
        for field in fields
    )
    return ItemProjection(position=item.item_id, values=values)
