    from {{ package }}.application.query_models import PageStart

_CREATE_TABLE = """
CREATE TABLE IF NOT EXISTS items (
    item_id TEXT PRIMARY KEY,
    name TEXT NOT NULL
)
"""
_CREATE_IDEMPOTENCY_TABLE = """
CREATE TABLE IF NOT EXISTS item_idempotency (
    key_digest TEXT PRIMARY KEY,
    request_fingerprint TEXT NOT NULL,
    item_id TEXT
)
"""
_UPSERT = """
INSERT INTO items (item_id, name) VALUES (?, ?)
ON CONFLICT (item_id) DO UPDATE SET name = excluded.name
"""
_SELECT_ONE = "SELECT item_id, name FROM items WHERE item_id = ?"
_SELECT_IDEMPOTENCY = (
    "SELECT request_fingerprint, item_id FROM item_idempotency WHERE key_digest = ?"
)
_RESERVE_IDEMPOTENCY = (
    "INSERT INTO item_idempotency (key_digest, request_fingerprint, item_id) VALUES (?, ?, NULL)"
)
_COMPLETE_IDEMPOTENCY = "UPDATE item_idempotency SET item_id = ? WHERE key_digest = ?"
_PAGE_STATEMENTS = (
    ((False, False, False), "SELECT item_id FROM items ORDER BY item_id LIMIT ?"),
    (
        (False, False, True),
        ("SELECT item_id FROM items WHERE instr(name, ?) > 0 ORDER BY item_id LIMIT ?"),
    ),
    (
        (False, True, False),
        ("SELECT item_id FROM items WHERE item_id > ? ORDER BY item_id LIMIT ?"),
    ),
    (
        (False, True, True),
        (
            "SELECT item_id FROM items WHERE item_id > ? AND instr(name, ?) > 0 "
            "ORDER BY item_id LIMIT ?"
        ),
    ),
    ((True, False, False), "SELECT item_id, name FROM items ORDER BY item_id LIMIT ?"),
    (
        (True, False, True),
        ("SELECT item_id, name FROM items WHERE instr(name, ?) > 0 ORDER BY item_id LIMIT ?"),
    ),
    (
        (True, True, False),
        ("SELECT item_id, name FROM items WHERE item_id > ? ORDER BY item_id LIMIT ?"),
    ),
    (
        (True, True, True),
        (
            "SELECT item_id, name FROM items WHERE item_id > ? AND instr(name, ?) > 0 "
            "ORDER BY item_id LIMIT ?"
        ),
    ),
)


def _decode(row: object) -> Item:
    match row:
        case (str(raw_id), str(raw_name)):
            return Item(item_id=ItemId(value=raw_id), name=ItemName(value=raw_name))
        case _:
            raise RepositoryError(f"Unexpected items row shape: {row!r}")


def _fetch_row(cursor: sqlite3.Cursor) -> object | None:
    try:
        row = cast("object | None", cursor.fetchone())
    except sqlite3.Error as error:
        raise RepositoryError("Could not read the next items row.") from error
    return row


class SqliteItemRepository:
    """Store items in an injected SQLite connection."""

    def __init__(self, connection: sqlite3.Connection) -> None:
        self._connection: sqlite3.Connection = connection
        _ = self._execute(_CREATE_TABLE)
        _ = self._execute(_CREATE_IDEMPOTENCY_TABLE)

    def get(self, item_id: ItemId) -> Item | None:
        row = _fetch_row(self._execute(_SELECT_ONE, (item_id.value,)))
        return None if row is None else _decode(row)

    def save(self, item: Item) -> None:
        try:
            with self._connection:
                _ = self._connection.execute(_UPSERT, (item.item_id.value, item.name.value))
        except sqlite3.Error as error:
            raise RepositoryError(f"Could not save item '{item.item_id.value}'.") from error

    def create_once(
        self,
        *,
        key: IdempotencyKey,
        fingerprint: RequestFingerprint,
        create: ItemFactory,
    ) -> IdempotentCreateResult:
        try:
            with self._connection:
                _ = self._connection.execute("BEGIN IMMEDIATE")
                row = _fetch_row(
                    self._connection.execute(_SELECT_IDEMPOTENCY, (key.storage_value,))
                )
                if row is not None:
                    return self._replay(row, fingerprint=fingerprint)
                _ = self._connection.execute(
                    _RESERVE_IDEMPOTENCY, (key.storage_value, fingerprint.value)
                )
                item = create()
                _ = self._connection.execute(_UPSERT, (item.item_id.value, item.name.value))
                _ = self._connection.execute(
                    _COMPLETE_IDEMPOTENCY, (item.item_id.value, key.storage_value)
                )
        except sqlite3.Error as error:
            raise RepositoryError("Could not atomically create the idempotent item.") from error
        return IdempotentCreateResult(item=item, replayed=False)

    def _replay(self, row: object, *, fingerprint: RequestFingerprint) -> IdempotentCreateResult:
        match row:
            case (str(stored_fingerprint), str(raw_item_id)):
                if stored_fingerprint != fingerprint.value:
                    raise IdempotencyConflictError(
                        "The idempotency key was already used for a different request."
                    )
            case _:
                raise RepositoryError("The idempotency record is incomplete.")
        item = self.get(ItemId(value=raw_item_id))
        if item is None:
            raise RepositoryError("The idempotency record references a missing item.")
        return IdempotentCreateResult(item=item, replayed=True)

    def list_page(
        self,
        *,
        start: PageStart,
        limit: int,
        name_contains: str = "",
        fields: tuple[ItemField, ...] = DEFAULT_ITEM_FIELDS,
    ) -> tuple[ItemProjection, ...]:
        statement, parameters = _page_statement(
            start=start, limit=limit, name_contains=name_contains, fields=fields
        )
        cursor = self._execute(statement, parameters)
        items: list[ItemProjection] = []
        while (row := _fetch_row(cursor)) is not None:
            items.append(_decode_projection(row, fields))
        return tuple(items)

    def _execute(self, statement: str, parameters: tuple[str | int, ...] = ()) -> sqlite3.Cursor:
        try:
            cursor = self._connection.execute(statement, parameters)
        except sqlite3.Error as error:
            raise RepositoryError("The items store rejected the operation.") from error
        return cursor


def _page_statement(
    *, start: PageStart, limit: int, name_contains: str, fields: tuple[ItemField, ...]
) -> tuple[str, tuple[str | int, ...]]:
    after_item = isinstance(start, AfterItem)
    filtered = bool(name_contains)
    parameters: list[str | int] = []
    if after_item:
        parameters.append(start.item_id.value)
    if filtered:
        parameters.append(name_contains)
    parameters.append(limit)
    statement = dict(_PAGE_STATEMENTS)[(ItemField.NAME in fields, after_item, filtered)]
    return statement, tuple(parameters)


def _decode_projection(row: object, fields: tuple[ItemField, ...]) -> ItemProjection:
    if ItemField.NAME in fields:
        match row:
            case (str(raw_id), str(raw_name)):
                name = raw_name
            case _:
                raise RepositoryError(f"Unexpected selected items row shape: {row!r}")
    else:
        match row:
            case (str(raw_id),):
                name = ""
            case _:
                raise RepositoryError(f"Unexpected selected items row shape: {row!r}")
    item_id = ItemId(value=raw_id)
    values = tuple(
        ItemFieldValue(field=field, value=item_id.value if field == ItemField.ID else name)
        for field in fields
    )
    return ItemProjection(position=item_id, values=values)
