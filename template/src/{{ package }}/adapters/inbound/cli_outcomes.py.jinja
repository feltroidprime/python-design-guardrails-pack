    hint="Provide a non-blank --idempotency-key of at most 200 characters.",
)
IDEMPOTENCY_CONFLICT = OutcomeSpec(
    code=OutcomeCode.IDEMPOTENCY_CONFLICT,
    exit_code=ExitCode.PERMANENT_REJECTION,
    retryable=False,
