"""Closed public outcome vocabulary shared by the CLI catalog and runtime."""

from dataclasses import dataclass
from enum import IntEnum, StrEnum


class ExitCode(IntEnum):
    """Stable process classifications; fine-grained meaning stays in outcome codes."""

    SUCCESS = 0
    SYNTAX = 2
    PERMANENT_REJECTION = 3
    TEMPORARY_UNAVAILABLE = 4
    UNEXPECTED_FAILURE = 70


class OutcomeCode(StrEnum):
    INVALID_SYNTAX = "invalid_syntax"
    INVALID_ITEM_NAME = "invalid_item_name"
    INVALID_IDEMPOTENCY_KEY = "invalid_idempotency_key"
    IDEMPOTENCY_CONFLICT = "idempotency_conflict"
    INVALID_CONTINUATION = "invalid_continuation"
    DEPENDENCY_UNAVAILABLE = "dependency_unavailable"
    UNEXPECTED_FAILURE = "unexpected_failure"


type PublicDetailValue = str | int | bool | None


@dataclass(frozen=True, slots=True, kw_only=True)
class ConstantDetail:
    key: str
    value: PublicDetailValue


@dataclass(frozen=True, slots=True, kw_only=True)
class ComputedDetail:
    key: str


@dataclass(frozen=True, slots=True, kw_only=True)
class ArgumentDetail:
    key: str
    argument_source: str


type OutcomeDetail = ConstantDetail | ComputedDetail | ArgumentDetail


@dataclass(frozen=True, slots=True, kw_only=True)
class ComputedFailureDetail:
    key: str
    value: PublicDetailValue


@dataclass(frozen=True, slots=True, kw_only=True)
class ArgumentFailureDetail:
    key: str
    argument_source: str
    value: PublicDetailValue


type FailureDetail = ComputedFailureDetail | ArgumentFailureDetail


@dataclass(frozen=True, slots=True, kw_only=True)
class OutcomeSpec:
    code: OutcomeCode
    exit_code: ExitCode
    retryable: bool
    details: tuple[OutcomeDetail, ...]
    hint: str

    def __post_init__(self) -> None:
        keys = self.safe_detail_keys
        if (
            not self.hint.strip()
            or not all(key.strip() for key in keys)
            or len(keys) != len(set(keys))
        ):
            raise ValueError("Outcomes require guidance and unique safe detail keys.")
        if self.retryable != (self.exit_code == ExitCode.TEMPORARY_UNAVAILABLE):
            raise ValueError("Only temporary dependency outcomes are retryable.")

    @property
    def safe_detail_keys(self) -> tuple[str, ...]:
        return tuple(detail.key for detail in self.details)


INVALID_SYNTAX = OutcomeSpec(
    code=OutcomeCode.INVALID_SYNTAX,
    exit_code=ExitCode.SYNTAX,
    retryable=False,
    details=(),
    hint="Use command help and correct the invocation.",
)
UNEXPECTED_FAILURE = OutcomeSpec(
    code=OutcomeCode.UNEXPECTED_FAILURE,
    exit_code=ExitCode.UNEXPECTED_FAILURE,
    retryable=False,
    details=(),
    hint="Re-run the command with --debug for a traceback.",
)
SHARED_OUTCOMES = (INVALID_SYNTAX, UNEXPECTED_FAILURE)

INVALID_ITEM_NAME = OutcomeSpec(
    code=OutcomeCode.INVALID_ITEM_NAME,
    exit_code=ExitCode.PERMANENT_REJECTION,
    retryable=False,
    details=(
        ConstantDetail(key="field", value="name"),
        ArgumentDetail(key="rejected_value", argument_source="name"),
    ),
    hint="Provide a non-blank name no longer than 80 characters.",
)
