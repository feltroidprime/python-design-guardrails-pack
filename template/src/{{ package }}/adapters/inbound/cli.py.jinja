"""Argparse boundary for the versioned command-line contract."""

import argparse
import sys
from typing import TYPE_CHECKING, NoReturn, override

from {{ package }}.adapters.inbound.cli_catalog import COMMAND_CATALOG
from {{ package }}.adapters.inbound.cli_contract import (
    ArgumentSpec,
    ChoiceOption,
    CommandName,
    CommandPolicy,
    FlagOption,
    OutputMode,
    OutputOption,
    PageLimitOption,
    PositionalText,
    QueryPolicy,
    QuietOption,
    TextOption,
    shared_outcome,
)
from {{ package }}.adapters.inbound.cli_outcomes import ExitCode, OutcomeCode
from {{ package }}.adapters.inbound.cli_protocol import FailureBody, write_failure
from {{ package }}.adapters.inbound.cli_runtime import (
    AddRequest,
    CapabilitiesRequest,
    CliRequest,
    ListRequest,
    execute,
)
from {{ package }}.application.query_models import DEFAULT_ITEM_FIELDS, ItemField

if TYPE_CHECKING:
    from collections.abc import Callable, Sequence
    from typing import TextIO

    from _typeshed import SupportsWrite

    from {{ package }}.application.use_cases import CreateItem, ListItems

_NO_DEFAULT = object()


class _RawArguments:
    command: str
    name: str
    idempotency_key: str
    limit: int
    continuation: str
    name_contains: str
    kind: str
    fields: list[str]
    quiet: bool
    output_format: str
    debug: bool

    def __init__(self) -> None:
        self.command = ""
        self.name = ""
        self.idempotency_key = ""
        self.limit = 0
        self.continuation = ""
        self.name_contains = ""
        self.kind = ""
        self.fields = []
        self.quiet = False
        self.output_format = ""
        self.debug = False


class _ParserExitError(Exception):
    def __init__(self, *, status: int, message: str) -> None:
        super().__init__(message)
        self.status: int = status
        self.message: str = message


class _ContractParser(argparse.ArgumentParser):
    _out: TextIO = sys.stdout

    def bind_output(self, out: TextIO) -> None:
        self._out = out

    @override
    def _print_message(
        self,
        message: str | None,
        file: SupportsWrite[str] | None = None,  # ARCH-EXCEPTION: ADR-0002
    ) -> None:
        if message:
            _ = file
            _ = self._out.write(message)

    @override
    def exit(self, status: int = 0, message: str | None = None) -> NoReturn:
        raise _ParserExitError(status=status, message=message or "")

    @override
    def error(self, message: str) -> NoReturn:
        raise _ParserExitError(status=ExitCode.SYNTAX, message=message)


def _parser(*, out: TextIO) -> _ContractParser:
    parser = _ContractParser(
        prog="python -m {{ package }}",
        description="Agent-native example application.",
        allow_abbrev=False,
        suggest_on_error=True,
        color=False,
    )
    parser.bind_output(out)
    commands = parser.add_subparsers(dest="command", required=True)
    for spec in COMMAND_CATALOG:
        stdin_help = f"stdin: {spec.input_policy.stdin.value}"
        if spec.input_policy.stdin_marker:
            stdin_help += f" via {spec.input_policy.stdin_marker}"
        command = commands.add_parser(
            spec.name.value,
            help=spec.purpose,
            description=spec.purpose,
            epilog=(
                f"Automation example: {spec.automation_example}\n"
                f"Primary input: {spec.input_policy.primary.value}; "
                f"{stdin_help}."
            ),
            allow_abbrev=False,
            suggest_on_error=True,
            color=False,
        )
        command.bind_output(out)
        for argument in spec.arguments:
            _add_catalog_argument(
                command,
                argument,
                output_modes=spec.output_modes,
                default_output_mode=spec.default_output_mode,
                policy=spec.policy,
            )
    return parser


def _add_catalog_argument(
    parser: _ContractParser,
    argument: ArgumentSpec,
    *,
    output_modes: tuple[OutputMode, ...],
    default_output_mode: OutputMode,
    policy: CommandPolicy,
) -> None:
    match argument:
        case PositionalText():
            help_text = _typed_help(argument.help, "text", required=True)
            _ = parser.add_argument(argument.name, help=help_text)
        case TextOption():
            _add_text_option(parser, argument)
        case PageLimitOption():
            _add_page_limit(parser, argument, policy=policy)
        case OutputOption():
            _add_output_option(
                parser, output_modes=output_modes, default_output_mode=default_output_mode
            )
        case FlagOption():
            _add_flag_option(parser, argument)
        case ChoiceOption():
            _add_choice_option(parser, argument)
        case QuietOption():
            _add_quiet_option(parser)


def _add_text_option(parser: _ContractParser, argument: TextOption) -> None:
    help_text = _typed_help(argument.help, "text", default=argument.default)
    _ = parser.add_argument(
        argument.flag, dest=argument.destination, help=help_text, default=argument.default
    )


def _add_page_limit(
    parser: _ContractParser, argument: PageLimitOption, *, policy: CommandPolicy
) -> None:
    if not isinstance(policy, QueryPolicy):
        raise TypeError("Page limits require a query policy.")
    help_text = _typed_help(
        f"{argument.help}; maximum: {policy.maximum_limit}",
        "integer",
        default=policy.default_limit,
    )
    _ = parser.add_argument(
        argument.flag,
        dest=argument.destination,
        help=help_text,
        type=_bounded_positive_integer(policy.maximum_limit),
        default=policy.default_limit,
    )


def _add_output_option(
    parser: _ContractParser,
    *,
    output_modes: tuple[OutputMode, ...],
    default_output_mode: OutputMode,
) -> None:
    choices = tuple(mode.value for mode in output_modes if mode != OutputMode.QUIET)
    help_text = _typed_help(
        "output format",
        "choice",
        default=default_output_mode.value,
        choices=choices,
    )
    _ = parser.add_argument(
        "--format", dest="output_format", choices=choices, default="", help=help_text
    )


def _add_flag_option(parser: _ContractParser, argument: FlagOption) -> None:
    help_text = _typed_help(argument.help, "boolean", default=False)
    _ = parser.add_argument(
        argument.flag, dest=argument.destination, action="store_true", help=help_text
    )


def _add_choice_option(parser: _ContractParser, argument: ChoiceOption) -> None:
    help_text = _typed_help(
        argument.help,
        "choice",
        default=argument.default,
        choices=argument.choices,
        repeatable=argument.repeatable,
    )
    _ = parser.add_argument(
        argument.flag,
        dest=argument.destination,
        choices=argument.choices,
        action="append" if argument.repeatable else "store",
        default=[] if argument.repeatable else argument.default,
        help=help_text,
    )


def _add_quiet_option(parser: _ContractParser) -> None:
    help_text = _typed_help("write one selected value per line", "boolean", default=False)
    _ = parser.add_argument("-q", "--quiet", dest="quiet", action="store_true", help=help_text)


def _typed_help(
    text: str,
    value_type: str,
    *,
    required: bool = False,
    default: object = _NO_DEFAULT,
    choices: tuple[str, ...] = (),
    repeatable: bool = False,
) -> str:
    facts = [f"type: {value_type}"]
    if required:
        facts.append("required")
    if default is not _NO_DEFAULT:
        rendered = "empty" if default in {None, ""} else str(default).lower()
        facts.append(f"default: {rendered}")
    if choices:
        facts.append(f"choices: {', '.join(choices)}")
    if repeatable:
        facts.append("repeatable")
    return f"{text} ({'; '.join(facts)})"


def _bounded_positive_integer(maximum: int) -> Callable[[str], int]:
    def parse(raw: str) -> int:
        try:
            value = int(raw)
        except ValueError as error:
            raise argparse.ArgumentTypeError("must be an integer") from error
        if not 1 <= value <= maximum:
            raise argparse.ArgumentTypeError(f"must be between 1 and {maximum}")
        return value

    return parse


def _parse(argv: Sequence[str], *, parser: _ContractParser) -> CliRequest:
    raw = _RawArguments()
    _ = parser.parse_args(list(argv), namespace=raw)
    match raw.command:
        case CommandName.ADD:
            return AddRequest(
                raw_name=raw.name,
                idempotency_key=raw.idempotency_key,
                output_mode=_output_mode(raw, parser=parser),
                debug=raw.debug,
            )
        case CommandName.CAPABILITIES:
            fields = tuple(raw.fields)
            if len(fields) != len(set(fields)):
                parser.error("--field values must be unique")
            if raw.quiet and len(fields) != 1:
                parser.error("--quiet requires exactly one --field")
            return CapabilitiesRequest(
                limit=raw.limit,
                continuation=raw.continuation,
                name_contains=raw.name_contains,
                kind=raw.kind,
                fields=fields,
                output_mode=_output_mode(raw, parser=parser),
                debug=raw.debug,
            )
        case CommandName.LIST:
            fields = tuple(ItemField(field) for field in raw.fields) or DEFAULT_ITEM_FIELDS
            if len(fields) != len(set(fields)):
                parser.error("--field values must be unique")
            if raw.quiet and len(fields) != 1:
                parser.error("--quiet requires exactly one --field")
            return ListRequest(
                limit=raw.limit,
                continuation=raw.continuation,
                name_contains=raw.name_contains,
                fields=fields,
                output_mode=_output_mode(raw, parser=parser),
                debug=raw.debug,
            )
        case _:
            raise AssertionError("The parser accepted a command absent from the closed catalog.")


def _output_mode(raw: _RawArguments, *, parser: _ContractParser) -> OutputMode:
    if raw.quiet and raw.output_format:
        parser.error("--quiet cannot be combined with --format")
    if raw.quiet:
        return OutputMode.QUIET
    if raw.output_format:
        return OutputMode(raw.output_format)
    return next(
        spec.default_output_mode for spec in COMMAND_CATALOG if spec.name.value == raw.command
    )


def run(
    argv: Sequence[str],
    *,
    create_item: CreateItem,
    list_items: ListItems,
    out: TextIO,
    err: TextIO,
) -> int:
    """Translate argv into a typed request, then execute it at the application seam."""
    try:
        request = _parse(argv, parser=_parser(out=out))
    except _ParserExitError as error:
        if error.status == ExitCode.SUCCESS:
            return ExitCode.SUCCESS
        command = argv[0] if argv and argv[0] in CommandName else "cli"
        help_invocation = (
            f"python -m {{ package }} {command} --help"
            if command != "cli"
            else "python -m {{ package }} --help"
        )
        write_failure(
            command=str(command),
            failure=FailureBody(
                outcome=shared_outcome(OutcomeCode.INVALID_SYNTAX),
                message=error.message,
                hint=f"Run '{help_invocation}' and correct the invocation.",
            ),
            err=err,
        )
        return ExitCode.SYNTAX
    return execute(
        request,
        create_item=create_item,
        list_items=list_items,
        out=out,
        err=err,
    )
