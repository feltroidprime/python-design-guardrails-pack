"""Closed declaration types required by the repository-control command catalog."""

from dataclasses import dataclass
from enum import StrEnum

from {{ package }}.adapters.inbound.cli_outcomes import (
    SHARED_OUTCOMES,
    OutcomeCode,
    OutcomeSpec,
)


class CommandName(StrEnum):
    CAPABILITIES = "capabilities"


class CommandKind(StrEnum):
    QUERY = "query"
    MUTATION = "mutation"


class OutputMode(StrEnum):
    JSON = "json"
    HUMAN = "human"


class RetryPolicy(StrEnum):
    UNCONDITIONAL = "unconditional"


class InputMode(StrEnum):
    ARGUMENTS = "arguments"


class StdinMode(StrEnum):
    FORBIDDEN = "forbidden"


@dataclass(frozen=True, slots=True, kw_only=True)
class InputPolicy:
    primary: InputMode
    stdin: StdinMode


@dataclass(frozen=True, slots=True, kw_only=True)
class QueryPolicy:
    default_limit: int
    maximum_limit: int
    stable_order: str
    continuation: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class MutationPolicy:
    retry: RetryPolicy


type CommandPolicy = QueryPolicy | MutationPolicy


@dataclass(frozen=True, slots=True, kw_only=True)
class NonDestructiveSafety:
    """A command that requires no preview or confirmation controls."""


@dataclass(frozen=True, slots=True, kw_only=True)
class PositionalText:
    name: str
    help: str


@dataclass(frozen=True, slots=True, kw_only=True)
class TextOption:
    flag: str
    destination: str
    help: str
    default: str


@dataclass(frozen=True, slots=True, kw_only=True)
class PageLimitOption:
    flag: str
    destination: str
    help: str


@dataclass(frozen=True, slots=True, kw_only=True)
class OutputOption:
    """Expose the command's declared output modes through ``--format``."""


@dataclass(frozen=True, slots=True, kw_only=True)
class FlagOption:
    flag: str
    destination: str
    help: str


@dataclass(frozen=True, slots=True, kw_only=True)
class ChoiceOption:
    flag: str
    destination: str
    help: str
    choices: tuple[str, ...]
    repeatable: bool = False
    default: str | None = None


type ArgumentSpec = (
    PositionalText | TextOption | PageLimitOption | OutputOption | FlagOption | ChoiceOption
)


@dataclass(frozen=True, slots=True, kw_only=True)
class CommandSpec:
    name: CommandName
    kind: CommandKind
    purpose: str
    automation_example: str
    output_modes: tuple[OutputMode, ...]
    default_output_mode: OutputMode
    policy: CommandPolicy
    input_policy: InputPolicy
    safety: NonDestructiveSafety
    outcomes: tuple[OutcomeSpec, ...]
    arguments: tuple[ArgumentSpec, ...] = ()


def shared_outcome(code: OutcomeCode) -> OutcomeSpec:
    return next(outcome for outcome in SHARED_OUTCOMES if outcome.code == code)
