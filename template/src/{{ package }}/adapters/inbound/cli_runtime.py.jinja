"""Typed CLI request execution, independent of the parser framework."""

from dataclasses import dataclass
import traceback
from typing import TYPE_CHECKING

from {{ package }}.adapters.inbound.cli_catalog import COMMAND_CATALOG
from {{ package }}.adapters.inbound.cli_contract import (
    CommandName,
    OutputMode,
    outcome_for,
    shared_outcome,
)
from {{ package }}.adapters.inbound.cli_outcomes import (
    ArgumentFailureDetail,
    ComputedFailureDetail,
    ExitCode,
    FailureDetail,
    OutcomeCode,
    OutcomeSpec,
)
from {{ package }}.adapters.inbound.cli_protocol import (
    FailureBody,
    InvalidContinuationError,
    capability_document,
    decode_continuation,
    encode_continuation,
    write_capabilities,
    write_created,
    write_failure,
    write_item_page,
)
from {{ package }}.application.errors import (
    IdempotencyConflictError,
    InvalidIdempotencyKeyError,
    RepositoryError,
)
from {{ package }}.application.query_models import (
    AfterItem,
    FirstPage,
    ItemField,
    ListItemsQuery,
)
from {{ package }}.application.use_cases import CreateItemCommand
from {{ package }}.domain.errors import InvalidItemNameError
from {{ package }}.domain.value_objects import ItemId

if TYPE_CHECKING:
    from typing import TextIO

    from {{ package }}.application.use_cases import CreateItem, ListItems


@dataclass(frozen=True, slots=True, kw_only=True)
class AddRequest:
    raw_name: str
    idempotency_key: str
    output_mode: OutputMode
    debug: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class CapabilitiesRequest:
    limit: int
    continuation: str
    name_contains: str
    kind: str
    fields: tuple[str, ...]
    output_mode: OutputMode
    debug: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class ListRequest:
    limit: int
    continuation: str
    name_contains: str
    fields: tuple[ItemField, ...]
    output_mode: OutputMode
    debug: bool


type CliRequest = AddRequest | CapabilitiesRequest | ListRequest


@dataclass(frozen=True, slots=True, kw_only=True)
class ExecutionFailure:
    outcome: OutcomeSpec
    message: str
    details: tuple[FailureDetail, ...]
    hint: str = ""


type KnownExecutionError = (
    RepositoryError
    | IdempotencyConflictError
    | InvalidIdempotencyKeyError
    | InvalidContinuationError
)


def execute(
    request: CliRequest,
    *,
    create_item: CreateItem,
    list_items: ListItems,
    out: TextIO,
    err: TextIO,
) -> int:
    """Execute a typed request and translate failures to the process contract."""
    command, output_mode, debug = _request_context(request)
    try:
        return _dispatch(
            request,
            create_item=create_item,
            list_items=list_items,
            out=out,
            err=err,
        )
    except (
        RepositoryError,
        IdempotencyConflictError,
        InvalidIdempotencyKeyError,
        InvalidContinuationError,
    ) as error:
        failure = _known_failure(command, error)
    except Exception as error:  # noqa: BLE001  # ARCH-EXCEPTION: ADR-0003
        if debug:
            traceback.print_exception(error, file=err)
            return ExitCode.UNEXPECTED_FAILURE
        failure = ExecutionFailure(
            outcome=shared_outcome(OutcomeCode.UNEXPECTED_FAILURE),
            message="The command failed unexpectedly.",
            hint=f"Re-run 'python -m {{ package }} {command} --debug' for a traceback.",
            details=(),
        )
    return _write_execution_failure(
        command=command.value,
        output_mode=output_mode,
        failure=failure,
        err=err,
    )


def _known_failure(command: CommandName, error: KnownExecutionError) -> ExecutionFailure:
    match error:
        case RepositoryError():
            return ExecutionFailure(
                outcome=outcome_for(COMMAND_CATALOG, command, OutcomeCode.DEPENDENCY_UNAVAILABLE),
                message=str(error),
                details=(),
            )
        case IdempotencyConflictError():
            return ExecutionFailure(
                outcome=outcome_for(COMMAND_CATALOG, command, OutcomeCode.IDEMPOTENCY_CONFLICT),
                message=str(error),
                details=(),
            )
        case InvalidIdempotencyKeyError():
            return ExecutionFailure(
                outcome=outcome_for(COMMAND_CATALOG, command, OutcomeCode.INVALID_IDEMPOTENCY_KEY),
                message=str(error),
                details=(),
            )
        case InvalidContinuationError():
            return ExecutionFailure(
                outcome=outcome_for(COMMAND_CATALOG, command, OutcomeCode.INVALID_CONTINUATION),
                message=str(error),
                details=(ComputedFailureDetail(key="reason", value=error.reason),),
            )


def _request_context(request: CliRequest) -> tuple[CommandName, OutputMode, bool]:
    match request:
        case AddRequest(output_mode=output_mode, debug=debug):
            return CommandName.ADD, output_mode, debug
        case CapabilitiesRequest(output_mode=output_mode, debug=debug):
            return CommandName.CAPABILITIES, output_mode, debug
        case ListRequest(output_mode=output_mode, debug=debug):
            return CommandName.LIST, output_mode, debug


def _write_execution_failure(
    *,
    command: str,
    output_mode: OutputMode,
    failure: ExecutionFailure,
    err: TextIO,
) -> int:
    if output_mode == OutputMode.HUMAN:
        hint = failure.hint or failure.outcome.hint
        _ = err.write(f"error: {failure.message}\n{hint}\n")
    else:
        write_failure(
            command=command,
            failure=FailureBody(
                outcome=failure.outcome,
                message=failure.message,
                hint=failure.hint,
                details=failure.details,
            ),
            err=err,
        )
    return failure.outcome.exit_code


def _dispatch(
    request: CliRequest,
    *,
    create_item: CreateItem,
    list_items: ListItems,
    out: TextIO,
    err: TextIO,
) -> int:
    match request:
        case AddRequest(
            raw_name=raw_name,
            idempotency_key=idempotency_key,
            output_mode=output_mode,
        ):
            return _add(
                raw_name,
                idempotency_key=idempotency_key,
                output_mode=output_mode,
                create_item=create_item,
                out=out,
                err=err,
            )
        case CapabilitiesRequest():
            _write_capabilities(request, out=out)
            return ExitCode.SUCCESS
        case ListRequest():
            return _list(request, list_items=list_items, out=out)


def _list(request: ListRequest, *, list_items: ListItems, out: TextIO) -> int:
    selection: dict[str, object] = {
        "name_contains": request.name_contains,
        "fields": [field.value for field in request.fields],
    }
    start = _page_start(request.continuation, selection=selection)
    page = list_items(
        ListItemsQuery(
            limit=request.limit,
            start=start,
            name_contains=request.name_contains,
            fields=request.fields,
        )
    )
    if request.output_mode == OutputMode.HUMAN:
        for item in page.items:
            _ = out.write("\t".join(value.value for value in item.values) + "\n")
    elif request.output_mode == OutputMode.QUIET:
        for item in page.items:
            _ = out.write(item.values[0].value + "\n")
    else:
        write_item_page(page, selection=selection, out=out)
    return ExitCode.SUCCESS


def _page_start(continuation: str, *, selection: dict[str, object]) -> FirstPage | AfterItem:
    if not continuation:
        return FirstPage()
    position = decode_continuation(continuation, selection=selection)
    return AfterItem(item_id=ItemId(value=position))


def _write_capabilities(request: CapabilitiesRequest, *, out: TextIO) -> None:
    selection: dict[str, object] = {
        "name_contains": request.name_contains,
        "kind": request.kind,
        "fields": list(request.fields),
    }
    position = (
        decode_continuation(request.continuation, selection=selection)
        if request.continuation
        else ""
    )
    eligible = tuple(
        spec
        for spec in COMMAND_CATALOG
        if spec.name.value > position
        and request.name_contains in spec.name.value
        and (not request.kind or spec.kind.value == request.kind)
    )
    fetched = eligible[: request.limit + 1]
    visible = fetched[: request.limit]
    truncated = len(fetched) > request.limit
    next_token = (
        encode_continuation(visible[-1].name.value, selection=selection) if truncated else ""
    )
    if request.output_mode == OutputMode.HUMAN:
        for spec in visible:
            document = capability_document(spec)
            selected = request.fields or ("name", "kind", "purpose")
            _ = out.write("\t".join(str(document[field]) for field in selected) + "\n")
    elif request.output_mode == OutputMode.QUIET:
        for spec in visible:
            _ = out.write(str(capability_document(spec)[request.fields[0]]) + "\n")
    else:
        write_capabilities(
            visible,
            fields=request.fields,
            truncated=truncated,
            continuation=next_token,
            out=out,
        )


def _add(
    raw_name: str,
    *,
    idempotency_key: str,
    output_mode: OutputMode,
    create_item: CreateItem,
    out: TextIO,
    err: TextIO,
) -> int:
    try:
        result = create_item(CreateItemCommand(name=raw_name, idempotency_key=idempotency_key))
    except InvalidItemNameError as error:
        outcome = outcome_for(COMMAND_CATALOG, CommandName.ADD, OutcomeCode.INVALID_ITEM_NAME)
        if output_mode == OutputMode.HUMAN:
            _ = err.write(f"error: {error}\n{outcome.hint}\n")
        else:
            write_failure(
                command=CommandName.ADD.value,
                failure=FailureBody(
                    outcome=outcome,
                    message=str(error),
                    details=(
                        ArgumentFailureDetail(
                            key="rejected_value",
                            argument_source="name",
                            value=raw_name,
                        ),
                    ),
                ),
                err=err,
            )
        return outcome.exit_code
    if output_mode == OutputMode.HUMAN:
        action = "replayed" if result.replayed else "created"
        _ = out.write(f"{action} {result.item.item_id.value}\t{result.item.name.value}\n")
    else:
        write_created(result, out=out)
    return ExitCode.SUCCESS
