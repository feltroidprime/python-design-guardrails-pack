if TYPE_CHECKING:
    from collections.abc import Sequence
    from typing import Protocol, TextIO

    from _typeshed import SupportsWrite

    class _SubparserFactory(Protocol):
        def add_parser(self, name: str, **kwargs: object) -> _MutationParser: ...


@dataclass(frozen=True, slots=True, kw_only=True)
class _PlanRequest:
    name: str
    inbound: tuple[str, ...]
    outbound: tuple[str, ...]
    output: str
    output_mode: OutputMode
    debug: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class _ApplyRequest:
    plan_reference: str
    output_mode: OutputMode
    debug: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class _ActivateRequest:
    name: str
    evidence: ActivationEvidence
    output_mode: OutputMode
    debug: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class _RetireRequest:
    name: str
    output_mode: OutputMode
    debug: bool


@dataclass(frozen=True, slots=True, kw_only=True)
class _DirectRequest:
    command: ControlCommandName
    output_mode: OutputMode
    debug: bool


type _MutationRequest = (
    _PlanRequest | _ApplyRequest | _ActivateRequest | _RetireRequest | _DirectRequest
)


@dataclass
class _RawArguments:
    command: str = ""
    action: str = ""
    name: str = ""
    inbound: list[str] = field(default_factory=list)
    outbound: list[str] = field(default_factory=list)
    output: str = ""
    plan_reference: str = ""
    architecture_contract: bool = False
    stable_surface: bool = False
    normative_property_evidence: bool = False
    port_contract: bool = False
    cli_process_evidence: bool = False
    output_format: str = OutputMode.JSON.value
    debug: bool = False


class _ParserExitError(Exception):
    def __init__(self, *, status: int, message: str) -> None:
        super().__init__(message)
        self.status: int = status
        self.message: str = message


class _MutationParser(argparse.ArgumentParser):
    _out: TextIO = sys.stdout

    def bind_output(self, out: TextIO) -> None:
        self._out = out

    @override
    def _print_message(
        self,
        message: str | None,
        file: SupportsWrite[str] | None = None,  # ARCH-EXCEPTION: ADR-0002
    ) -> None:
        if message:
            _ = file
            _ = self._out.write(message)

    @override
    def exit(self, status: int = 0, message: str | None = None) -> NoReturn:
        raise _ParserExitError(status=status, message=message or "")

    @override
    def error(self, message: str) -> NoReturn:
        raise _ParserExitError(status=ExitCode.SYNTAX, message=message)


def _subparser(
    factory: _SubparserFactory,
    name: str,
    help_text: str,
    *,
    out: TextIO,
) -> _MutationParser:
    parser = factory.add_parser(
        name,
        help=help_text,
        allow_abbrev=False,
        suggest_on_error=True,
        color=False,
    )
    parser.bind_output(out)
    return parser


def _parser(*, out: TextIO) -> _MutationParser:
    parser = _MutationParser(
        prog="python -m repoctl",
        description="Repository control plane mutations.",
        allow_abbrev=False,
        suggest_on_error=True,
        color=False,
    )
    parser.bind_output(out)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=_MutationParser)
    command_parsers = cast("_SubparserFactory", cast("object", commands))
    capability = _subparser(
        command_parsers,
        "capability",
        "plan, apply, activate, or retire one product capability",
        out=out,
    )
    actions = capability.add_subparsers(
        dest="action",
        required=True,
        parser_class=_MutationParser,
    )
    action_parsers = cast("_SubparserFactory", cast("object", actions))
    _add_plan_parser(action_parsers, out=out)
    _add_apply_parser(action_parsers, out=out)
    _add_lifecycle_parsers(action_parsers, out=out)
    for command, help_text in (
        (ControlCommandName.GENERATE, "regenerate declaration-derived indexes"),
        (ControlCommandName.PROOF_REPORT, "report the validated property and evidence matrix"),
    ):
        _add_common_options(_subparser(command_parsers, command.value, help_text, out=out))
    return parser


def _add_plan_parser(actions: _SubparserFactory, *, out: TextIO) -> None:
    parser = _subparser(
        actions,
        "plan",
        "write an inspectable immutable plan without applying it",
        out=out,
    )
    _ = parser.add_argument("name", help="capability name (type: text; required)")
    _ = parser.add_argument(
        "--inbound",
        action="append",
        default=[],
        metavar="SEAM",
        help="repeatable inbound architectural seam (type: text)",
    )
    _ = parser.add_argument(
        "--outbound",
        action="append",
        default=[],
        metavar="SEAM",
        help="repeatable outbound architectural seam (type: text)",
    )
    _ = parser.add_argument(
        "--output",
        required=True,
        help="relative .repo/plans/*.json destination (type: text; required)",
    )
    _add_common_options(parser)


def _add_apply_parser(actions: _SubparserFactory, *, out: TextIO) -> None:
    parser = _subparser(
        actions,
        "apply",
        "apply one previously inspected immutable plan",
        out=out,
    )
    _ = parser.add_argument("plan_reference", help="saved plan path (type: text; required)")
    _add_common_options(parser)


def _add_lifecycle_parsers(actions: _SubparserFactory, *, out: TextIO) -> None:
    activate_parser = _subparser(
        actions,
        "activate",
        "activate one capability after explicit evidence confirmation",
        out=out,
    )
    _ = activate_parser.add_argument("name", help="capability name (type: text; required)")
    for flag, help_text in (
        ("--architecture-contract", "confirm the current architecture contract"),
        ("--stable-surface", "confirm the stable public surface"),
        ("--normative-property-evidence", "confirm normative property evidence"),
        ("--port-contract", "confirm the port contract"),
        ("--cli-process-evidence", "confirm detached CLI process evidence"),
    ):
        _ = activate_parser.add_argument(
            flag,
            action="store_true",
            help=f"{help_text} (type: boolean; default: false)",
        )
    _add_common_options(activate_parser)
    retire_parser = _subparser(
        actions,
        "retire",
        "retire one active capability without changing product files",
        out=out,
    )
    _ = retire_parser.add_argument("name", help="capability name (type: text; required)")
    _add_common_options(retire_parser)


def _add_common_options(parser: _MutationParser) -> None:
    _ = parser.add_argument(
        "--format",
        dest="output_format",
        choices=(OutputMode.JSON.value, OutputMode.HUMAN.value),
        default=OutputMode.JSON.value,
        help="output format (type: choice; default: json; choices: json, human)",
    )
    _ = parser.add_argument(
        "--debug",
        action="store_true",
        help="show a traceback for unexpected failures (type: boolean; default: false)",
    )


def _parse(argv: Sequence[str], *, parser: _MutationParser) -> _MutationRequest:
    raw = _RawArguments()
    _ = parser.parse_args(list(argv), namespace=raw)
    output_mode = OutputMode(raw.output_format)
    if raw.command in {
        ControlCommandName.GENERATE.value,
        ControlCommandName.PROOF_REPORT.value,
    }:
        return _DirectRequest(
            command=ControlCommandName(raw.command),
            output_mode=output_mode,
            debug=raw.debug,
        )
    if raw.command != "capability":
        raise ValueError("Only control-plane mutations belong to this mutation boundary.")
    if raw.action == "plan":
        return _PlanRequest(
            name=raw.name,
            inbound=tuple(raw.inbound),
            outbound=tuple(raw.outbound),
            output=raw.output,
            output_mode=output_mode,
            debug=raw.debug,
        )
    if raw.action == "apply":
        return _ApplyRequest(
            plan_reference=raw.plan_reference,
            output_mode=output_mode,
            debug=raw.debug,
        )
    if raw.action == "activate":
        return _ActivateRequest(
            name=raw.name,
            evidence=ActivationEvidence(
                architecture_contract=raw.architecture_contract,
                stable_surface=raw.stable_surface,
                normative_property_evidence=raw.normative_property_evidence,
                port_contract=raw.port_contract,
                cli_process_evidence=raw.cli_process_evidence,
            ),
            output_mode=output_mode,
            debug=raw.debug,
        )
    if raw.action == "retire":
        return _RetireRequest(name=raw.name, output_mode=output_mode, debug=raw.debug)
    raise ValueError(f"Unknown capability mutation action: {raw.action}")


def _write_plan(
    request: _PlanRequest, repository: RepositoryPort, *, out: TextIO, err: TextIO
) -> int:
    if not is_plan_destination(request.output):
        return write_mutation_failure(
            command=ControlCommandName.CAPABILITY_PLAN.value,
            failure=plan_output_failure("Plan output must be a relative .repo/plans/*.json path."),
            output_mode=request.output_mode,
            err=err,
        )
    try:
        capability_plan = plan(
            repository.snapshot(),
            CapabilityIntent(
                schema_version=1,
                name=request.name,
                inbound=request.inbound,
                outbound=request.outbound,
            ),
        )
    except icontract.ViolationError:
        return write_mutation_failure(
            command=ControlCommandName.CAPABILITY_PLAN.value,
            failure=invalid_plan_failure("Capability name or boundaries are invalid."),
            output_mode=request.output_mode,
            err=err,
        )
    try:
        repository.write_if_matches(
            RepositoryPathCandidate(value=request.output),
            canonical_plan_bytes(capability_plan),
            expected_digest="absent",
        )
    except RepositoryConflictError:
        return write_mutation_failure(
            command=ControlCommandName.CAPABILITY_PLAN.value,
            failure=plan_output_failure("The requested plan output already exists."),
            output_mode=request.output_mode,
            err=err,
        )
    write_plan_success(capability_plan, request.output, request.output_mode, out=out)
    return ExitCode.SUCCESS


def _write_apply(
    request: _ApplyRequest, repository: RepositoryPort, *, out: TextIO, err: TextIO
) -> int:
    if not is_plan_destination(request.plan_reference):
        return write_mutation_failure(
            command=ControlCommandName.CAPABILITY_APPLY.value,
            failure=invalid_plan_failure("Plan input must be a relative .repo/plans/*.json path."),
            output_mode=request.output_mode,
            err=err,
        )
    content = repository.read_bytes(RepositoryPathCandidate(value=request.plan_reference))
    if content is None:
        return write_mutation_failure(
            command=ControlCommandName.CAPABILITY_APPLY.value,
            failure=invalid_plan_failure("The requested plan file does not exist."),
            output_mode=request.output_mode,
            err=err,
        )
    try:
        capability_plan = plan_from_bytes(content)
    except icontract.ViolationError, PlanDocumentError, TypeError, ValueError:
        return write_mutation_failure(
            command=ControlCommandName.CAPABILITY_APPLY.value,
            failure=invalid_plan_failure("The requested plan file is invalid."),
            output_mode=request.output_mode,
            err=err,
        )
    outcome = apply(capability_plan, repository)
    if outcome.status in {"applied", "already_applied"}:
        write_apply_success(outcome, request.output_mode, out=out)
        return ExitCode.SUCCESS
    return write_mutation_failure(
        command=ControlCommandName.CAPABILITY_APPLY.value,
        failure=apply_failure(
            status=outcome.status,
            recovery_instruction=outcome.recovery_instruction,
        ),
        output_mode=request.output_mode,
        err=err,
    )


def _write_control_success(
    command: ControlCommandName,
    data: dict[str, object],
    output_mode: OutputMode,
    *,
    out: TextIO,
) -> None:
    if output_mode == OutputMode.HUMAN:
        _ = out.write(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
        return
    write_success(command=command.value, data=data, metadata={}, out=out)


def _write_lifecycle(
    request: _ActivateRequest | _RetireRequest,
    repository: RepositoryPort,
    *,
    out: TextIO,
    err: TextIO,
) -> int:
    if isinstance(request, _ActivateRequest):
        command = ControlCommandName.CAPABILITY_ACTIVATE
        outcome = activate(request.name, request.evidence, repository)
    else:
        command = ControlCommandName.CAPABILITY_RETIRE
        outcome = retire(request.name, repository)
    if outcome.status == "refused":
        return write_mutation_failure(
            command=command.value,
            failure=lifecycle_failure(outcome),
            output_mode=request.output_mode,
            err=err,
        )
    _write_control_success(
        command,
        {"capability": outcome.capability_name, "status": outcome.status},
        request.output_mode,
        out=out,
    )
    return ExitCode.SUCCESS


def _proof_report_document(catalog: ProofCatalog) -> dict[str, object]:
    return {
        "properties": [
            {
                "id": property_spec.property_id,
                "kind": property_spec.kind,
                "assumptions": len(property_spec.assumptions),
                "evidence": sorted(property_spec.evidence),
                "targets": list(property_spec.targets),
            }
            for property_spec in catalog.properties
        ],
        "exemptions": len(catalog.exemptions),
    }


def _write_direct(
    request: _DirectRequest,
    repository: RepositoryPort,
    *,
    out: TextIO,
    err: TextIO,
) -> int:
    data: dict[str, object]
    if request.command == ControlCommandName.GENERATE:
        outcome = generate(repository.snapshot(), repository)
        data = {
            "source_state_sha256": outcome.source_state_sha256,
            "written_targets": list(outcome.written_targets),
        }
    elif request.command == ControlCommandName.PROOF_REPORT:
        catalog, violations = check(Path.cwd())
        if violations:
            return write_mutation_failure(
                command=request.command.value,
                failure=proof_contract_failure(len(violations)),
                output_mode=request.output_mode,
                err=err,
            )
        if catalog is None:
            raise RuntimeError("A successful proof check must return its catalog.")
        data = _proof_report_document(catalog)
    else:
        raise ValueError("Only direct control-plane mutations belong to this boundary.")
    _write_control_success(request.command, data, request.output_mode, out=out)
    return ExitCode.SUCCESS


def _request_command(request: _MutationRequest) -> str:
    if isinstance(request, _PlanRequest):
        return ControlCommandName.CAPABILITY_PLAN.value
    if isinstance(request, _ApplyRequest):
        return ControlCommandName.CAPABILITY_APPLY.value
    if isinstance(request, _ActivateRequest):
        return ControlCommandName.CAPABILITY_ACTIVATE.value
    if isinstance(request, _RetireRequest):
        return ControlCommandName.CAPABILITY_RETIRE.value
    return request.command.value


def _syntax_command(argv: Sequence[str]) -> str:
    if tuple(argv[:2]) in (("capability", "activate"), ("capability", "retire")):
        return " ".join(argv[:2])
    if argv and argv[0] in {
        ControlCommandName.GENERATE.value,
        ControlCommandName.PROOF_REPORT.value,
    }:
        return argv[0]
    return "capability" if argv and argv[0] == "capability" else "cli"


def _syntax_error(argv: Sequence[str], error: _ParserExitError, *, err: TextIO) -> int:
    command = _syntax_command(argv)
    write_failure(
        command=command,
        failure=FailureBody(
            outcome=shared_outcome(OutcomeCode.INVALID_SYNTAX),
            message=error.message,
            hint=f"Run 'python -m repoctl {command} --help' and correct the invocation.",
        ),
        err=err,
    )
    return ExitCode.SYNTAX


def _unexpected_error(
    request: _MutationRequest,
    error: Exception,
    *,
    err: TextIO,
) -> int:
    command = _request_command(request)
    if request.debug:
        traceback.print_exception(error, file=err)
        return ExitCode.UNEXPECTED_FAILURE
    return write_mutation_failure(
        command=command,
        failure=MutationFailure(
            code="unexpected_failure",
            exit_code=ExitCode.UNEXPECTED_FAILURE,
            message="The command failed unexpectedly.",
            hint=f"Re-run 'python -m repoctl {command} --debug' for a traceback.",
        ),
        output_mode=request.output_mode,
        err=err,
    )


def _dispatch(
    request: _MutationRequest,
    repository: RepositoryPort,
    *,
    out: TextIO,
    err: TextIO,
) -> int:
    if isinstance(request, _PlanRequest):
        return _write_plan(request, repository, out=out, err=err)
    if isinstance(request, _ApplyRequest):
        return _write_apply(request, repository, out=out, err=err)
    if isinstance(request, _ActivateRequest | _RetireRequest):
        return _write_lifecycle(request, repository, out=out, err=err)
    return _write_direct(request, repository, out=out, err=err)


def run_mutation(
    argv: Sequence[str],
    *,
    repository: RepositoryPort,
    out: TextIO,
    err: TextIO,
) -> int | None:
    """Handle every control-plane mutation or defer to read-only commands."""
    if not argv or argv[0] not in {
        "capability",
        ControlCommandName.GENERATE.value,
        ControlCommandName.PROOF_REPORT.value,
    }:
        return None
    try:
        request = _parse(argv, parser=_parser(out=out))
    except _ParserExitError as error:
        return (
            ExitCode.SUCCESS
            if error.status == ExitCode.SUCCESS
            else _syntax_error(argv, error, err=err)
        )
    try:
        return _dispatch(request, repository, out=out, err=err)
    except RepositoryPortError:
        return write_mutation_failure(
            command=_request_command(request),
            failure=repository_failure("The local repository is unavailable."),
            output_mode=request.output_mode,
            err=err,
        )
    except Exception as error:  # noqa: BLE001  # ARCH-EXCEPTION: ADR-0002
        return _unexpected_error(request, error, err=err)
