"""Closed registration surface for repository-control commands."""

from enum import StrEnum
from typing import cast

from {{ package }}.adapters.inbound.cli_contract import (
    ChoiceOption,
    CommandKind,
    CommandName,
    CommandSpec,
    FlagOption,
    InputMode,
    InputPolicy,
    MutationPolicy,
    NonDestructiveSafety,
    OutputMode,
    OutputOption,
    PageLimitOption,
    PositionalText,
    QueryPolicy,
    RetryPolicy,
    StdinMode,
    TextOption,
)
from {{ package }}.adapters.inbound.cli_outcomes import (
    CAPABILITIES_OUTCOMES,
    DEPENDENCY_UNAVAILABLE,
)


class ControlCommandName(StrEnum):
    """Repository-control command identities owned independently of product commands."""

    CAPABILITIES = "capabilities"
    STATUS = "status"
    CAPABILITY_PLAN = "capability plan"
    CAPABILITY_APPLY = "capability apply"


DEBUG_OPTION = FlagOption(
    flag="--debug",
    destination="debug",
    help="show a traceback for unexpected failures",
)


COMMAND_CATALOG: tuple[CommandSpec, ...] = (
    CommandSpec(
        name=cast(CommandName, cast(object, ControlCommandName.CAPABILITIES)),
        kind=CommandKind.QUERY,
        purpose="List declared product capability modules in stable name order.",
        automation_example="python -m repoctl capabilities",
        output_modes=(OutputMode.JSON, OutputMode.HUMAN),
        default_output_mode=OutputMode.JSON,
        policy=QueryPolicy(
            default_limit=20,
            maximum_limit=100,
            stable_order="capability declaration name",
            continuation=True,
        ),
        input_policy=InputPolicy(primary=InputMode.ARGUMENTS, stdin=StdinMode.FORBIDDEN),
        safety=NonDestructiveSafety(),
        outcomes=(*CAPABILITIES_OUTCOMES, DEPENDENCY_UNAVAILABLE),
        arguments=(
            PageLimitOption(flag="--limit", destination="limit", help="positive page size"),
            TextOption(
                flag="--continuation",
                destination="continuation",
                help="continue after the final capability name from the prior page",
                default="",
            ),
            OutputOption(),
            DEBUG_OPTION,
        ),
    ),
    CommandSpec(
        name=cast(CommandName, cast(object, ControlCommandName.STATUS)),
        kind=CommandKind.QUERY,
        purpose="Report repository schema and product-capability lifecycle counts.",
        automation_example="python -m repoctl status",
        output_modes=(OutputMode.JSON, OutputMode.HUMAN),
        default_output_mode=OutputMode.JSON,
        policy=QueryPolicy(
            default_limit=1,
            maximum_limit=1,
            stable_order="single repository state",
            continuation=True,
        ),
        input_policy=InputPolicy(primary=InputMode.ARGUMENTS, stdin=StdinMode.FORBIDDEN),
        safety=NonDestructiveSafety(),
        outcomes=(DEPENDENCY_UNAVAILABLE,),
        arguments=(
            PageLimitOption(flag="--limit", destination="limit", help="one status document"),
            OutputOption(),
            DEBUG_OPTION,
        ),
    ),
    CommandSpec(
        name=cast(CommandName, cast(object, ControlCommandName.CAPABILITY_PLAN)),
        kind=CommandKind.MUTATION,
        purpose="Write one inspectable immutable capability plan without applying it.",
        automation_example=(
            "python -m repoctl capability plan NAME --output .repo/plans/NAME.json"
        ),
        output_modes=(OutputMode.JSON, OutputMode.HUMAN),
        default_output_mode=OutputMode.JSON,
        policy=MutationPolicy(retry=RetryPolicy.UNCONDITIONAL),
        input_policy=InputPolicy(primary=InputMode.ARGUMENTS, stdin=StdinMode.FORBIDDEN),
        safety=NonDestructiveSafety(),
        outcomes=(DEPENDENCY_UNAVAILABLE,),
        arguments=(
            PositionalText(name="name", help="capability name"),
            ChoiceOption(
                flag="--inbound",
                destination="inbound",
                help="repeatable inbound architectural seam",
                choices=(),
                repeatable=True,
            ),
            ChoiceOption(
                flag="--outbound",
                destination="outbound",
                help="repeatable outbound architectural seam",
                choices=(),
                repeatable=True,
            ),
            TextOption(
                flag="--output",
                destination="output",
                help="relative inspectable plan destination",
                default="",
            ),
            OutputOption(),
            DEBUG_OPTION,
        ),
    ),
    CommandSpec(
        name=cast(CommandName, cast(object, ControlCommandName.CAPABILITY_APPLY)),
        kind=CommandKind.MUTATION,
        purpose="Apply one previously inspected immutable capability plan exactly once.",
        automation_example="python -m repoctl capability apply .repo/plans/NAME.json",
        output_modes=(OutputMode.JSON, OutputMode.HUMAN),
        default_output_mode=OutputMode.JSON,
        policy=MutationPolicy(retry=RetryPolicy.UNCONDITIONAL),
        input_policy=InputPolicy(primary=InputMode.ARGUMENTS, stdin=StdinMode.FORBIDDEN),
        safety=NonDestructiveSafety(),
        outcomes=(DEPENDENCY_UNAVAILABLE,),
        arguments=(
            PositionalText(name="plan_reference", help="saved inspectable plan path"),
            OutputOption(),
            DEBUG_OPTION,
        ),
    ),
)
