"""Structured mutation outcomes independent of the product command vocabulary."""

from dataclasses import dataclass
import json
from typing import TYPE_CHECKING

from {{ package }}.adapters.inbound.cli_contract import OutputMode
from {{ package }}.adapters.inbound.cli_outcomes import ExitCode
from {{ package }}.adapters.inbound.cli_protocol import SCHEMA_VERSION

# isort: split
from repoctl.modules.repository_generation.application.lifecycle import LifecycleOutcome

if TYPE_CHECKING:
    from typing import TextIO


@dataclass(frozen=True, slots=True, kw_only=True)
class MutationFailure:
    """One public, non-success mutation result with recovery guidance."""

    code: str
    exit_code: ExitCode
    message: str
    hint: str


def invalid_plan_failure(message: str) -> MutationFailure:
    """Describe an unreadable or structurally invalid saved plan."""
    return MutationFailure(
        code="invalid_plan",
        exit_code=ExitCode.PERMANENT_REJECTION,
        message=message,
        hint="Create a fresh plan with 'python -m repoctl capability plan NAME'.",
    )


def plan_output_failure(message: str) -> MutationFailure:
    """Describe an unsafe or unavailable inspectable-plan destination."""
    return MutationFailure(
        code="plan_output_unavailable",
        exit_code=ExitCode.PERMANENT_REJECTION,
        message=message,
        hint="Use an absent relative .repo/plans/<name>.json destination.",
    )


def repository_failure(message: str) -> MutationFailure:
    """Describe a local repository dependency failure without leaking internals."""
    return MutationFailure(
        code="dependency_unavailable",
        exit_code=ExitCode.TEMPORARY_UNAVAILABLE,
        message=message,
        hint="Retry after the local repository dependency is available.",
    )


def apply_failure(*, status: str, recovery_instruction: str) -> MutationFailure:
    """Translate one non-success application outcome to the CLI protocol."""
    messages = {
        "invalid_plan": "The saved capability plan is invalid.",
        "stale_plan": "The saved capability plan no longer matches repository state.",
        "product_file_exists": "An existing product file prevents capability application.",
        "recovery_required": "A previous capability application requires recovery.",
        "result_mismatch": "Capability application did not reach its planned result state.",
    }
    return MutationFailure(
        code=status,
        exit_code=ExitCode.PERMANENT_REJECTION,
        message=messages.get(status, "Capability application was refused."),
        hint=recovery_instruction or "Inspect the plan and repository state before retrying.",
    )


def lifecycle_failure(outcome: LifecycleOutcome) -> MutationFailure:
    """Translate one refused lifecycle transition to the CLI protocol."""
    if outcome.reason is None:
        raise RuntimeError("A refused lifecycle outcome must name its reason.")
    messages = {
        "capability_not_found": (
            "The requested capability declaration does not exist.",
            "Create and apply a capability plan before changing its lifecycle state.",
        ),
        "invalid_transition": (
            "The requested lifecycle transition is not valid for the current state.",
            "Inspect 'python -m repoctl capabilities' before retrying the transition.",
        ),
        "missing_evidence": (
            "Activation requires every current evidence confirmation.",
            "Pass each evidence flag only after its corresponding check has passed.",
        ),
        "stale_declaration": (
            "The capability declaration changed during the lifecycle transition.",
            "Retry from the current declaration state.",
        ),
        "declaration_path_not_owned": (
            "The capability declaration is outside the configured declaration zone.",
            "Restore the declaration under .repo/capabilities before retrying.",
        ),
    }
    message, hint = messages[outcome.reason]
    if outcome.missing_evidence:
        message = f"{message} Missing: {', '.join(outcome.missing_evidence)}."
    return MutationFailure(
        code=outcome.reason,
        exit_code=ExitCode.PERMANENT_REJECTION,
        message=message,
        hint=hint,
    )


def proof_contract_failure(violation_count: int) -> MutationFailure:
    """Describe a proof contract that fails its local validation."""
    return MutationFailure(
        code="proof_contract_failed",
        exit_code=ExitCode.PERMANENT_REJECTION,
        message=f"The proof contract has {violation_count} violation(s).",
        hint="Run 'just proof-report' after correcting the reported proof contract violations.",
    )


def write_mutation_failure(
    *,
    command: str,
    failure: MutationFailure,
    output_mode: OutputMode,
    err: TextIO,
) -> int:
    """Write one stable human or machine error without using product outcome codes."""
    if output_mode == OutputMode.HUMAN:
        _ = err.write(f"error: {failure.message}\n{failure.hint}\n")
    else:
        details: dict[str, object] = {}
        error: dict[str, object] = {
            "code": failure.code,
            "message": failure.message,
            "retryable": failure.exit_code == ExitCode.TEMPORARY_UNAVAILABLE,
            "hint": failure.hint,
            "details": details,
        }
        document: dict[str, object] = {
            "schema_version": SCHEMA_VERSION,
            "command": command,
            "error": error,
        }
        _ = err.write(json.dumps(document, ensure_ascii=False, separators=(",", ":")) + "\n")
    return int(failure.exit_code)
