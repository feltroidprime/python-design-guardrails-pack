_NO_DEFAULT = object()


@dataclass(frozen=True, slots=True, kw_only=True)
class _QueryRequest:
    command: ControlCommandName
    limit: int
    continuation: str
    output_mode: OutputMode
    debug: bool


class _RawArguments:
    command: str
    limit: int
    continuation: str
    output_format: str
    debug: bool

    def __init__(self) -> None:
        self.command = ""
        self.limit = 0
        self.continuation = ""
        self.output_format = ""
        self.debug = False


class _ParserExitError(Exception):
    def __init__(self, *, status: int, message: str) -> None:
        super().__init__(message)
        self.status: int = status
        self.message: str = message


class _ContractParser(argparse.ArgumentParser):
    _out: TextIO = sys.stdout

    def bind_output(self, out: TextIO) -> None:
        self._out = out

    @override
    def _print_message(
        self,
        message: str | None,
        file: SupportsWrite[str] | None = None,  # ARCH-EXCEPTION: ADR-0002
    ) -> None:
        if message:
            _ = file
            _ = self._out.write(message)

    @override
    def exit(self, status: int = 0, message: str | None = None) -> NoReturn:
        raise _ParserExitError(status=status, message=message or "")

    @override
    def error(self, message: str) -> NoReturn:
        raise _ParserExitError(status=ExitCode.SYNTAX, message=message)


def _parser(*, out: TextIO) -> _ContractParser:
    parser = _ContractParser(
        prog="python -m repoctl",
        description="Repository control plane.",
        allow_abbrev=False,
        suggest_on_error=True,
        color=False,
    )
    parser.bind_output(out)
    commands = parser.add_subparsers(dest="command", required=True)
    for spec in COMMAND_CATALOG:
        if spec.kind != CommandKind.QUERY:
            continue
        command = commands.add_parser(
            spec.name.value,
            help=spec.purpose,
            description=spec.purpose,
            epilog=(
                f"Automation example: {spec.automation_example}\n"
                f"Primary input: {spec.input_policy.primary.value}; "
                f"stdin: {spec.input_policy.stdin.value}."
            ),
            allow_abbrev=False,
            suggest_on_error=True,
            color=False,
        )
        command.bind_output(out)
        for argument in spec.arguments:
            _add_catalog_argument(
                command,
                argument,
                output_modes=spec.output_modes,
                default_output_mode=spec.default_output_mode,
                policy=spec.policy,
            )
    return parser


def _add_catalog_argument(
    parser: _ContractParser,
    argument: ArgumentSpec,
    *,
    output_modes: tuple[OutputMode, ...],
    default_output_mode: OutputMode,
    policy: CommandPolicy,
) -> None:
    match argument:
        case TextOption():
            _add_text_option(parser, argument)
        case PageLimitOption():
            _add_page_limit(parser, argument, policy=policy)
        case OutputOption():
            _add_output_option(
                parser,
                output_modes=output_modes,
                default_output_mode=default_output_mode,
            )
        case FlagOption():
            _add_flag_option(parser, argument)
        case _:
            raise TypeError("Repository-control catalog has an unsupported argument declaration.")


def _add_text_option(parser: _ContractParser, argument: TextOption) -> None:
    _ = parser.add_argument(
        argument.flag,
        dest=argument.destination,
        help=_typed_help(argument.help, "text", default=argument.default),
        default=argument.default,
    )


def _add_page_limit(
    parser: _ContractParser,
    argument: PageLimitOption,
    *,
    policy: CommandPolicy,
) -> None:
    if not isinstance(policy, QueryPolicy):
        raise TypeError("Page limits require a query policy.")
    _ = parser.add_argument(
        argument.flag,
        dest=argument.destination,
        help=_typed_help(
            f"{argument.help}; maximum: {policy.maximum_limit}",
            "integer",
            default=policy.default_limit,
        ),
        type=_bounded_positive_integer(policy.maximum_limit),
        default=policy.default_limit,
    )


def _add_output_option(
    parser: _ContractParser,
    *,
    output_modes: tuple[OutputMode, ...],
    default_output_mode: OutputMode,
) -> None:
    choices = tuple(mode.value for mode in output_modes)
    _ = parser.add_argument(
        "--format",
        dest="output_format",
        choices=choices,
        default="",
        help=_typed_help(
            "output format",
            "choice",
            default=default_output_mode.value,
            choices=choices,
        ),
    )


def _add_flag_option(parser: _ContractParser, argument: FlagOption) -> None:
    _ = parser.add_argument(
        argument.flag,
        dest=argument.destination,
        action="store_true",
        help=_typed_help(argument.help, "boolean", default=False),
    )


def _typed_help(
    text: str,
    value_type: str,
    *,
    required: bool = False,
    default: object = _NO_DEFAULT,
    choices: tuple[str, ...] = (),
) -> str:
    facts = [f"type: {value_type}"]
    if required:
        facts.append("required")
    if default is not _NO_DEFAULT:
        rendered = "empty" if default in {None, ""} else str(default).lower()
        facts.append(f"default: {rendered}")
    if choices:
        facts.append(f"choices: {', '.join(choices)}")
    return f"{text} ({'; '.join(facts)})"


def _bounded_positive_integer(maximum: int) -> Callable[[str], int]:
    def parse(raw: str) -> int:
        try:
            value = int(raw)
        except ValueError as error:
            raise argparse.ArgumentTypeError("must be an integer") from error
        if not 1 <= value <= maximum:
            raise argparse.ArgumentTypeError(f"must be between 1 and {maximum}")
        return value

    return parse


def _parse(argv: Sequence[str], *, parser: _ContractParser) -> _QueryRequest:
    raw = _RawArguments()
    _ = parser.parse_args(list(argv), namespace=raw)
    return _QueryRequest(
        command=ControlCommandName(raw.command),
        limit=raw.limit,
        continuation=raw.continuation,
        output_mode=_output_mode(raw),
        debug=raw.debug,
    )


def _output_mode(raw: _RawArguments) -> OutputMode:
    if raw.output_format:
        return OutputMode(raw.output_format)
    return next(
        spec.default_output_mode for spec in COMMAND_CATALOG if spec.name.value == raw.command
    )


def _product_declarations(snapshot: RepositorySnapshot) -> tuple[CapabilityDeclaration, ...]:
    product_prefix = f"{snapshot.package}.modules."
    return tuple(
        declaration
        for declaration in snapshot.declarations
        if declaration.python_module.startswith(product_prefix)
    )


def _capabilities_selection() -> dict[str, object]:
    return {"scope": "product-capabilities"}


def _capability_document(declaration: CapabilityDeclaration) -> dict[str, object]:
    return {
        "name": declaration.name,
        "python_module": declaration.python_module,
        "status": declaration.status,
        "proof_catalog": declaration.proof_catalog,
        "boundaries": {
            "inbound": list(declaration.inbound),
            "outbound": list(declaration.outbound),
        },
        "activation": {
            "api": declaration.api,
            "factory": declaration.factory,
            "cli_catalog": declaration.cli_catalog,
        },
    }


def _capability_page(
    request: _QueryRequest,
    declarations: tuple[CapabilityDeclaration, ...],
) -> tuple[tuple[CapabilityDeclaration, ...], bool, str]:
    position = (
        decode_continuation(request.continuation, selection=_capabilities_selection())
        if request.continuation
        else ""
    )
    eligible = tuple(declaration for declaration in declarations if declaration.name > position)
    visible = eligible[: request.limit]
    truncated = len(eligible) > request.limit
    continuation = (
        encode_continuation(visible[-1].name, selection=_capabilities_selection())
        if truncated
        else ""
    )
    return visible, truncated, continuation


def _write_capabilities(
    request: _QueryRequest,
    snapshot: RepositorySnapshot,
    *,
    out: TextIO,
) -> None:
    visible, truncated, continuation = _capability_page(
        request,
        _product_declarations(snapshot),
    )
    if request.output_mode == OutputMode.HUMAN:
        for declaration in visible:
            _ = out.write(
                f"{declaration.name}\t{declaration.status}\t{declaration.python_module}\n"
            )
        return
    write_success(
        command=ControlCommandName.CAPABILITIES.value,
        data={"capabilities": [_capability_document(declaration) for declaration in visible]},
        metadata={
            "limit": request.limit,
            "truncated": truncated,
            "continuation": continuation,
        },
        out=out,
    )


def _capability_counts(declarations: tuple[CapabilityDeclaration, ...]) -> dict[str, int]:
    indexes = compile_indexes(declarations)
    return {
        "draft": sum(declaration.status == "draft" for declaration in declarations),
        "active": len(indexes.active),
        "retired": sum(declaration.status == "retired" for declaration in declarations),
    }


def _status_document(snapshot: RepositorySnapshot) -> dict[str, object]:
    declarations = _product_declarations(snapshot)
    return {
        "repository": {
            "schema_version": snapshot.schema_version,
            "package": snapshot.package,
        },
        "capability_counts": _capability_counts(declarations),
    }


def _write_status(request: _QueryRequest, snapshot: RepositorySnapshot, *, out: TextIO) -> None:
    document = _status_document(snapshot)
    if request.output_mode == OutputMode.HUMAN:
        counts = _capability_counts(_product_declarations(snapshot))
        _ = out.write(
            "schema={schema} package={package} draft={draft} active={active} retired={retired}\n".format(
                schema=snapshot.schema_version,
                package=snapshot.package,
                draft=counts["draft"],
                active=counts["active"],
                retired=counts["retired"],
            )
        )
        return
    write_success(
        command=ControlCommandName.STATUS.value,
        data=document,
        metadata={"limit": request.limit, "truncated": False, "continuation": ""},
        out=out,
    )


def _write_execution_failure(
    *,
    command: str,
    output_mode: OutputMode,
    failure: FailureBody,
    err: TextIO,
) -> int:
    if output_mode == OutputMode.HUMAN:
        hint = failure.hint or failure.outcome.hint
        _ = err.write(f"error: {failure.message}\n{hint}\n")
    else:
        write_failure(command=command, failure=failure, err=err)
    return failure.outcome.exit_code


def _syntax_error(argv: Sequence[str], error: _ParserExitError, *, err: TextIO) -> int:
    command = argv[0] if argv and argv[0] in ControlCommandName else "cli"
    help_invocation = (
        f"python -m repoctl {command} --help" if command != "cli" else "python -m repoctl --help"
    )
    write_failure(
        command=command,
        failure=FailureBody(
            outcome=shared_outcome(OutcomeCode.INVALID_SYNTAX),
            message=error.message,
            hint=f"Run '{help_invocation}' and correct the invocation.",
        ),
        err=err,
    )
    return ExitCode.SYNTAX


def _dispatch(request: _QueryRequest, snapshot: RepositorySnapshot, *, out: TextIO) -> int:
    match request.command:
        case ControlCommandName.CAPABILITIES:
            _write_capabilities(request, snapshot, out=out)
        case ControlCommandName.STATUS:
            _write_status(request, snapshot, out=out)
        case _:
            raise ValueError("Mutation commands must use the capability mutation boundary.")
    return ExitCode.SUCCESS


def run(
    argv: Sequence[str],
    *,
    repository: RepositoryPort,
    out: TextIO,
    err: TextIO,
) -> int:
    """Translate argv into one declared repository-control result."""
    mutation_result = run_mutation(argv, repository=repository, out=out, err=err)
    if mutation_result is not None:
        return mutation_result
    try:
        request = _parse(argv, parser=_parser(out=out))
    except _ParserExitError as error:
        if error.status == ExitCode.SUCCESS:
            return ExitCode.SUCCESS
        return _syntax_error(argv, error, err=err)
    try:
        return _dispatch(request, repository.snapshot(), out=out)
    except InvalidContinuationError as error:
        return _write_execution_failure(
            command=request.command.value,
            output_mode=request.output_mode,
            failure=FailureBody(
                outcome=CAPABILITIES_OUTCOMES[0],
                message=str(error),
                details=(ComputedFailureDetail(key="reason", value=error.reason),),
            ),
            err=err,
        )
    except RepositoryPortError as error:
        return _write_execution_failure(
            command=request.command.value,
            output_mode=request.output_mode,
            failure=FailureBody(outcome=DEPENDENCY_UNAVAILABLE, message=str(error)),
            err=err,
        )
    except Exception as error:  # noqa: BLE001  # ARCH-EXCEPTION: ADR-0002
        if request.debug:
            traceback.print_exception(error, file=err)
            return ExitCode.UNEXPECTED_FAILURE
        return _write_execution_failure(
            command=request.command.value,
            output_mode=request.output_mode,
            failure=FailureBody(
                outcome=shared_outcome(OutcomeCode.UNEXPECTED_FAILURE),
                message="The command failed unexpectedly.",
                hint=f"Re-run 'python -m repoctl {request.command.value} --debug' for a traceback.",
            ),
            err=err,
        )
