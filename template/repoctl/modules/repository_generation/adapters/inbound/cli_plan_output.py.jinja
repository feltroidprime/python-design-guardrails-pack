"""Stable output formatting for inspectable capability-plan mutations."""

import json
from typing import TYPE_CHECKING, cast

from repoctl.modules.repository_generation.adapters.inbound.cli_catalog import (
    ControlCommandName,
)
from repoctl.modules.repository_generation.application.commands import ApplyOutcome
from repoctl.modules.repository_generation.domain.plans import (
    CapabilityPlan,
    canonical_plan_bytes,
)

# isort: split
from {{ package }}.adapters.inbound.cli_contract import OutputMode
from {{ package }}.adapters.inbound.cli_protocol import write_success

if TYPE_CHECKING:
    from typing import TextIO


def write_plan_success(
    capability_plan: CapabilityPlan,
    output: str,
    output_mode: OutputMode,
    *,
    out: TextIO,
) -> None:
    """Write the stable success result for an inspectable plan."""
    if output_mode == OutputMode.HUMAN:
        _ = out.write(f"{capability_plan.plan_id}\t{output}\n")
        return
    write_success(
        command=ControlCommandName.CAPABILITY_PLAN.value,
        data={
            "plan": cast("object", json.loads(canonical_plan_bytes(capability_plan))),
            "output": output,
        },
        metadata={"operation_count": len(capability_plan.operations)},
        out=out,
    )


def write_apply_success(
    outcome: ApplyOutcome,
    output_mode: OutputMode,
    *,
    out: TextIO,
) -> None:
    """Write the stable success result for applying an inspected plan."""
    if output_mode == OutputMode.HUMAN:
        _ = out.write(f"{outcome.status}\t{outcome.plan_id}\n")
        return
    write_success(
        command=ControlCommandName.CAPABILITY_APPLY.value,
        data={
            "plan_id": outcome.plan_id,
            "status": outcome.status,
            "written_targets": list(outcome.written_targets),
            "recovery_instruction": outcome.recovery_instruction,
        },
        metadata={},
        out=out,
    )
