"""Composition root for the repository control-plane CLI."""

from pathlib import Path
import sys
from typing import TYPE_CHECKING

from repoctl.modules.repository_generation.api import LocalRepository, run

if TYPE_CHECKING:
    from collections.abc import Sequence


def main(argv: Sequence[str] | None = None) -> int:
    """Run repository-control commands against the current repository."""
    arguments = sys.argv[1:] if argv is None else list(argv)
    return run(
        arguments,
        repository=LocalRepository(root=Path.cwd(), package="{{ package }}"),
        out=sys.stdout,
        err=sys.stderr,
    )
