{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.hypothesis": true,
    "**/.ruff_cache": true,
    "**/.basedpyright": true,
    "**/.import_linter_cache": true,
    "**/.codebase-memory": true,
    "**/.venv": true,
    "**/.DS_Store": true,
    "**/*.egg-info": true,
    ".coverage": true,
    "coverage.xml": true,
    "htmlcov": true,
    "dist": true,
    "build": true,
    ".idea": true
  },
  "search.exclude": {
    "uv.lock": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.hypothesis/**": true,
    "**/.ruff_cache/**": true,
    "**/.basedpyright/**": true,
    "**/.import_linter_cache/**": true,
    "**/.codebase-memory/**": true,
    "**/.venv/**": true
  },
  "terminal.integrated.env.osx": {
    "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.venv/pycache"
  },
  "terminal.integrated.env.linux": {
    "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.venv/pycache"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "basedpyright.importStrategy": "fromEnvironment"
}
