schema_version = 1

[[properties]]
id = "@PROPERTY_ID@"
title = "Probe results are ready"
statement = "The capability probe returns ready for every caller label."
scope = "The pure probe operation over one caller label."
assumptions = []
kind = "invariant"
strength = "normative"
targets = ["@MODULE@.domain.probe:probe"]
oracles = ["@MODULE@.domain.specifications:response_is_ready"]
evidence = ["icontract", "hypothesis", "crosshair", "falsifier"]
crosshair_targets = ["@MODULE@.domain.probe:probe"]
counterexample = "The probe returns any value other than ready."
failure_modes = ["non-ready result"]
