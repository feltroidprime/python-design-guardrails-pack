__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.codebase-memory/
.smithers/
smithers.db*
.venv/
# The generator root is intentionally lock-file-free (stdlib-only, no runtime
# deps); ignore any uv.lock an ad-hoc `uv run` leaves behind.
uv.lock
.DS_Store
dist/
*.egg-info/
# Epic sources under epics/ are tracked; their compiled manifests are derived
# artifacts bound to one run's base SHA and are rebuilt by compile_epic.py.
epics/*.manifest.json
