# Copy is generated by `just langfuse-init`. Secret fields are intentionally
# blank here; do not commit benchmarks/langfuse/.env.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Deterministic first-start identities for this local-only deployment.
LANGFUSE_INIT_ORG_ID=guardrails-lab
LANGFUSE_INIT_ORG_NAME=Guardrails Lab
LANGFUSE_INIT_PROJECT_ID=guardrails-benchmarks
LANGFUSE_INIT_PROJECT_NAME=Guardrails Benchmarks
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=lab@localhost.invalid
LANGFUSE_INIT_USER_NAME=Lab Operator
LANGFUSE_INIT_USER_PASSWORD=
