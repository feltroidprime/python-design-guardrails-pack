"""Capability-owned entry point for the probe command."""

import json
import sys

from @MODULE@.adapters.inbound.cli_catalog import COMMANDS
from @MODULE@.api import probe


def main() -> None:
    """Run the closed capability-local command catalog."""
    arguments = tuple(sys.argv[1:])
    if len(arguments) != 1 or arguments[0] not in COMMANDS:
        raise ValueError(f"expected one of: {', '.join(COMMANDS)}")
    document = {
        "schema_version": "1.0",
        "command": arguments[0],
        "data": {"result": probe("cli")},
    }
    _ = sys.stdout.write(
        json.dumps(
            document,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        )
        + "\n"
    )


if __name__ == "__main__":
    main()
