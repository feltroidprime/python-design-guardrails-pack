schema_version = 1
ownership_zone = "product"

[[properties]]
id = "@PROPERTY_ID@"
title = "Terminal workflow runs are closed"
statement = "Every succeeded or cancelled workflow run is closed."
scope = "Retry, success, cancellation, and restart sequences driven through injected ports."
assumptions = []
kind = "state_machine"
strength = "normative"
targets = [
  "@MODULE@.application.workflow:attempt",
  "@MODULE@.application.workflow:cancel",
]
oracles = ["@MODULE@.domain.specifications:terminal_run_is_closed"]
evidence = ["hypothesis-stateful", "falsifier"]
counterexample = "A succeeded or cancelled run remains open."
failure_modes = ["successful run open", "cancelled run open"]
